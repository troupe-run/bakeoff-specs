+
+
+def test_other_comment_lines_untouched(theatre: Theatre) -> None:
+    files = {"troupe.yml": "# head\na: 1 # c\n  # indented note\nb: 2\n"}
+    assert_set(
+        theatre, files, "a", "3", {"troupe.yml": "# head\na: 3 # c\n  # indented note\nb: 2\n"}
