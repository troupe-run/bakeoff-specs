+++ b/src/troupe/edit/apply.py
@@ -0,0 +1,155 @@
+"""Carrying out a `set`: plan, apply each operation to in-memory texts, verify, then write.
+
+Operations are applied one at a time, re-loading the configuration from the edited texts before each, so
+every primitive works on an accurate tree. Nothing is written until the final texts load and match the
+intended configuration; otherwise the set is refused and no file changes.
+"""
+
+import re
+from dataclasses import dataclass
+from pathlib import Path as FsPath
+
+from troupe.edit import ops as prim
+from troupe.edit.plan import AddKey, Append, Delete, Op, Replace, WriteText, plan
+from troupe.edit.text import apply_edits
+from troupe.errors import LoadError, WriteRefused
+from troupe.leaves import leaves
+from troupe.loader import Config, load
+from troupe.paths import Path, format_path
+from troupe.schema import Data, same
+from troupe.store import Change
+from troupe.tree import Item, MappingNode, Node, ScalarNode, SequenceNode, TextNode, to_data
+
+
+@dataclass
+class SetResult:
+    writes: dict[FsPath, str]  # file path → new text, only for files whose text changed
+    changes: list[Change]
+
+
+def compute_set(theatre: FsPath, config: Config, path: Path, value: Data) -> SetResult:
+    operations = plan(config.root, path, value)
+    original = {key: src.text for key, src in config.files.items()}
+    texts = dict(original)
+    current = config
+    for op in operations:
+        _apply(current, op, texts)
+        current = _reload(theatre, texts, path)
+    if texts == original:
+        return SetResult({}, [])
+    expected = _with_value(to_data(config.root), path, value)
+    if not _matches(current.root, expected):
+        raise WriteRefused(
+            f"{format_path(path)}: the edited files would not read back as intended; not writing"
+        )
+    writes = {current.files[k].path: t for k, t in texts.items() if t != original.get(k)}
+    return SetResult(writes, _changes(to_data(config.root), to_data(current.root)))
+
+
+def _reload(theatre: FsPath, texts: dict[FsPath, str], path: Path) -> Config:
+    try:
+        return load(theatre, overlay=texts)
+    except LoadError as e:
+        raise WriteRefused(f"{format_path(path)}: the result would not load ({e}); not writing") from None
+
+
+def _apply(config: Config, op: Op, texts: dict[FsPath, str]) -> None:
+    where = format_path(op.path)
+    if isinstance(op, WriteText):
+        node = _node_at(config.root, op.path)
+        assert isinstance(node, TextNode)
+        texts[node.target.path.resolve()] = to_crlf(op.text) if "\r\n" in node.target.text else op.text
+        return
+    parent = _node_at(config.root, op.path[:-1])
+    key = op.path[-1]
+    if isinstance(op, AddKey):
+        assert isinstance(parent, MappingNode)
+        src, edits = prim.add_key(parent, key, op.value)
+    elif isinstance(op, Append):
+        assert isinstance(parent, SequenceNode)
+        src, edits = prim.append_item(parent, op.value)
+    elif isinstance(op, Delete):
+        assert isinstance(parent, MappingNode | SequenceNode)
+        index = [e.key for e in parent.entries].index(key) if isinstance(parent, MappingNode) else int(key)
+        src, edits = prim.delete(parent, index, where)
+    else:
+        assert isinstance(op, Replace)
+        src, edits = prim.replace(_slot(parent, key), op.value, where)
+    file_key = src.path.resolve()
+    texts[file_key] = apply_edits(texts[file_key], edits)
+
+
+def to_crlf(text: str) -> str:
+    """Text-include content for a CRLF target: every LF not already preceded by CR becomes CRLF."""
+    return re.sub(r"(?<!\r)\n", "\r\n", text)
+
+
+def _slot(parent: Node, key: str) -> prim.Slot:
+    if isinstance(parent, MappingNode):
+        entry = parent.get(key)
+        assert entry is not None
+        return prim.Slot(node=entry.value, parent=parent, entry=entry)
+    assert isinstance(parent, SequenceNode)
+    item: Item = parent.items[int(key)]
+    return prim.Slot(node=item.value, parent=parent, item=item)
+
+
+def _node_at(root: Node, path: Path) -> Node:
+    node = root
+    for segment in path:
+        if isinstance(node, MappingNode):
+            entry = node.get(segment)
+            assert entry is not None, segment
+            node = entry.value
+        else:
+            assert isinstance(node, SequenceNode), segment
+            node = node.items[int(segment)].value
+    return node
+
+
+def _with_value(data: Data, path: Path, value: Data) -> Data:
+    if not path:
+        return value
+    head, rest = path[0], path[1:]
+    if isinstance(data, dict):
+        out = dict(data)
+        out[head] = _with_value(data.get(head, {}), rest, value)
+        return out
+    assert isinstance(data, list)
+    items = list(data)
+    index = int(head)
+    if index == len(items):
+        items.append(_with_value(None, rest, value))
+    else:
+        items[index] = _with_value(items[index], rest, value)
+    return items
+
+
+def _matches(node: Node, expected: Data) -> bool:
+    """Whether the re-loaded tree spells `expected`; an include string in `expected` matches its include."""
+    if node.include is not None and isinstance(expected, str) and expected == node.include.string.value:
+        return True
+    if isinstance(node, MappingNode):
+        return (
+            isinstance(expected, dict)
+            and len(node.entries) == len(expected)
+            and all(e.key in expected for e in node.entries)
+            and all(_matches(e.value, expected[e.key]) for e in node.entries)
+        )
+    if isinstance(node, SequenceNode):
+        return (
+            isinstance(expected, list)
+            and len(node.items) == len(expected)
+            and all(_matches(i.value, x) for i, x in zip(node.items, expected, strict=True))
+        )
+    if isinstance(node, TextNode) and isinstance(expected, str) and "\r\n" in node.value:
+        return node.value == to_crlf(expected)
+    assert isinstance(node, ScalarNode | TextNode)
+    return same(node.value, expected)
+
+
+def _changes(before: Data, after: Data) -> list[Change]:
+    old, new = leaves(before), leaves(after)
+    removed = [Change("remove", p, v, None) for p, v in old.items() if p not in new]
+    changed = [Change("set", p, old.get(p), v) for p, v in new.items() if p not in old or not same(old[p], v)]
+    return removed + changed
diff --git a/src/troupe/edit/blocks.py b/src/troupe/edit/blocks.py
new file mode 100644
index 0000000..1a2c1fa
--- /dev/null
+++ b/src/troupe/edit/blocks.py
@@ -0,0 +1,146 @@
+"""Rendering new values for a block context: block collections and literal block scalars."""
+
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from troupe.edit.scalars import is_printable, render_key, render_scalar
+from troupe.edit.text import Layout
+from troupe.errors import LoadError
+from troupe.schema import Data
+from troupe.source import SourceFile
+from troupe.tree import MappingNode, build_tree
+
+
+@dataclass
+class Rendered:
+    """A value as written after its `key:` or `-`: text on that line, then whole lines below it."""
+
+    inline: str
+    lines: list[str] = field(default_factory=list)
+
+
+def is_multiline(value: Data) -> bool:
+    return isinstance(value, str) and "\n" in value
+
+
+def flow_text(value: Data, preferred: str | None = None, *, flow: bool) -> str:
+    """A value in flow style; scalars in the preferred quoting style when it can hold them."""
+    if isinstance(value, dict):
+        inner = ", ".join(
+            f"{render_key(k, None, flow=True)}: {flow_text(v, flow=True)}" for k, v in value.items()
+        )
+        return "{" + inner + "}"
+    if isinstance(value, list):
+        return "[" + ", ".join(flow_text(v, flow=True) for v in value) + "]"
+    return render_scalar(value, preferred, flow=flow)
+
+
+def required_chomp(trailing_newlines: int, current: str | None) -> str:
+    """The chomping indicator: the current one if it can represent the value's trailing newlines."""
+    fits = {"-": trailing_newlines == 0, "": trailing_newlines == 1, "+": trailing_newlines >= 1}
+    if current is not None and fits[current]:
+        return current
+    if trailing_newlines == 0:
+        return "-"
+    return "" if trailing_newlines == 1 else "+"
+
+
+def literal_body(value: str, chomp: str, content_indent: int) -> list[str]:
+    """The lines of a literal block holding `value` (whose trailing newlines `chomp` accounts for)."""
+    core = value.rstrip("\n")
+    trailing = len(value) - len(core)
+    lines = core.split("\n") if core else []
+    body = [(" " * content_indent + line) if line else "" for line in lines]
+    if chomp == "+":
+        body.extend([""] * (trailing - 1))
+    return body
+
+
+def needs_indent_digit(value: str) -> bool:
+    first = next((line for line in value.split("\n") if line != ""), "")
+    return first.startswith(" ")
+
+
+def block_ok(value: str, header: str, body: list[str], owner_col: int) -> bool:
+    """Whether a block scalar with this header and body reads back as `value`."""
+    if any(ch == "\r" or not is_printable(ch) for ch in value):
+        return False
+    pad = " " * max(owner_col, 0)
+    doc = f"{pad}k: {header}\n" + "".join(line + "\n" for line in body)
+    try:
+        root = build_tree(SourceFile(Path("<check>"), doc))
+    except LoadError:
+        return False
+    if not isinstance(root, MappingNode) or len(root.entries) != 1:
+        return False
+    node = root.entries[0].value
+    return getattr(node, "value", None) == value
+
+
+def literal(value: str, owner_col: int, layout: Layout) -> Rendered | None:
+    """A new literal block for a multi-line string, or None if a literal block cannot hold it."""
+    content_indent = max(owner_col, 0) + layout.unit
+    chomp = required_chomp(len(value) - len(value.rstrip("\n")), None)
+    digit = str(content_indent - max(owner_col, 0)) if needs_indent_digit(value) else ""
+    header = "|" + digit + chomp
+    body = literal_body(value, chomp, content_indent)
+    if not block_ok(value, header, body, owner_col):
+        return None
+    return Rendered(header, body)
+
+
+def render_value(
+    value: Data, *, owner_col: int, owner_is_key: bool, layout: Layout, preferred: str | None = None
+) -> Rendered:
+    """A value in a block context, owned by a key or `-` at column `owner_col`."""
+    if isinstance(value, dict) and value:
+        return Rendered("", mapping_lines(value, owner_col + layout.unit, layout))
+    if isinstance(value, list) and value:
+        offset = layout.seq_offset if owner_is_key else layout.unit
+        return Rendered("", sequence_lines(value, owner_col + offset, layout))
+    if isinstance(value, str) and is_multiline(value):
+        block = literal(value, owner_col, layout)
+        if block is not None:
+            return block
+    return Rendered(flow_text(value, preferred, flow=False))
+
+
+def entry_lines(
+    key: str,
+    value: Data,
+    col: int,
+    layout: Layout,
+    *,
+    key_style: str | None = None,
+    value_style: str | None = None,
+) -> list[str]:
+    r = render_value(value, owner_col=col, owner_is_key=True, layout=layout, preferred=value_style)
+    head = " " * col + render_key(key, key_style, flow=False) + ":" + (" " + r.inline if r.inline else "")
+    return [head, *r.lines]
+
+
+def mapping_lines(value: dict[str, Data], col: int, layout: Layout) -> list[str]:
+    lines: list[str] = []
+    for key, child in value.items():
+        lines.extend(entry_lines(key, child, col, layout))
+    return lines
+
+
+def sequence_lines(value: list[Data], col: int, layout: Layout) -> list[str]:
+    lines: list[str] = []
+    for child in value:
+        lines.extend(item_lines(child, col, layout))
+    return lines
+
+
+def item_lines(value: Data, col: int, layout: Layout, *, value_style: str | None = None) -> list[str]:
+    """A block sequence item at column `col`; mappings and lists use the compact `- key: v` form."""
+    if isinstance(value, dict | list) and value:
+        inner = (
+            mapping_lines(value, col + 2, layout)
+            if isinstance(value, dict)
+            else sequence_lines(value, col + 2, layout)
+        )
+        return [" " * col + "- " + inner[0][col + 2 :], *inner[1:]]
+    r = render_value(value, owner_col=col, owner_is_key=False, layout=layout, preferred=value_style)
+    return [" " * col + "-" + (" " + r.inline if r.inline else ""), *r.lines]
diff --git a/src/troupe/edit/folded.py b/src/troupe/edit/folded.py
new file mode 100644
index 0000000..ee91320
--- /dev/null
+++ b/src/troupe/edit/folded.py
@@ -0,0 +1,99 @@
+"""Rewriting a folded (`>`) block scalar: unchanged paragraphs keep their bytes, changed ones re-wrap.
+
+A folded value's lines (split on newline) are its paragraphs. Old and new paragraphs are aligned with
+difflib; paragraphs in a replaced run are paired by position and each re-wraps at the width of its old
+counterpart's longest line. Paragraphs with no counterpart wrap at the old value's longest line.
+"""
+
+import re
+from dataclasses import dataclass
+from difflib import SequenceMatcher
+
+from troupe.blockscalar import BlockLayout
+
+DEFAULT_WIDTH = 80
+_BREAK = re.compile(r"(?<=[^ ]) (?=[^ ])")
+
+
+class MoreIndented(Exception):
+    """The new value would need a more-indented line, which a rewrite of a folded scalar refuses."""
+
+
+@dataclass
+class Paragraph:
+    text: str
+    source: list[str] | None  # the old body lines (indentation removed) spelling it, if it came from the file
+
+
+def paragraphs(body: list[str]) -> list[Paragraph]:
+    """The folded value's lines, each with the source lines that spell it."""
+    out: list[Paragraph] = []
+    group: list[str] = []
+    empties = 0
+    started = False
+    for line in [*body, None]:
+        if line is not None and line != "":
+            group.append(line)
+            continue
+        if group:
+            if started:
+                out.extend(Paragraph("", None) for _ in range(max(empties - 1, 0)))
+            else:
+                out.extend(Paragraph("", None) for _ in range(empties))
+            out.append(Paragraph(" ".join(group), group))
+            started = True
+            group = []
+            empties = 0
+        if line == "":
+            empties += 1
+    return out
+
+
+def wrap(text: str, width: int) -> list[str]:
+    """Greedy word wrap; words split at single spaces between non-space characters."""
+    lines: list[str] = []
+    current: str | None = None
+    for word in _BREAK.split(text):
+        if current is None:
+            current = word
+        elif len(current) + 1 + len(word) <= width:
+            current += " " + word
+        else:
+            lines.append(current)
+            current = word
+    lines.append(current or "")
+    return lines
+
+
+def refold(layout: BlockLayout, new_core: str) -> list[str]:
+    """Body lines (indentation removed) for the folded value `new_core` (trailing newlines excluded)."""
+    new_texts = new_core.split("\n") if new_core else []
+    if any(t[:1] in (" ", "\t") for t in new_texts):
+        raise MoreIndented
+    old = paragraphs(layout.body)
+    widths = [len(line) for p in old if p.source for line in p.source]
+    overall = max(widths, default=DEFAULT_WIDTH)
+
+    def width_of(p: Paragraph | None) -> int:
+        if p is None or not p.source:
+            return overall
+        return max(len(line) for line in p.source)
+
+    result: list[Paragraph] = []
+    matcher = SequenceMatcher(None, [p.text for p in old], new_texts, autojunk=False)
+    for op, i1, i2, j1, j2 in matcher.get_opcodes():
+        if op == "equal":
+            result.extend(old[i1:i2])
+            continue
+        for k, text in enumerate(new_texts[j1:j2]):
+            counterpart = old[i1 + k] if op == "replace" and i1 + k < i2 else None
+            result.append(Paragraph(text, wrap(text, width_of(counterpart)) if text else None))
+
+    lines: list[str] = []
+    for index, p in enumerate(result):
+        if index > 0:
+            lines.append("")
+        if p.text:
+            assert p.source is not None
+            lines.extend(p.source)
+    return lines
