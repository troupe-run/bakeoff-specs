+
+
+def test_other_tags_are_still_not_rewritten(refused: Callable[..., Result]) -> None:
+    assert refused("a: !!str 5\n", "a", "6").code == 3
+
+
+def test_expanding_an_alias_keeps_a_literal_in_the_copy(make: Callable[[str], Theatre]) -> None:
