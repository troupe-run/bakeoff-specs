+    written = mapping.merge.written
+    assert [(entry.key, entry.key_style) for entry in written.entries] == [
+        ("own", ScalarStyle.PLAIN),
+        ("<<", ScalarStyle.PLAIN),
+        ("last", ScalarStyle.PLAIN),
