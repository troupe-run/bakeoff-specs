+    _check(
+        make_theatre,
+        text,
+        ("--expand-alias", "l.0.m", "5"),
+        f"d: &d\n  m: 1\n  n: 2\nl:\n  -{COMMENT.format(name='d')}\n    m: 5\n    n: 2\n  - *d\n",
+        [("set", "l.0.m", 1, 5)],
+    )
