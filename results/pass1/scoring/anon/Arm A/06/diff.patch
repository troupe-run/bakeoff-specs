+        make_theatre,
+        text,
+        ("a.x.m", "2", "--expand-alias"),
+        "e: &e\n  m: 1\nd: &d\n  x: *e\n"
+        f"a:{COMMENT.format(name='d')}\n  x:{COMMENT.format(name='e')}\n    m: 2\n",
+        [("set", "a.x.m", 1, 2)],
