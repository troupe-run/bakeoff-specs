+def test_key_from_a_chained_bare_include_goes_into_the_middle_ref_mapping(tmp_path: Path) -> None:
+    """Req 4.2, 4.4 (choice 5): `c` overrides a.yaml, whose root is the bare `$ref: file:b.yaml`;
