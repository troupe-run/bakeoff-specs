+# --- nested includes ---------------------------------------------------------------------------
+
+
+def test_nested_scalar_includes_convert_the_innermost_in_its_directive_file(
+    tmp_path: Path,
+) -> None:
+    """Req 4.2: below nested includes the innermost include is converted, in the included file
+    that holds its reference."""
