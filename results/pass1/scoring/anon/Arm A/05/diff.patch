+        b"temperature: 0.7" + CODER_LABEL + b"\n"
+        b"params:\n"
+        b"  top_k: 5" + CODER_LABEL + b"\n"
+        b"  top_p: 0.5" + CODER_LABEL + b"\n"
+        b"tools:\n"
+        b"  - grep" + CODER_LABEL + b"\n",
+    )
+
