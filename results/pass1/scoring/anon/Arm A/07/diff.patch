new file mode 100644
index 0000000..7b2123b
--- /dev/null
+++ b/src/troupe/config/fetch.py
@@ -0,0 +1,60 @@
+"""Fetching remote sources: the only network code in troupe (config-remote-schema).
+
+:func:`fetch_remote` sends one plain GET with urllib's default headers, follows redirects and
+returns the body bytes. Every failure is a :class:`FetchError` with a short reason. It sends no
+credentials and writes nothing to disk (Requirement 10.4). Decoding the bytes and turning a failure
+into a load error are the loader's job.
+"""
+
+import socket
+from http.client import HTTPException
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+from troupe.config.constants import REMOTE_FETCH_TIMEOUT_SECONDS
+
+
+class FetchError(Exception):
+    """A remote source could not be fetched; ``reason`` says why in a few words."""
+
+    def __init__(self, reason: str) -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+def fetch_remote(url: str, *, timeout: float = REMOTE_FETCH_TIMEOUT_SECONDS) -> bytes:
+    """GET ``url`` once, following redirects, and return the final 2xx answer's body bytes.
+
+    Raises :class:`FetchError` when the server cannot be reached, does not answer within
+    ``timeout`` seconds, or answers with a final status outside 200-299.
+    """
+    try:
+        with urlopen(Request(url, method="GET"), timeout=timeout) as response:
+            status = int(response.status)
+            if not 200 <= status <= 299:
+                raise FetchError(f"HTTP {status} {response.reason}")
+            body: bytes = response.read()
+            return body
+    except HTTPError as error:
+        raise FetchError(f"HTTP {error.code} {error.reason}") from error
+    except URLError as error:
+        raise FetchError(_os_reason(error.reason)) from error
+    except (TimeoutError, OSError) as error:
+        raise FetchError(_os_reason(error)) from error
+    except HTTPException as error:
+        raise FetchError(f"bad HTTP answer ({type(error).__name__})") from error
+    except ValueError as error:
+        raise FetchError(f"invalid URL ({error})") from error
+
+
+def _os_reason(reason: object) -> str:
+    """A short reason for a low-level failure (``URLError.reason`` or an ``OSError``)."""
+    if isinstance(reason, TimeoutError):
+        return "timed out"
+    if isinstance(reason, ConnectionRefusedError):
+        return "connection refused"
+    if isinstance(reason, socket.gaierror):
+        return "unknown host"
+    if isinstance(reason, OSError) and reason.strerror:
+        return reason.strerror.lower()
+    return str(reason)
diff --git a/src/troupe/config/includes.py b/src/troupe/config/includes.py
new file mode 100644
index 0000000..59617af
--- /dev/null
+++ b/src/troupe/config/includes.py
@@ -0,0 +1,38 @@
+"""Include recognition: the one place that says whether a string would be an include.
+
+A string value starting with :data:`~troupe.config.constants.INCLUDE_PREFIX` or one of
+:data:`~troupe.config.constants.REMOTE_INCLUDE_PREFIXES` (case-sensitive) is an include string.
+Whether such a string actually is an include is the loader's decision (a ``!literal`` tag or a
+schema ``format: uri`` makes it a plain string); these functions only say it would be one if
+written plain.
+"""
+
+from pathlib import PurePosixPath
+from urllib.parse import urlsplit
+
+from troupe.config.constants import INCLUDE_PREFIX, REMOTE_INCLUDE_PREFIXES, YAML_INCLUDE_SUFFIXES
+from troupe.config.scalars import ScalarValue
+
+_INCLUDE_PREFIXES = (INCLUDE_PREFIX, *REMOTE_INCLUDE_PREFIXES)
+
+
+def is_include_string(value: ScalarValue) -> bool:
+    """Whether ``value`` is a string starting with ``file:``, ``https://`` or ``http://``."""
+    return isinstance(value, str) and value.startswith(_INCLUDE_PREFIXES)
+
+
+def is_remote_include(text: str) -> bool:
+    """Whether the include string ``text`` is remote: it starts with ``https://`` or ``http://``."""
+    return text.startswith(REMOTE_INCLUDE_PREFIXES)
+
+
+def include_is_yaml(text: str) -> bool:
+    """Whether the include string ``text`` targets YAML content rather than text.
+
+    A remote include is YAML when its URL path, without query and fragment, ends in a YAML suffix.
+    A ``file:`` include is YAML when its target's name does, as before step 7. Suffixes are
+    case-sensitive.
+    """
+    if is_remote_include(text):
+        return urlsplit(text).path.endswith(YAML_INCLUDE_SUFFIXES)
+    return PurePosixPath(text.removeprefix(INCLUDE_PREFIX)).name.endswith(YAML_INCLUDE_SUFFIXES)
