+@pytest.mark.parametrize("config_name", CONFIG_NAMES)
+def test_get_and_show_follow_remote_in_remote_in_both_forms(
+    make_theatre: MakeTheatre, run_cli: RunCli, remote_server: RemoteServer, config_name: str
