+    nan = typed["i"]
+    assert isinstance(nan, float)
+    assert math.isnan(nan)
+    assert typed["j"] == "1"
+    assert typed["k"] == "true"
+    assert typed["l"] == "1\n"
+    assert typed["m"] == 1
