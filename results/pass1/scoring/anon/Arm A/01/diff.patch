+++ b/src/troupe/config/locate.py
@@ -0,0 +1,33 @@
+"""Locate the root configuration file of a theatre (Requirements 2.1-2.4).
+
+Only checks existence: nothing is created, opened or modified here.
+"""
+
+from pathlib import Path
+
+from troupe.config.constants import CONFIG_DIR_NAME, CONFIG_FILE_NAMES
+from troupe.config.errors import ConfigLoadError
+
+
+def find_config_file(theatre_dir: Path) -> Path:
+    """Return ``<theatre_dir>/.troupe/<name>`` for the single existing regular config file.
+
+    Raises :class:`ConfigLoadError` naming the expected ``troupe.yml`` when no config file exists
+    (also when ``theatre_dir`` is missing or not a directory), and naming both files when both
+    ``troupe.yml`` and ``troupe.yaml`` exist.
+    """
+    config_dir = theatre_dir / CONFIG_DIR_NAME
+    candidates = [config_dir / name for name in CONFIG_FILE_NAMES]
+    existing = [candidate for candidate in candidates if candidate.is_file()]
+    if not existing:
+        expected = " or ".join(CONFIG_FILE_NAMES)
+        raise ConfigLoadError(
+            f"no configuration file (expected {expected})",
+            file=candidates[0],
+        )
+    if len(existing) > 1:
+        raise ConfigLoadError(
+            f"both {existing[0].name} and {existing[1]} exist",
+            file=existing[0],
+        )
+    return existing[0]
diff --git a/src/troupe/config/model.py b/src/troupe/config/model.py
new file mode 100644
index 0000000..44e7889
--- /dev/null
+++ b/src/troupe/config/model.py
@@ -0,0 +1,182 @@
+"""Source-mapped configuration model (Requirements 4.2, 4.3, 6.6).
+
+An immutable tree of configuration nodes with exact source provenance. This module is pure data:
+it performs no I/O. All dataclasses are frozen and all collections are tuples. Node values are the
+true YAML values (plain built-ins only; folded ``>`` scalars are folded with no U+0007 markers),
+while ``SourceFile.text`` and every span are left exactly as the file was read.
+
+Span semantics
+--------------
+* ``Span.start`` (inclusive) and ``Span.end`` (exclusive) are **character (code point) indices**
+  into ``SourceFile.text``, the exact decoded file text (UTF-8, no newline translation, BOM kept).
+  A byte offset, when needed, is ``len(text[:i].encode("utf-8"))``.
+* Plain and quoted scalar spans are exact; quoted spans cover the quotes.
+* A block scalar's span starts at its indicator (``|`` or ``>``, with any chomping/indentation
+  indicators) and covers the header line and all content lines including the final line break, but
+  it may also extend over trailing blank lines (for ``'|\\n  a\\n  b\\n\\n\\n'`` the value is
+  ``'a\\nb\\n'`` and the span covers all the trailing blank lines). A block scalar's ``end`` is
+  therefore not tight.
+* The span of an empty (zero-length) null value (e.g. ``key:`` with nothing after it) is not a
+  reliable position; consumers must not patch at it.
+* Mapping and sequence spans are as reported by the composer. Flow collection spans are exact
+  (``[`` ... ``]``, ``{`` ... ``}``). Block collection spans start at the first entry and may extend
+  over trailing blank lines and comments, so consumers must not treat a block collection's ``end``
+  as tight.
+* An empty or comment-only root file yields an empty root mapping with
+  ``style=CollectionStyle.BLOCK`` and ``origin=Origin(root_file, Span(0, 0))``.
+
+Include provenance
+------------------
+A node produced by an include carries ``include: IncludeRef``; its own ``origin`` lies in the target
+file, and the ``file:`` string it replaced is ``include.directive`` (in the including file). Nodes
+nested inside an included YAML file that are not themselves include roots have ``include=None`` and
+an ``origin`` in the target file. A text include is a ``ConfigScalar`` whose ``value`` is the
+target's exact text, with ``style=None``, ``origin=Origin(target, Span(0, len(target.text)))`` and
+``include.kind == IncludeKind.TEXT``.
+
+Invariants: keys within one mapping are unique; no node has an explicit tag or anchor; values are
+built-ins only.
+"""
+
+from dataclasses import dataclass
+from enum import Enum
+from pathlib import Path
+from typing import TypeAlias
+
+from troupe.config.scalars import ScalarValue
+
+
+class LineEnding(Enum):
+    """A file's newline convention, so writers can keep CRLF."""
+
+    NONE = "none"  # no line break in the file
+    LF = "lf"
+    CRLF = "crlf"
+    MIXED = "mixed"
+
+
+@dataclass(frozen=True)
+class SourceFile:
+    """One file that was read while loading the configuration."""
+
+    path: Path  # path as opened (display form, used in messages; writers target ``real_path``)
+    real_path: Path  # Path.resolve() of path; identity for cycles and overrides
+    text: str  # exact decoded content
+    line_ending: LineEnding
+
+
+@dataclass(frozen=True)
+class Span:
+    """A character range in ``SourceFile.text`` (see the module docstring for semantics)."""
+
+    start: int  # character index, inclusive
+    end: int  # character index, exclusive
+
+
+@dataclass(frozen=True)
+class Origin:
+    """Where a node or key was written: a file and a span within it."""
+
+    file: SourceFile
+    span: Span
+
+
+class IncludeKind(Enum):
+    """The kind of include that produced a node."""
+
+    NONE = "none"  # never stored on IncludeRef; used by callers as "not included"
+    YAML = "yaml-include"
+    TEXT = "text-include"
+
+
+@dataclass(frozen=True)
+class IncludeRef:
+    """Provenance of a node that replaced a ``file:`` include directive."""
+
+    kind: IncludeKind  # YAML or TEXT
+    spec: str  # text after "file:" exactly as written
+    target: SourceFile  # the included file
+    directive: Origin  # span of the "file:..." scalar in the including file
+
+
+class ScalarStyle(Enum):
+    """The style a scalar (value or key) was written in."""
+
+    PLAIN = "plain"
+    SINGLE_QUOTED = "single"
+    DOUBLE_QUOTED = "double"
+    LITERAL = "literal"  # |
+    FOLDED = "folded"  # >
+
+
+class CollectionStyle(Enum):
+    """The style a mapping or sequence was written in."""
+
+    BLOCK = "block"
+    FLOW = "flow"
+
+
+@dataclass(frozen=True)
+class ConfigScalar:
+    """A scalar value."""
+
+    value: ScalarValue
+    style: ScalarStyle | None  # None only for text includes
+    origin: Origin
+    include: IncludeRef | None = None
+
+
+@dataclass(frozen=True)
+class MappingEntry:
+    """One key/value pair of a mapping."""
+
+    key: str  # key scalar text as written (unquoted content)
+    key_origin: Origin  # span of the key scalar (incl. quotes)
+    key_style: ScalarStyle  # derived from the key node's style
+    value: "ConfigNode"
+
+
+@dataclass(frozen=True)
+class ConfigMapping:
+    """A mapping; ``entries`` are in document order."""
+
+    entries: tuple[MappingEntry, ...]
+    style: CollectionStyle
+    origin: Origin
+    include: IncludeRef | None = None
+
+    def get(self, key: str) -> MappingEntry | None:
+        """Return the entry whose key equals ``key``, or ``None`` when there is none."""
+        for entry in self.entries:
+            if entry.key == key:
+                return entry
+        return None
+
+
+@dataclass(frozen=True)
+class ConfigSequence:
+    """A sequence (list)."""
+
+    items: tuple["ConfigNode", ...]
+    style: CollectionStyle
+    origin: Origin
+    include: IncludeRef | None = None
+
+
+# A runtime union (not a ``type`` statement) so callers can also use it with ``isinstance``.
+ConfigNode: TypeAlias = ConfigScalar | ConfigMapping | ConfigSequence  # noqa: UP040
+
+
+@dataclass(frozen=True)
+class ConfigDocument:
+    """A fully expanded configuration: the root file, its root mapping and every file read."""
+
+    root_file: SourceFile
+    root: ConfigMapping  # empty root file: empty BLOCK mapping at Origin(root_file, Span(0, 0))
+    files: tuple[SourceFile, ...]  # every file read (root, YAML and text include targets), in order
+
+    def include_kind(self, node: ConfigNode) -> IncludeKind:
+        """Return the kind of include that produced ``node``; ``NONE`` if it is not an include."""
+        if node.include is None:
+            return IncludeKind.NONE
+        return node.include.kind
diff --git a/src/troupe/config/paths.py b/src/troupe/config/paths.py
new file mode 100644
index 0000000..c415514
--- /dev/null
+++ b/src/troupe/config/paths.py
@@ -0,0 +1,58 @@
+"""Dotted configuration PATH syntax (Requirements 1.5, 5.1, 5.3, 8.3).
+
+A PATH is a sequence of segments separated by :data:`PATH_SEPARATOR`, applied from the top-level
+mapping downward. A segment of ASCII digits only addresses a list item by 0-based index when it is
+applied to a list. An empty PATH or an empty segment (``a..b``, ``.a``, ``a.``) is a usage error.
+"""
+
+from dataclasses import dataclass
+from typing import Final
+
+from troupe.config.constants import PATH_SEPARATOR
+from troupe.config.errors import UsageError
+
+_DIGITS: Final = frozenset("0123456789")
+
+
+@dataclass(frozen=True)
+class ConfigPath:
+    """An immutable dotted path; ``segments`` holds the raw segment texts."""
+
+    segments: tuple[str, ...]
+
+    @classmethod
+    def parse(cls, text: str) -> "ConfigPath":
+        """Split ``text`` into segments, raising :class:`UsageError` naming it when malformed."""
+        if text == "":
+            # path=None so the message does not start with an empty path field; the problem
+            # names the empty PATH explicitly instead.
+            raise UsageError("malformed PATH '': PATH is empty")
+        segments = tuple(text.split(PATH_SEPARATOR))
+        if any(segment == "" for segment in segments):
+            raise UsageError(
+                f"malformed PATH {text!r}: segments must not be empty "
+                f"(no leading, trailing or doubled {PATH_SEPARATOR!r})",
+                path=text,
+            )
+        return cls(segments)
+
+    def child(self, segment: str | int) -> "ConfigPath":
+        """Return this path extended by a mapping key or a list index."""
+        return ConfigPath((*self.segments, str(segment)))
+
+    def __str__(self) -> str:
+        return PATH_SEPARATOR.join(self.segments)
+
+
+ROOT: Final[ConfigPath] = ConfigPath(())
+"""The empty path addressing the root mapping; used only internally."""
+
+
+def is_index_segment(segment: str) -> bool:
+    """Return whether ``segment`` consists only of ASCII digits (a list index)."""
+    return segment != "" and all(char in _DIGITS for char in segment)
+
+
+def path_has_prefix(path: str, prefix: str) -> bool:
+    """Return whether ``path`` equals ``prefix`` or lies below it (textual, for ``history``)."""
+    return path == prefix or path.startswith(prefix + PATH_SEPARATOR)
diff --git a/src/troupe/config/resolve.py b/src/troupe/config/resolve.py
new file mode 100644
index 0000000..ab570d8
--- /dev/null
+++ b/src/troupe/config/resolve.py
@@ -0,0 +1,128 @@
+"""Walk and resolve dotted PATHs; flatten the configuration into leaves (5.1-5.5, 6.8, 7.2).
+
+Includes are transparent: included nodes are embedded in the tree, so a path passes through an
+included YAML file exactly as if its content were written in place (5.4). A text include is a
+scalar; no segment can be applied to it (5.5).
+"""
+
+from dataclasses import dataclass
+from enum import Enum
+
+from troupe.config.errors import PathNotFoundError
+from troupe.config.model import (
+    ConfigDocument,
+    ConfigMapping,
+    ConfigNode,
+    ConfigScalar,
+    ConfigSequence,
+)
+from troupe.config.paths import ROOT, ConfigPath, is_index_segment
+from troupe.config.scalars import ScalarValue
+
+
+class WalkStop(Enum):
+    """Why a path walk stopped."""
+
+    COMPLETE = "complete"  # every segment consumed
+    MISSING_KEY = "missing-key"  # mapping has no such key
+    INDEX_OUT_OF_RANGE = "index-out-of-range"
+    NOT_AN_INDEX = "not-an-index"  # non-digit segment applied to a list
+    SCALAR = "scalar"  # segment applied to a scalar (incl. text include)
+
+
+@dataclass(frozen=True)
+class PathWalk:
+    """The outcome of walking a path from the root."""
+
+    path: ConfigPath
+    nodes: tuple[ConfigNode, ...]  # root first, then one node per consumed segment
+    consumed: int  # number of segments resolved
+    stop: WalkStop
+
+    @property
+    def deepest(self) -> ConfigNode:
+        """The deepest node reached (the root when no segment was resolved)."""
+        return self.nodes[-1]
+
+
+@dataclass(frozen=True)
+class Leaf:
+    """One scalar of the configuration at its full dotted path."""
+
+    path: ConfigPath
+    value: ScalarValue
+    node: ConfigScalar
+
+
+def walk_path(root: ConfigMapping, path: ConfigPath) -> PathWalk:
+    """Apply ``path`` segment by segment from ``root`` and report how far it got and why."""
+    nodes: list[ConfigNode] = [root]
+    for segment in path.segments:
+        node = nodes[-1]
+        stop = _step(node, segment)
+        if isinstance(stop, WalkStop):
+            return PathWalk(path=path, nodes=tuple(nodes), consumed=len(nodes) - 1, stop=stop)
+        nodes.append(stop)
+    return PathWalk(path=path, nodes=tuple(nodes), consumed=len(nodes) - 1, stop=WalkStop.COMPLETE)
+
+
+def _step(node: ConfigNode, segment: str) -> ConfigNode | WalkStop:
+    """Return the child of ``node`` selected by ``segment``, or why there is none."""
+    if isinstance(node, ConfigMapping):
+        # A digit-only segment is looked up as a key (digit-only keys are out of contract).
+        entry = node.get(segment)
+        return WalkStop.MISSING_KEY if entry is None else entry.value
+    if isinstance(node, ConfigSequence):
+        if not is_index_segment(segment):
+            return WalkStop.NOT_AN_INDEX
+        index = int(segment)
+        if index >= len(node.items):
+            return WalkStop.INDEX_OUT_OF_RANGE
+        return node.items[index]
+    return WalkStop.SCALAR
+
+
+_PROBLEMS = {
+    WalkStop.MISSING_KEY: "not found: no such key",
+    WalkStop.INDEX_OUT_OF_RANGE: "not found: list index out of range",
+    WalkStop.NOT_AN_INDEX: "not found: a list can only be indexed by a number",
+    WalkStop.SCALAR: "not found: a scalar value has no children",
+}
+
+
+def resolve_path(document: ConfigDocument, path: ConfigPath) -> ConfigNode:
+    """Return the node at ``path``, or raise :class:`PathNotFoundError`.
+
+    The error names ``path`` and the file holding the deepest part of ``path`` that exists (6.8).
+    """
+    walk = walk_path(document.root, path)
+    if walk.stop is not WalkStop.COMPLETE:
+        segment = path.segments[walk.consumed]
+        raise PathNotFoundError(
+            f"{_PROBLEMS[walk.stop]} (at segment {segment!r})",
+            file=walk.deepest.origin.file.path,
+            path=str(path),
+        )
+    return walk.deepest
+
+
+def flatten_leaves(root: ConfigMapping) -> tuple[Leaf, ...]:
+    """Return every scalar of the configuration, depth-first in document order (7.2).
+
+    Text includes and nulls are leaves; list items are addressed by index; empty mappings and
+    empty lists contribute nothing.
+    """
+    leaves: list[Leaf] = []
+    _collect(root, ROOT, leaves)
+    return tuple(leaves)
+
+
+def _collect(node: ConfigNode, path: ConfigPath, leaves: list[Leaf]) -> None:
+    if isinstance(node, ConfigScalar):
+        leaves.append(Leaf(path=path, value=node.value, node=node))
+    elif isinstance(node, ConfigMapping):
+        for entry in node.entries:
+            _collect(entry.value, path.child(entry.key), leaves)
+    else:
+        for index, item in enumerate(node.items):
+            _collect(item, path.child(index), leaves)
diff --git a/src/troupe/config/scalars.py b/src/troupe/config/scalars.py
new file mode 100644
index 0000000..89dafcd
--- /dev/null
+++ b/src/troupe/config/scalars.py
@@ -0,0 +1,59 @@
+"""YAML 1.2 core-schema typing of plain scalars.
+
+This module is the single home of core-schema typing (YAML 1.2.2, section 10.3.2). The loader
+types every plain scalar it reads with :func:`resolve_plain_scalar`, and config-set-writeback types
+a written plain VALUE with the same function, so both agree exactly.
+
+ruamel.yaml's own resolver is not used because it deviates from the 1.2 core schema (for example it
+reads ``1_0`` as an integer and ``2001-12-14`` as a timestamp; both are strings under the core
+schema).
+
+Quoted and block scalars are never passed here; they are always strings.
+"""
+
+import math
+import re
+from typing import Final, TypeAlias
+
+# A runtime union (not a ``type`` statement) so callers can also use it with ``isinstance``.
+ScalarValue: TypeAlias = str | int | float | bool | None  # noqa: UP040
+"""A typed configuration value: always a plain built-in, never a library subclass."""
+
+# Explicit ASCII character classes are used instead of ``\d`` so that non-ASCII digits stay strings.
+_NULL: Final = re.compile(r"null|Null|NULL|~|")
+_TRUE: Final = re.compile(r"true|True|TRUE")
+_FALSE: Final = re.compile(r"false|False|FALSE")
+_INT_DECIMAL: Final = re.compile(r"[-+]?[0-9]+")
+_INT_OCTAL: Final = re.compile(r"0o([0-7]+)")
+_INT_HEX: Final = re.compile(r"0x([0-9a-fA-F]+)")
+_FLOAT: Final = re.compile(r"[-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?")
+_INFINITY: Final = re.compile(r"([-+]?)(\.inf|\.Inf|\.INF)")
+_NOT_A_NUMBER: Final = re.compile(r"\.nan|\.NaN|\.NAN")
+
+
+def resolve_plain_scalar(text: str) -> ScalarValue:
+    """Return the value of the plain scalar ``text`` under the YAML 1.2 core schema.
+
+    Null, boolean, integer (decimal, ``0o`` octal, ``0x`` hexadecimal) and float (including the
+    infinities and NaN) forms are converted to ``None``, ``bool``, ``int`` and ``float``; any other
+    text is returned unchanged as a string.
+    """
+    if _NULL.fullmatch(text):
+        return None
+    if _TRUE.fullmatch(text):
+        return True
+    if _FALSE.fullmatch(text):
+        return False
+    if _INT_DECIMAL.fullmatch(text):
+        return int(text, 10)
+    if match := _INT_OCTAL.fullmatch(text):
+        return int(match.group(1), 8)
+    if match := _INT_HEX.fullmatch(text):
+        return int(match.group(1), 16)
+    if _FLOAT.fullmatch(text):
+        return float(text)
+    if match := _INFINITY.fullmatch(text):
+        return -math.inf if match.group(1) == "-" else math.inf
+    if _NOT_A_NUMBER.fullmatch(text):
+        return math.nan
+    return text
diff --git a/src/troupe/config/store.py b/src/troupe/config/store.py
new file mode 100644
index 0000000..a13533a
--- /dev/null
+++ b/src/troupe/config/store.py
@@ -0,0 +1,182 @@
+"""The persisted configuration history of one theatre (7.1, 7.3, 7.5-7.9, 8.1, 8.2, 9.1-9.4).
+
+:class:`HistoryStore` wraps an eventsourcing application whose events live in one SQLite file,
+``<theatre>/.troupe/history.sqlite`` (plus SQLite's ``-wal``/``-shm`` side files while it is open).
+The application is configured only from the explicit settings below; the process environment is
+never read, so it cannot redirect the store, switch its persistence module or compress/encrypt it.
+
+Every write is one ``Application.save`` call, i.e. one SQLite transaction, so a failed import or a
+failed batch of changes leaves no partial history. Every eventsourcing/SQLite failure is reported as
+a :class:`ConfigLoadError` naming the store file. :meth:`HistoryStore.close` closes every SQLite
+connection, after which SQLite checkpoints the write-ahead log and removes the side files.
+"""
+
+import sqlite3
+import sys
+from collections.abc import Callable, Iterable, Mapping, Sequence
+from pathlib import Path
+from typing import Self
+from uuid import UUID
+
+from eventsourcing.application import Application
+from eventsourcing.domain import EventSourcingError
+from eventsourcing.utils import Environment, TopicError
+
+from troupe.config.constants import HISTORY_STORE_NAME
+from troupe.config.errors import ConfigLoadError
+from troupe.config.history import (
+    HISTORY_AGGREGATE_ID,
+    ConfigHistory,
+    HistoryRecord,
+    LeafChange,
+    RemoveChange,
+    to_history_record,
+)
+from troupe.config.resolve import Leaf
+
+# Failures of the store itself: SQLite errors (some escape eventsourcing unwrapped, e.g. when the
+# file is not a database), eventsourcing's persistence/topic errors, file-system errors, and
+# decoding errors from corrupt stored state (``json.JSONDecodeError`` is a ``ValueError``).
+_STORE_FAILURES = (sqlite3.Error, EventSourcingError, TopicError, OSError, ValueError)
+
+
+class _HistoryApplication(Application[UUID]):
+    """The eventsourcing application holding the single :class:`ConfigHistory` aggregate."""
+
+    name = "TroupeHistory"
+
+    def construct_env(self, name: str, env: Mapping[str, str] | None = None) -> Environment:
+        # Unlike the base class, never merge ``os.environ``: only the explicit settings apply.
+        return Environment(name, dict(env or {}))
+
+
+def _settings(location: Path) -> dict[str, str]:
+    return {
+        "PERSISTENCE_MODULE": "eventsourcing.sqlite",
+        "SQLITE_DBNAME": str(location),
+        "CREATE_TABLE": "y",
+        "COMPRESSOR_TOPIC": "",
+        "CIPHER_TOPIC": "",
+    }
+
+
+class HistoryStore:
+    """The history of one theatre, persisted at ``<theatre>/.troupe/history.sqlite``."""
+
+    def __init__(self, application: _HistoryApplication, location: Path) -> None:
+        self._application: _HistoryApplication | None = application
+        self._location = location
+
+    @classmethod
+    def open(cls, config_dir: Path) -> Self:
+        """Open (creating if needed) the store in ``config_dir``, which must already exist.
+
+        The store never creates directories; a missing ``config_dir`` is a load error.
+        """
+        location = config_dir / HISTORY_STORE_NAME
+        if not config_dir.is_dir():
+            raise ConfigLoadError(
+                f"cannot open the history store: {config_dir} is not a directory", file=location
+            )
+        try:
+            application = _HistoryApplication(env=_settings(location))
+        except _STORE_FAILURES as error:
+            raise _store_error("cannot open the history store", location, error) from error
+        return cls(application, location)
+
+    @property
+    def location(self) -> Path:
+        """The store file, ``<theatre>/.troupe/history.sqlite``."""
+        return self._location
+
+    def is_imported(self) -> bool:
+        """Whether the theatre's configuration has been imported (the history aggregate exists)."""
+        return self._run(
+            "cannot read the history store",
+            lambda app: _first(app.events.get(HISTORY_AGGREGATE_ID, limit=1)) is not None,
+        )
+
+    def ensure_imported(self, leaves: Sequence[Leaf]) -> bool:
+        """Import ``leaves`` unless the history exists; return whether an import happened.
+
+        An import is the history-start event plus one leaf-imported event per leaf, in the given
+        order, saved in one transaction. An empty sequence still counts as an import. When the
+        history already exists nothing is recorded (importing is not reconciling).
+        """
+        if self.is_imported():
+            return False
+        history = ConfigHistory()
+        for leaf in leaves:
+            history.import_leaf(str(leaf.path), leaf.value)
+        self._run("cannot import into the history store", lambda app: app.save(history))
+        return True
+
+    def record_changes(self, changes: Sequence[LeafChange]) -> None:
+        """Append the changes reported by one ``set`` invocation (9.1-9.4).
+
+        Precondition: :meth:`is_imported`. One leaf-value-set event per :class:`SetChange` and one
+        leaf-removed event per :class:`RemoveChange`, in the given order, saved in one transaction
+        (all or none). An empty sequence records nothing. Recording before the import, or any store
+        failure, is a :class:`ConfigLoadError` naming the store file.
+        """
+        if not changes:
+            return
+        if not self.is_imported():
+            raise ConfigLoadError(
+                "cannot record changes in the history store: the configuration is not imported",
+                file=self._location,
+            )
+
+        def record(app: _HistoryApplication) -> None:
+            history: ConfigHistory = app.repository.get(HISTORY_AGGREGATE_ID)
+            for change in changes:
+                if isinstance(change, RemoveChange):
+                    history.remove_leaf(str(change.path), change.old)
+                else:
+                    history.set_leaf(str(change.path), change.old, change.new)
+            app.save(history)
+
+        self._run("cannot record changes in the history store", record)
+
+    def records(self) -> tuple[HistoryRecord, ...]:
+        """Return the history records, oldest first."""
+
+        def project(app: _HistoryApplication) -> tuple[HistoryRecord, ...]:
+            projected = (to_history_record(event) for event in app.events.get(HISTORY_AGGREGATE_ID))
+            return tuple(record for record in projected if record is not None)
+
+        return self._run("cannot read the history store", project)
+
+    def close(self) -> None:
+        """Close the application and its SQLite connections; calling it again does nothing.
+
+        A failure while closing is reported as a load error, unless another error is already being
+        raised, which is never masked.
+        """
+        application, self._application = self._application, None
+        if application is None:
+            return
+        in_flight = sys.exception() is not None
+        try:
+            application.close()
+        except _STORE_FAILURES as error:
+            if not in_flight:
+                raise _store_error(
+                    "cannot close the history store", self._location, error
+                ) from error
+
+    def _run[T](self, action: str, operation: Callable[[_HistoryApplication], T]) -> T:
+        if self._application is None:
+            raise ConfigLoadError(f"{action}: the history store is closed", file=self._location)
+        try:
+            return operation(self._application)
+        except _STORE_FAILURES as error:
+            raise _store_error(action, self._location, error) from error
+
+
+def _first[T](items: Iterable[T]) -> T | None:
+    return next(iter(items), None)
+
+
+def _store_error(action: str, location: Path, error: BaseException) -> ConfigLoadError:
+    return ConfigLoadError(f"{action}: {error}", file=location)
diff --git a/src/troupe/config/theatre.py b/src/troupe/config/theatre.py
new file mode 100644
index 0000000..d1416c3
--- /dev/null
+++ b/src/troupe/config/theatre.py
@@ -0,0 +1,106 @@
+"""The theatre session: use cases shared by every subcommand (6.1-6.9, 7.4, 7.9, 8.3-8.5).
+
+A command opens its theatre with ``with open_theatre(directory) as theatre:``. Opening follows a
+fixed order: locate the configuration file, load it from disk, open the history store, import the
+configuration once. Nothing is created when locating or loading fails (7.4). Leaving the ``with``
+block closes the history store, whether the block succeeded or failed (7.9).
+
+Files are the truth (product-owner decision A): ``theatre.document`` is the configuration as read
+from disk by this command, :func:`show_value` reads only that document, and the history is change
+history only. A hand edit made since the import is shown and never recorded (6.9, 7.3).
+"""
+
+from contextlib import suppress
+from dataclasses import dataclass
+from pathlib import Path
+from types import TracebackType
+from typing import Self
+
+from troupe.config.errors import ConfigLoadError, WrongNodeKindError
+from troupe.config.history import HistoryRecord
+from troupe.config.loader import load_config
+from troupe.config.locate import find_config_file
+from troupe.config.model import ConfigDocument, ConfigMapping, ConfigScalar
+from troupe.config.paths import ConfigPath, path_has_prefix
+from troupe.config.resolve import flatten_leaves, resolve_path
+from troupe.config.scalars import ScalarValue
+from troupe.config.store import HistoryStore
+
+
+@dataclass(frozen=True)
+class Theatre:
+    """An opened theatre: its configuration as on disk and its (imported) history store."""
+
+    directory: Path
+    config_file: Path
+    document: ConfigDocument  # the files as on disk when the command opened the theatre
+    history: HistoryStore
+
+    def close(self) -> None:
+        """Close the history store; calling it again does nothing."""
+        self.history.close()
+
+    def __enter__(self) -> Self:
+        return self
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        traceback: TracebackType | None,
+    ) -> None:
+        """Close the store; never suppress the block's error, never replace it by a close error.
+
+        After a successful block, a failure to close is raised as a :class:`ConfigLoadError`.
+        """
+        if exc_type is None:
+            self.close()
+            return
+        with suppress(ConfigLoadError):  # the block's own error is the one reported
+            self.close()
+
+
+def open_theatre(directory: Path) -> Theatre:
+    """Open the theatre in ``directory``: locate, load, open the store, import once.
+
+    Raises :class:`ConfigLoadError` when the configuration cannot be located or loaded (no history
+    state is created then) or when the history store fails (the store is closed before the error
+    is re-raised).
+    """
+    config_file = find_config_file(directory)
+    document = load_config(config_file)
+    history = HistoryStore.open(config_file.parent)
+    try:
+        history.ensure_imported(flatten_leaves(document.root))
+    except BaseException:
+        history.close()  # never masks the error being raised
+        raise
+    return Theatre(directory=directory, config_file=config_file, document=document, history=history)
+
+
+def show_value(theatre: Theatre, path: ConfigPath) -> ScalarValue:
+    """Return the scalar at ``path`` in the loaded files (never the history).
+
+    Raises :class:`PathNotFoundError` when ``path`` does not exist and :class:`WrongNodeKindError`
+    naming ``path`` and the file holding the node when it is a mapping or a list (6.7, 6.8).
+    """
+    node = resolve_path(theatre.document, path)
+    if not isinstance(node, ConfigScalar):
+        kind = "a mapping" if isinstance(node, ConfigMapping) else "a list"
+        raise WrongNodeKindError(
+            f"is {kind}, not a value", file=node.origin.file.path, path=str(path)
+        )
+    return node.value
+
+
+def list_history(theatre: Theatre, prefix: ConfigPath | None) -> tuple[HistoryRecord, ...]:
+    """Return the history records, oldest first, optionally only those at or below ``prefix``.
+
+    Filtering is textual (``prefix`` itself and paths starting with ``prefix.``) and keeps each
+    record's original ``seq`` (8.3, 8.4).
+    """
+    records = theatre.history.records()
+    if prefix is None:
+        return records
+    text = str(prefix)
+    return tuple(record for record in records if path_has_prefix(record.path, text))
