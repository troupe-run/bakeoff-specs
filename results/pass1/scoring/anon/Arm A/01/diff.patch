+
+@pytest.mark.parametrize(
+    ("text", "segments", "blank"),
+    [
+        ("a: |2-\n    x\n   \nb: 1\n", ("a",), "   \n"),
+        ("k:\n  a: |2-\n      x\n     \nb: 1\n", ("k", "a"), "     \n"),
