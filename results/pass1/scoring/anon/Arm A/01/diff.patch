index 0000000..bceb982
--- /dev/null
+++ b/src/troupe/config/writeback/leaf_diff.py
@@ -0,0 +1,35 @@
+"""LeafDiff: leaves before (as on disk) and after a set -> history changes in recording order."""
+
+from troupe.config.history import LeafChange, RemoveChange, SetChange
+from troupe.config.model import ConfigDocument
+from troupe.config.resolve import flatten_leaves
+from troupe.config.writeback.compare import scalar_equal
+
+
+def diff_leaves(before: ConfigDocument, after: ConfigDocument) -> tuple[LeafChange, ...]:
+    """Return the history changes that turn ``before`` into ``after`` (15.1-15.5, 15.7).
+
+    ``before`` is the configuration loaded from disk for this command (never the history), so every
+    ``old`` is the value currently in the files. Leaves are compared by dotted path and typed value
+    (:func:`scalar_equal`). The result lists one :class:`SetChange` per leaf of ``after`` that is
+    new (``old`` ``None``) or changed, in ``after`` document order, then one :class:`RemoveChange`
+    per leaf of ``before`` whose path is gone, in ``before`` document order. Empty collections have
+    no leaves, so ``{}`` -> ``[]`` yields nothing. Since ``after`` is the verified read-back, the
+    leaves of a newly written YAML include are set changes and a text include is one string leaf.
+    """
+    old_leaves = {str(leaf.path): leaf for leaf in flatten_leaves(before.root)}
+    new_leaves = flatten_leaves(after.root)
+    new_paths = {str(leaf.path) for leaf in new_leaves}
+    changes: list[LeafChange] = []
+    for leaf in new_leaves:
+        old = old_leaves.get(str(leaf.path))
+        if old is None:
+            changes.append(SetChange(leaf.path, None, leaf.value))
+        elif not scalar_equal(old.value, leaf.value):
+            changes.append(SetChange(leaf.path, old.value, leaf.value))
+    changes.extend(
+        RemoveChange(leaf.path, leaf.value)
+        for key, leaf in old_leaves.items()
+        if key not in new_paths
+    )
+    return tuple(changes)
diff --git a/src/troupe/config/writeback/planner.py b/src/troupe/config/writeback/planner.py
new file mode 100644
index 0000000..d15f493
--- /dev/null
+++ b/src/troupe/config/writeback/planner.py
@@ -0,0 +1,949 @@
+"""PatchPlanner: slot changes, merges, new entries, deletions and kind changes.
+
+Turns a resolved :class:`~troupe.config.writeback.target.SetRequest` into the changed text of every
+file the set must change, one :class:`FilePatch` per changed file, in the order the files appear in
+the loaded document (root file first). Nothing is written here.
+
+A replaced value goes through :meth:`_Planner.change_slot`, which follows the design's "slot change
+decision":
+
+* an unchanged value (typed plain equality) needs no edit;
+* a YAML include root that would change is refused naming its own path, which inside a merged
+  collection is the nested path, and the included file (2.5, 5.8); a text include gets its target
+  file's whole content replaced by the text-include content rule (2.2, 2.3), or is refused when
+  VALUE is not a string (2.4);
+* an existing literal or folded block changed to a string it can still hold is rewritten in place
+  (9.4, 9.5, 10.x);
+* an existing plain, quoted or empty scalar changed to a scalar is replaced in its slot in the
+  chosen quote style (6.1-6.3); a multi-line string becomes a literal block in a block collection
+  (9.1, 9.2) and a double-quoted scalar in a flow collection or where a literal block cannot hold
+  it (9.3, 9.7);
+* every other change of kind or block form (a scalar over a collection, a collection over a scalar
+  or a collection of another kind, an empty collection, a non-string or a string no block holds
+  over a block scalar) replaces the whole value in its slot: a flow rendering inside a flow parent
+  (8.5), otherwise the new inline part on the key's (or ``-``'s) line and the new block lines in
+  place of the old ones (5.5, 5.6, 9.6, 9.7, 11.4, 11.5);
+* a non-empty mapping over a mapping or list over a list is merged entry-wise (5.1, 5.2): kept
+  entries go through the slot change, absent ones are deleted (block: whole lines through the last
+  content line, refused when the entry shares its first line with remaining content, 5.3, 5.7;
+  flow: the entry with one adjoining separator on one line, 5.4) and new ones are added in one
+  insertion; a flow mapping none of whose entries stays is rendered anew.
+
+A new key (with any missing intermediate mappings nested under it) or an appended list item goes
+through :meth:`_Planner.add_entries` into the file holding the collection (3.1, 3.2, 4.1): in a
+block collection as whole lines at its insertion point and entries column with the quote styles of
+its last remaining entry (7.1-7.3, 11.1, 11.2, 11.6), in a flow collection right after its last
+entry on that entry's line (11.3).
+
+End-of-line comments on the changed lines are moved back to their columns by the EditApplier
+(12.x). Every refusal is a :class:`WriteRefusedError` naming the file and the path (14.9).
+"""
+
+from collections.abc import Callable, Collection, Sequence
+from dataclasses import dataclass
+from functools import partial
+from pathlib import Path
+from typing import Final, NoReturn, TypeVar
+
+from troupe.config.errors import WriteRefusedError
+from troupe.config.model import (
+    CollectionStyle,
+    ConfigDocument,
+    ConfigMapping,
+    ConfigNode,
+    ConfigScalar,
+    ConfigSequence,
+    IncludeKind,
+    ScalarStyle,
+    SourceFile,
+)
+from troupe.config.paths import ConfigPath
+from troupe.config.writeback.block_scalar import (
+    Chomping,
+    literal_fits,
+    required_chomping,
+    rewrite_block,
+)
+from troupe.config.writeback.collection_render import (
+    RenderContext,
+    SiblingStyles,
+    render_block_entry,
+    render_block_value,
+    render_flow_entry,
+    render_flow_value,
+)
+from troupe.config.writeback.compare import new_to_plain, node_to_plain, plain_equal
+from troupe.config.writeback.edits import EditKind, TextEdit, apply_edits
+from troupe.config.writeback.layout import FileLayout, ValueSlot
+from troupe.config.writeback.scalar_render import (
+    Context,
+    QuoteStyle,
+    quote_style_of,
+    render_scalar,
+)
+from troupe.config.writeback.target import (
+    AddKeyTarget,
+    AppendTarget,
+    ReplaceTarget,
+    SetRequest,
+    text_include_value,
+)
+from troupe.config.writeback.value import NewMapping, NewScalar, NewSequence, NewValue
+
+_QUOTED_OR_PLAIN: Final = frozenset(
+    {ScalarStyle.PLAIN, ScalarStyle.SINGLE_QUOTED, ScalarStyle.DOUBLE_QUOTED}
+)
+_BLOCK_STYLES: Final = frozenset({ScalarStyle.LITERAL, ScalarStyle.FOLDED})
+_LF: Final = "\n"
+_INLINE_SPACE: Final = " \t"
+_WHITESPACE: Final = " \t\r\n"
+
+_T = TypeVar("_T")
+
+
+@dataclass(frozen=True)
+class FilePatch:
+    """The complete new text of one changed file."""
+
+    file: SourceFile
+    new_text: str
+
+
+def plan_patch(document: ConfigDocument, request: SetRequest) -> tuple[FilePatch, ...]:
+    """Return one :class:`FilePatch` per file the set changes, in ``document.files`` order.
+
+    Never two patches for the same file, and every patch changes its file. Raises
+    :class:`WriteRefusedError` (exit 3) naming the file and PATH for every refusal: a YAML include
+    root that would change (2.5), a non-string or another include over a text include (2.4), a
+    layout the planner cannot write (14.9), or a set that would change nothing.
+    """
+    planner = _Planner(document, request.path)
+    target = request.target
+    if isinstance(target, ReplaceTarget):
+        planner.replace(target, request.value)
+    elif isinstance(target, AddKeyTarget):
+        planner.add_key(target, request.value)
+    else:
+        planner.append(target, request.value)
+    return planner.patches()
+
+
+class _Planner:
+    """Collects the edits of one set per file and turns them into file patches."""
+
+    def __init__(self, document: ConfigDocument, path: ConfigPath) -> None:
+        self._document = document
+        self._path = path
+        # Keyed by ``SourceFile.real_path``.
+        self._layouts: dict[Path, FileLayout] = {}
+        self._edits: dict[Path, list[TextEdit]] = {}
+        self._whole: dict[Path, tuple[SourceFile, str]] = {}
+
+    # --- entry point -----------------------------------------------------------------------------
+
+    def replace(self, target: ReplaceTarget, value: NewValue) -> None:
+        """Plan the change of the existing value ``target.node`` to ``value``."""
+        parent = target.parent
+        file = parent.origin.file
+        layout = self._guard(file, self._path, lambda: self._layout(file))
+
+        def slot() -> ValueSlot:
+            if isinstance(parent, ConfigMapping):
+                entry = parent.get(str(target.key))
+                if entry is None:  # pragma: no cover - the target was resolved on this mapping
+                    raise ValueError(f"no entry {target.key!r}")
+                return layout.entry_slot(parent, entry, self._path)
+            return layout.item_slot(parent, int(target.key), self._path)
+
+        self.change_slot(layout, target.node, slot, value, self._path, self._path)
+
+    def add_key(self, target: AddKeyTarget, value: NewValue) -> None:
+        """Plan a new key in ``target.mapping``, with the missing intermediate mappings (3.1, 3.2).
+
+        The first missing key is the new entry; the keys after it become nested new mappings with
+        VALUE at the last one, rendered as one new collection value (7.4).
+        """
+        first, *intermediates = target.missing
+        for key in reversed(intermediates):
+            value = NewMapping(entries=((key, value),))
+        self.add_entries(target.mapping, ((first, value),), self._path)
+
+    def append(self, target: AppendTarget, value: NewValue) -> None:
+        """Plan VALUE as a new last item of ``target.sequence`` (4.1)."""
+        self.add_entries(target.sequence, ((None, value),), self._path)
+
+    # --- new entries -----------------------------------------------------------------------------
+
+    def add_entries(
+        self,
+        collection: ConfigMapping | ConfigSequence,
+        entries: Sequence[tuple[str | None, NewValue]],
+        path: ConfigPath,
+        deleted: Collection[int] = (),
+    ) -> None:
+        """Plan new entries (``key`` ``None``: list items) after the last entry of ``collection``.
+
+        They go into the file the collection is written in, styled after its last remaining entry
+        (7.1-7.3): ``deleted`` are the indices of the entries the same set deletes. A block
+        collection gets one line insertion at its insertion point (11.1, 11.2, 11.6); a flow
+        collection one insertion on its last entry's line (11.3).
+        """
+        file = collection.origin.file
+        layout = self._guard(file, path, lambda: self._layout(file))
+        siblings = _sibling_styles(collection, deleted)
+        if collection.style is CollectionStyle.FLOW:
+            edit = self._guard(
+                file,
+                path,
+                lambda: self._flow_insertion(layout, collection, entries, siblings, path),
+            )
+        else:
+            edit = self._guard(
+                file,
+                path,
+                lambda: self._block_insertion(layout, collection, entries, siblings, path),
+            )
+        self._add(layout, [edit])
+
+    def _block_insertion(
+        self,
+        layout: FileLayout,
+        collection: ConfigMapping | ConfigSequence,
+        entries: Sequence[tuple[str | None, NewValue]],
+        siblings: SiblingStyles,
+        path: ConfigPath,
+    ) -> TextEdit:
+        """New block entries at the entries column, inserted at the insertion point.
+
+        At a file end without a final line break the text starts with a break and ends without
+        one (11.6), unless its last line is content of a literal block that needs its break.
+        """
+        point = layout.insertion_point(collection)
+        column = layout.entries_column(collection)
+        ctx = RenderContext(
+            step=layout.indent_step(),
+            dash_offset=layout.dash_offset(),
+            line_break=layout.line_break_at(point.index),
+            path=path,
+        )
+        text = self._render(
+            lambda: "".join(
+                render_block_entry(key, value, column, siblings, ctx) for key, value in entries
+            ),
+            layout,
+            path,
+        )
+        if point.needs_leading_break:
+            text = ctx.line_break + text
+            if not _needs_final_break(entries[-1][1]):
+                text = text.removesuffix(ctx.line_break)
+        return TextEdit(point.index, point.index, text, EditKind.LINES)
+
+    def _flow_insertion(
+        self,
+        layout: FileLayout,
+        collection: ConfigMapping | ConfigSequence,
+        entries: Sequence[tuple[str | None, NewValue]],
+        siblings: SiblingStyles,
+        path: ConfigPath,
+    ) -> TextEdit:
+        """New flow entries right after the last entry (after the opening bracket when empty).
+
+        Whatever follows the last entry (a trailing comma, the closing bracket, a comment) stays
+        after the new entries (11.3).
+        """
+        separator = ", "
+        if isinstance(collection, ConfigMapping):
+            if collection.entries:
+                last = collection.entries[-1]
+                slot = layout.entry_slot(collection, last, path)
+                at = layout.content_end(last.value, slot)
+                extent = layout.inline_extent(slot)
+                if extent.start == extent.end:
+                    # An empty last value ends at its ':'; `b:,` would read as the key `b:`.
+                    separator = " , "
+            else:
+                at = self._after_opening_bracket(layout, collection)
+        elif collection.items:
+            index = len(collection.items) - 1
+            slot = layout.item_slot(collection, index, path)
+            at = layout.content_end(collection.items[index], slot)
+        else:
+            at = self._after_opening_bracket(layout, collection)
+        ctx = RenderContext(
+            step=layout.indent_step(),
+            dash_offset=layout.dash_offset(),
+            line_break=layout.line_break_at(at),
+            path=path,
+        )
+        text = self._render(
+            lambda: ", ".join(
+                render_flow_entry(key, value, siblings, ctx) for key, value in entries
+            ),
+            layout,
+            path,
+        )
+        empty = at == collection.origin.span.start + 1
+        return TextEdit(at, at, text if empty else separator + text, EditKind.INLINE)
+
+    @staticmethod
+    def _after_opening_bracket(
+        layout: FileLayout, collection: ConfigMapping | ConfigSequence
+    ) -> int:
+        start = collection.origin.span.start
+        bracket = "{" if isinstance(collection, ConfigMapping) else "["
+        if not layout.file.text.startswith(bracket, start):
+            raise ValueError(f"expected {bracket!r} at index {start} of {layout.file.path}")
+        return start + 1
+
+    # --- slot change decision --------------------------------------------------------------------
+
+    def change_slot(
+        self,
+        layout: FileLayout,
+        node: ConfigNode,
+        slot: Callable[[], ValueSlot],
+        value: NewValue,
+        path: ConfigPath,
+        at: ConfigPath,
+    ) -> None:
+        """Plan the change of ``node`` (whose slot ``slot`` locates in ``layout``) to ``value``.
+
+        ``path`` is PATH; ``at`` is the path of ``node`` itself (PATH, or a path below it inside a
+        merged collection), named when a YAML include root there would change (5.8).
+        """
+        if plain_equal(node_to_plain(node), new_to_plain(value), ordered=False):
+            return
+        if node.include is not None:
+            self._change_include(node, value, path, at)
+            return
+        if not self._guard(
+            layout.file, path, lambda: self._change_value(layout, node, slot(), value, path, at)
+        ):
+            _refuse(
+                path,
+                layout.file,
+                f"this change cannot be written: {_kind(node)} cannot be replaced by "
+                f"{_kind(value)}",
+            )
+
+    def _change_value(
+        self,
+        layout: FileLayout,
+        node: ConfigNode,
+        slot: ValueSlot,
+        value: NewValue,
+        path: ConfigPath,
+        at: ConfigPath,
+    ) -> bool:
+        """Plan an in-place change of a value that is not an include root; ``False`` if none fits.
+
+        Layout lookups raise ``ValueError`` for layouts outside the contract (``? key``); the
+        caller turns that into a refusal (14.9).
+        """
+        preferred: QuoteStyle | None = None
+        if isinstance(node, ConfigScalar) and isinstance(value, NewScalar):
+            if node.style in _QUOTED_OR_PLAIN:
+                self._replace_scalar(layout, slot, node, value, path)
+                return True
+            if isinstance(value.value, str):
+                if self._rewrite_block(layout, slot, node, value.value, path):
+                    return True
+                # A string no block can hold is double-quoted instead (9.7).
+                preferred = ScalarStyle.DOUBLE_QUOTED
+        elif _merges(node, value):
+            self._merge(layout, node, slot, value, path, at)
+            return True
+        self._replace_value(layout, slot, value, path, preferred)
+        return True
+
+    def _change_include(
+        self, node: ConfigNode, value: NewValue, path: ConfigPath, at: ConfigPath
+    ) -> None:
+        """An include root that changes: rewrite a text include's target, refuse anything else.
+
+        A YAML include root is refused naming its own path ``at`` and the included file (2.5,
+        5.8); the text-include refusals name PATH and the target (2.4).
+        """
+        include = node.include
+        if include is None:  # pragma: no cover - only called for include roots
+            raise ValueError("not an include root")
+        target = include.target
+        directive = f"file:{include.spec}"
+        if include.kind is not IncludeKind.TEXT:
+            _refuse(
+                at,
+                target,
+                f"the whole value comes from the include {directive}; "
+                "change the included file instead",
+            )
+        if not (isinstance(value, NewScalar) and isinstance(value.value, str)):
+            _refuse(
+                path,
+                target,
+                f"the value is the text include {directive}, which can only be set to a string",
+            )
+        if not isinstance(new_to_plain(value), str):
+            _refuse(
+                path,
+                target,
+                f"the value is the text include {directive}; "
+                "replacing it by another include is not supported",
+            )
+        content = text_include_value(value.value, target)
+        try:
+            content.encode("utf-8")
+        except UnicodeEncodeError:
+            _refuse(path, target, f"the string {value.value!r} cannot be written as UTF-8")
+        if content != target.text:
+            self._replace_file(target, content, path)
+
+    # --- entry-wise merges and deletions --------------------------------------------------------
+
+    def _merge(
+        self,
+        layout: FileLayout,
+        node: ConfigNode,
+        slot: ValueSlot,
+        value: NewValue,
+        path: ConfigPath,
+        at: ConfigPath,
+    ) -> None:
+        """Merge a non-empty mapping or list into an existing one of the same kind (5.1, 5.2).
+
+        Kept entries go through the slot change (unchanged ones need no edit), absent entries are
+        deleted and new entries are added in one insertion after the old last entry. A flow
+        mapping none of whose entries stays is rendered anew as a whole (8.5).
+        """
+        if isinstance(node, ConfigMapping) and isinstance(value, NewMapping):
+            self._merge_mapping(layout, node, slot, value, path, at)
+        elif isinstance(node, ConfigSequence) and isinstance(value, NewSequence):
+            self._merge_sequence(layout, node, value, path, at)
+        else:  # pragma: no cover - only called when ``_merges`` holds
+            raise ValueError("only collections of the same kind are merged")
+
+    def _merge_mapping(
+        self,
+        layout: FileLayout,
+        node: ConfigMapping,
+        slot: ValueSlot,
+        value: NewMapping,
+        path: ConfigPath,
+        at: ConfigPath,
+    ) -> None:
+        new = dict(value.entries)
+        deleted = [index for index, entry in enumerate(node.entries) if entry.key not in new]
+        if node.style is CollectionStyle.FLOW and len(deleted) == len(node.entries):
+            self._render_flow_anew(layout, slot, value, path)
+            return
+        for entry in node.entries:
+            if entry.key in new:
+                self.change_slot(
+                    layout,
+                    entry.value,
+                    partial(layout.entry_slot, node, entry, path),
+                    new[entry.key],
+                    path,
+                    at.child(entry.key),
+                )
+        self._delete_entries(layout, node, deleted, path)
+        existing = {entry.key for entry in node.entries}
+        added = [(key, item) for key, item in value.entries if key not in existing]
+        if added:
+            self.add_entries(node, added, path, deleted)
+
+    def _merge_sequence(
+        self,
+        layout: FileLayout,
+        node: ConfigSequence,
+        value: NewSequence,
+        path: ConfigPath,
+        at: ConfigPath,
+    ) -> None:
+        for index, (item, new_item) in enumerate(zip(node.items, value.items, strict=False)):
+            self.change_slot(
+                layout,
+                item,
+                partial(layout.item_slot, node, index, path),
+                new_item,
+                path,
+                at.child(index),
+            )
+        self._delete_entries(layout, node, range(len(value.items), len(node.items)), path)
+        surplus = value.items[len(node.items) :]
+        if surplus:  # no item is deleted, so the old last item stays the preceding sibling
+            self.add_entries(node, [(None, item) for item in surplus], path)
+
+    def _render_flow_anew(
+        self, layout: FileLayout, slot: ValueSlot, value: NewValue, path: ConfigPath
+    ) -> None:
+        """Replace a one-line flow collection by the flow rendering of ``value``."""
+        extent = self._guard(layout.file, path, lambda: layout.inline_extent(slot))
+        if layout.line_of(extent.start) != layout.line_of(extent.end):
+            _refuse(
+                path,
+                layout.file,
+                "this change cannot be written: the flow collection spans several lines",
+            )
+        ctx = self._context(layout, extent.start, path)
+        text = self._render(lambda: render_flow_value(value, ctx), layout, path)
+        self._add(layout, [TextEdit(extent.start, extent.end, text, EditKind.INLINE)])
+
+    def _delete_entries(
+        self,
+        layout: FileLayout,
+        collection: ConfigMapping | ConfigSequence,
+        indexes: Sequence[int],
+        path: ConfigPath,
+    ) -> None:
+        """Delete the entries (or items) at ``indexes`` of ``collection`` (5.3, 5.4, 5.7)."""
+        if not indexes:
+            return
+        if collection.style is CollectionStyle.FLOW:
+            edits = self._guard(
+                layout.file,
+                path,
+                lambda: self._flow_deletions(layout, collection, indexes, path),
+            )
+        else:
+            edits = self._guard(
+                layout.file,
+                path,
+                lambda: self._block_deletions(layout, collection, indexes, path),
+            )
+        self._add(layout, edits)
+
+    def _entry_bounds(
+        self,
+        layout: FileLayout,
+        collection: ConfigMapping | ConfigSequence,
+        index: int,
+        path: ConfigPath,
+    ) -> tuple[int, int]:
+        """Start (key or ``-``; flow item start) and content end of entry ``index``."""
+        if isinstance(collection, ConfigMapping):
+            entry = collection.entries[index]
+            slot = layout.entry_slot(collection, entry, path)
+            start = entry.key_origin.span.start
+        else:
+            slot = layout.item_slot(collection, index, path)
+            flow = collection.style is CollectionStyle.FLOW
+            # A flow item starts at its slot's indicator end; a block item at its ``-``.
+            start = slot.indicator_end if flow else slot.indicator_end - 1
+        return start, layout.content_end(slot.node, slot)
+
+    def _block_deletions(
+        self,
+        layout: FileLayout,
+        collection: ConfigMapping | ConfigSequence,
+        indexes: Sequence[int],
+        path: ConfigPath,
+    ) -> list[TextEdit]:
+        """Whole lines from each entry's first line through the break of its last content line.
+
+        An entry that does not start its line (a compact first key on a ``-`` line) is refused
+        (5.7). Adjacent ranges are joined; a range that ends a file without a final line break
+        takes the break before it instead, so the file keeps ending without one (13.2).
+        """
+        ranges: list[tuple[int, int]] = []
+        for index in indexes:
+            start, end = self._entry_bounds(layout, collection, index, path)
+            if not layout.starts_line(start):
+                _refuse(
+                    path,
+                    layout.file,
+                    "this change cannot be written: an entry to remove shares its first line "
+                    "with content that remains",
+                )
+            first = layout.line_of(start)
+            last = layout.line_of(end)
+            line_end = layout.line_span(last).end + len(layout.line_break(last))
+            if ranges and ranges[-1][1] == layout.line_start(first):
+                ranges[-1] = (ranges[-1][0], line_end)
+            else:
+                ranges.append((layout.line_start(first), line_end))
+        edits: list[TextEdit] = []
+        text = layout.file.text
+        for start, end in ranges:
+            if end == len(text) and not text.endswith(("\n", "\r")):
+                first = layout.line_of(start)
+                if first > 0:
+                    start = layout.line_span(first - 1).end
+            edits.append(TextEdit(start, end, "", EditKind.LINES))
+        return edits
+
+    def _flow_deletions(
+        self,
+        layout: FileLayout,
+        collection: ConfigMapping | ConfigSequence,
+        indexes: Sequence[int],
+        path: ConfigPath,
+    ) -> list[TextEdit]:
+        """Each entry with one adjoining separator, within one line (5.4).
+
+        An entry after a kept one takes the ``,`` (and spaces) before it; an entry before the first
+        kept one takes the ``,`` and the spaces after it. A range spanning lines is refused.
+        """
+        text = layout.file.text
+        deleted = set(indexes)
+        edits: list[TextEdit] = []
+        for index in sorted(deleted):
+            start, end = self._entry_bounds(layout, collection, index, path)
+            if any(other not in deleted for other in range(index)):
+                comma = start
+                while comma > 0 and text[comma - 1] in _WHITESPACE:
+                    comma -= 1
+                if not text.startswith(",", comma - 1):
+                    raise ValueError(f"no ',' before the entry at index {start}")
+                start = comma - 1
+            else:
+                after = end
+                while after < len(text) and text[after] in _WHITESPACE:
+                    after += 1
+                if not text.startswith(",", after):
+                    raise ValueError(f"no ',' after the entry at index {start}")
+                end = after + 1
+                while end < len(text) and text[end] in _INLINE_SPACE:
+                    end += 1
+            if layout.line_of(start) != layout.line_of(end):
+                _refuse(
+                    path,
+                    layout.file,
+                    "this change cannot be written: a flow entry to remove spans several lines",
+                )
+            edits.append(TextEdit(start, end, "", EditKind.INLINE))
+        return edits
+
+    # --- block scalars ---------------------------------------------------------------------------
+
+    def _rewrite_block(
+        self,
+        layout: FileLayout,
+        slot: ValueSlot,
+        node: ConfigScalar,
+        value: str,
+        path: ConfigPath,
+    ) -> bool:
+        """Rewrite an existing literal/folded block to ``value``; ``False`` when no block holds it.
+
+        A literal block must fit the value (9.7); a folded block refuses more-indented lines itself
+        (10.6, 10.7) and reports a value no block can hold with ``ValueError``.
+        """
+        if node.style is ScalarStyle.LITERAL and not literal_fits(value):
+            return False
+        try:
+            edits = rewrite_block(layout, slot, node, value)
+        except WriteRefusedError as error:
+            raise _with_context(error, layout.file, path) from error
+        except ValueError:
+            return False
+        self._add(layout, edits)
+        return True
+
+    # --- kind and block form changes ------------------------------------------------------------
+
+    def _replace_value(
+        self,
+        layout: FileLayout,
+        slot: ValueSlot,
+        value: NewValue,
+        path: ConfigPath,
+        preferred: QuoteStyle | None,
+    ) -> None:
+        """Replace the slot's whole value, whatever its kind, by ``value`` (5.5, 5.6, 9.6, 9.7).
+
+        In a flow parent the old text is replaced by the flow rendering (8.5). In a block parent
+        the value's inline extent gets the new inline part, its body lines are removed through the
+        last content line (5.5) and the new following lines take their place, or follow the line
+        holding the inline extent when there were none (11.4). An inline part that disappears keeps
+        an end-of-line comment at its column, and takes the spaces after the ``:`` or ``-`` with it
+        when no comment follows (11.5). A list item gets a compact collection unless its line has
+        an end-of-line comment (8.4).
+        """
+        extent = layout.inline_extent(slot)
+        empty = extent.start == extent.end
+        if slot.parent_style is CollectionStyle.FLOW:
+            ctx = self._context(layout, extent.start, path)
+            text = self._render(lambda: render_flow_value(value, ctx), layout, path)
+            text = " " + text if empty else text
+            self._add(layout, [TextEdit(extent.start, extent.end, text, EditKind.INLINE)])
+            return
+        line = layout.line_of(extent.end)
+        comment = layout.comment_start(line)
+        body = layout.body_lines(slot)
+        following_at = body.start if body is not None else self._following_start(layout, extent.end)
+        ctx = self._context(layout, following_at, path)
+        inline, following = self._render(
+            lambda: render_block_value(
+                value,
+                slot.owner_column,
+                slot.in_sequence,
+                ctx,
+                compact=comment is None,
+                preferred=preferred,
+            ),
+            layout,
+            path,
+        )
+        edits: list[TextEdit] = []
+        if inline:
+            text = " " + inline if empty else inline
+            edits.append(TextEdit(extent.start, extent.end, text, EditKind.INLINE))
+        elif not empty:
+            end = extent.end
+            line_end = layout.line_span(line).end
+            if comment is None and not layout.file.text[end:line_end].strip(_INLINE_SPACE):
+                end = line_end
+            start = extent.start if comment is not None else slot.indicator_end
+            edits.append(TextEdit(start, end, "", EditKind.INLINE))
+        strip = not _needs_final_break(value)
+        if body is None:
+            if following:
+                edits.append(
+                    self._following_edit(layout, extent.end, following, ctx.line_break, strip=strip)
+                )
+        elif layout.line_break(layout.line_of(body.end - 1)) == "":
+            # The body ends the file without a final break; so does the new text (13.2).
+            start = layout.line_span(line).end
+            text = layout.line_break(line) + following if following else ""
+            if strip:
+                text = text.removesuffix(layout.line_break(line))
+            edits.append(TextEdit(start, body.end, text, EditKind.LINES))
+        else:
+            edits.append(TextEdit(body.start, body.end, following, EditKind.LINES))
+        self._add(layout, edits)
+
+    @staticmethod
+    def _context(layout: FileLayout, index: int, path: ConfigPath) -> RenderContext:
+        return RenderContext(
+            step=layout.indent_step(),
+            dash_offset=layout.dash_offset(),
+            line_break=layout.line_break_at(index),
+            path=path,
+        )
+
+    # --- plain, quoted and empty scalars ---------------------------------------------------------
+
+    def _replace_scalar(
+        self,
+        layout: FileLayout,
+        slot: ValueSlot,
+        node: ConfigScalar,
+        value: NewScalar,
+        path: ConfigPath,
+    ) -> None:
+        """Replace a plain, quoted or empty scalar in its slot (6.1-6.3, 9.1-9.3, 9.7)."""
+        preferred = quote_style_of(node.style)
+        extent = layout.inline_extent(slot)
+        empty = extent.start == extent.end
+        if slot.parent_style is CollectionStyle.FLOW:
+            text = self._render(
+                lambda: render_scalar(value, Context.FLOW_VALUE, preferred, path), layout, path
+            )
+            following = ""
+        else:
+            insert_at = self._following_start(layout, extent.end)
+            ctx = RenderContext(
+                step=layout.indent_step(),
+                dash_offset=layout.dash_offset(),
+                line_break=layout.line_break_at(insert_at),
+                path=path,
+            )
+            text, following = self._render(
+                lambda: render_block_value(
+                    value, slot.owner_column, slot.in_sequence, ctx, preferred=preferred
+                ),
+                layout,
+                path,
+            )
+        edits: list[TextEdit] = []
+        if empty:
+            if text:
+                edits.append(TextEdit(extent.start, extent.end, " " + text, EditKind.INLINE))
+        elif text or slot.parent_style is CollectionStyle.FLOW:
+            edits.append(TextEdit(extent.start, extent.end, text, EditKind.INLINE))
+        else:
+            # An empty spelling (``{a: }`` in VALUE): drop the scalar and the spaces before it.
+            edits.append(TextEdit(slot.indicator_end, extent.end, "", EditKind.INLINE))
+        if following and isinstance(value.value, str):
+            strip = required_chomping(value.value) is Chomping.STRIP
+            edits.append(
+                self._following_edit(layout, extent.end, following, ctx.line_break, strip=strip)
+            )
+        self._add(layout, edits)
+
+    @staticmethod
+    def _following_start(layout: FileLayout, index: int) -> int:
+        """Start of the line after the one holding ``index`` (end of file when there is none)."""
+        line = layout.line_of(index)
+        if line + 1 < layout.line_count:
+            return layout.line_start(line + 1)
+        return len(layout.file.text)
+
+    def _following_edit(
+        self, layout: FileLayout, extent_end: int, following: str, line_break: str, *, strip: bool
+    ) -> TextEdit:
+        """Insert ``following`` lines after the line holding ``extent_end`` (11.4).
+
+        At the end of a file without a final line break the lines start with a break. Strip
+        content (``|-``) then leaves the file without a final break; clip and keep content needs
+        its final break, which is part of the value.
+        """
+        line = layout.line_of(extent_end)
+        at = self._following_start(layout, extent_end)
+        if layout.line_break(line) == "":
+            following = line_break + following
+            if strip:
+                following = following.removesuffix(line_break)
+        return TextEdit(at, at, following, EditKind.LINES)
+
+    # --- bookkeeping -----------------------------------------------------------------------------
+
+    def _layout(self, file: SourceFile) -> FileLayout:
+        layout = self._layouts.get(file.real_path)
+        if layout is None:
+            layout = FileLayout.build(file, self._document)
+            self._layouts[file.real_path] = layout
+        return layout
+
+    def _add(self, layout: FileLayout, edits: list[TextEdit]) -> None:
+        key = layout.file.real_path
+        if key in self._whole:
+            _refuse(self._path, layout.file, "the file would be changed in two ways")
+        self._edits.setdefault(key, []).extend(edits)
+
+    def _replace_file(self, file: SourceFile, text: str, path: ConfigPath) -> None:
+        """Replace a text-include target's whole content; one file never gets two patches (13.6).
+
+        A target included at several places may be given the same new content at each of them;
+        different contents, or a whole replacement besides edits, are refused.
+        """
+        key = file.real_path
+        if key in self._whole and self._whole[key][1] == text:
+            return
+        if key in self._whole or self._edits.get(key):
+            _refuse(path, file, "the file would be changed in two ways")
+        self._whole[key] = (file, text)
+
+    def patches(self) -> tuple[FilePatch, ...]:
+        """One patch per changed file, in ``document.files`` order (root file first)."""
+        patches: list[FilePatch] = []
+        for file in self._document.files:
+            key = file.real_path
+            if key in self._whole:
+                new_text = self._whole[key][1]
+            elif self._edits.get(key):
+                layout = self._layouts[key]
+                new_text = apply_edits(layout, self._edits[key])
+            else:
+                continue
+            if new_text != file.text:
+                patches.append(FilePatch(file=file, new_text=new_text))
+        if not patches:
+            _refuse(self._path, self._document.root_file, "the change would not modify any file")
+        return tuple(patches)
+
+    def _guard(self, file: SourceFile, path: ConfigPath, locate: Callable[[], _T]) -> _T:
+        """Run a layout lookup; a layout it cannot interpret (``? key``) is refused (14.9)."""
+        try:
+            return locate()
+        except ValueError as error:
+            _refuse(path, file, f"the value's layout cannot be written ({error})")
+
+    def _render(self, render: Callable[[], _T], layout: FileLayout, path: ConfigPath) -> _T:
+        """Run a renderer; its refusals (a lone surrogate) are completed with file and path."""
+        try:
+            return render()
+        except WriteRefusedError as error:
+            raise _with_context(error, layout.file, path) from error
+
+
+def _with_context(
+    error: WriteRefusedError, file: SourceFile, path: ConfigPath
+) -> WriteRefusedError:
+    return WriteRefusedError(
+        error.problem,
+        file=error.file if error.file is not None else file.path,
+        path=error.path if error.path is not None else str(path),
+    )
+
+
+def _refuse(path: ConfigPath, file: SourceFile, problem: str) -> NoReturn:
+    raise WriteRefusedError(problem, file=file.path, path=str(path))
+
+
+def _sibling_styles(
+    collection: ConfigMapping | ConfigSequence, deleted: Collection[int] = ()
+) -> SiblingStyles:
+    """Quote styles of the last remaining entry's key and scalar value (7.1-7.3).
+
+    Entries at the ``deleted`` indices are not in the written file, so they are no preceding
+    sibling; with no remaining entry there is no preferred style (minimal style). A value that is
+    a collection, a block scalar or a text include gives no preferred style.
+    """
+    if isinstance(collection, ConfigMapping):
+        entries = [e for i, e in enumerate(collection.entries) if i not in deleted]
+        if not entries:
+            return SiblingStyles(key=None, value=None)
+        last = entries[-1]
+        return SiblingStyles(key=quote_style_of(last.key_style), value=_value_style(last.value))
+    items = [item for i, item in enumerate(collection.items) if i not in deleted]
+    if not items:
+        return SiblingStyles(key=None, value=None)
+    return SiblingStyles(key=None, value=_value_style(items[-1]))
+
+
+def _value_style(node: ConfigNode) -> QuoteStyle | None:
+    return quote_style_of(node.style) if isinstance(node, ConfigScalar) else None
+
+
+def _needs_final_break(value: NewValue) -> bool:
+    """Whether the last line of ``value`` rendered in block style is content needing its break.
+
+    That is a literal block (clip or keep chomping) as the last value: its final line break is
+    part of the string (9.1). Everything else may end at a break-less file end (11.6).
+    """
+    while not isinstance(value, NewScalar):
+        if isinstance(value, NewMapping):
+            if not value.entries:
+                return False
+            value = value.entries[-1][1]
+        elif not value.items:
+            return False
+        else:
+            value = value.items[-1]
+    text = value.value
+    return (
+        isinstance(text, str)
+        and _LF in text
+        and literal_fits(text)
+        and required_chomping(text) is not Chomping.STRIP
+    )
+
+
+def _merges(node: ConfigNode, value: NewValue) -> bool:
+    """Whether ``value`` is merged into ``node`` entry-wise: same collection kind, not empty."""
+    if isinstance(node, ConfigMapping) and isinstance(value, NewMapping):
+        return bool(value.entries)
+    if isinstance(node, ConfigSequence) and isinstance(value, NewSequence):
+        return bool(value.items)
+    return False
+
+
+def _kind(value: ConfigNode | NewValue) -> str:
+    """A short description of a value's kind for refusal messages."""
+    if isinstance(value, ConfigMapping):
+        return "a mapping"
+    if isinstance(value, ConfigSequence):
+        return "a list"
+    if isinstance(value, ConfigScalar):
+        if value.style in _BLOCK_STYLES:
+            return f"a {value.style.value} block scalar"
+        return "a scalar"
+    if isinstance(value, NewScalar):
+        if isinstance(value.value, str):
+            return "a multi-line string" if _LF in value.value else "a string"
+        return "a non-string scalar"
+    if isinstance(value, NewMapping):
+        return "a mapping"
+    return "a list"
diff --git a/src/troupe/config/writeback/scalar_render.py b/src/troupe/config/writeback/scalar_render.py
new file mode 100644
index 0000000..c10bb49
--- /dev/null
+++ b/src/troupe/config/writeback/scalar_render.py
@@ -0,0 +1,261 @@
+"""ScalarRender: representability, style choice, plain/single/double scalar and key rendering.
+
+A string is written in a *quote style*: plain, single-quoted or double-quoted. The style of an
+existing scalar (or of the preceding sibling of a new one) is kept when it can represent the new
+text; otherwise the minimal style is used: plain if possible, otherwise single-quoted, otherwise
+double-quoted, which can represent every string.
+
+Plain representability is decided by a cheap syntactic check followed by a parse probe: the text is
+placed in a tiny document of the exact context (block value, flow value, block key, flow key),
+composed with the same ruamel.yaml composer the loader uses, and must come back as a plain scalar
+with exactly the same text, and, for values, typed as that same string by the shared
+:func:`~troupe.config.scalars.resolve_plain_scalar` (so ``0.2`` or ``true`` are never written plain
+as strings). Keys are compared as text only, as the loader treats keys textually.
+
+Existing styles are taken from the model (``MappingEntry.key_style``, ``ConfigScalar.style``) and
+narrowed with :func:`quote_style_of`, never from span text. Strings starting with ``file:`` get no
+special treatment here (2.7).
+"""
+
+import re
+from collections.abc import Callable
+from enum import Enum
+from typing import Final, Literal, TypeAlias
+
+from ruamel.yaml import YAML
+from ruamel.yaml.error import YAMLError
+from ruamel.yaml.nodes import MappingNode, Node, ScalarNode, SequenceNode
+
+from troupe.config.errors import WriteRefusedError
+from troupe.config.model import ScalarStyle
+from troupe.config.paths import ConfigPath
+from troupe.config.scalars import resolve_plain_scalar
+from troupe.config.writeback.value import NewScalar
+
+
+class Context(Enum):
+    """Where a scalar is written: as a value or a key, in a block or a flow collection."""
+
+    BLOCK_VALUE = "block-value"
+    FLOW_VALUE = "flow-value"
+    BLOCK_KEY = "block-key"
+    FLOW_KEY = "flow-key"
+
+
+# A runtime alias (not a ``type`` statement) so it can be used in ``Literal`` narrowing at runtime.
+QuoteStyle: TypeAlias = Literal[  # noqa: UP040
+    ScalarStyle.PLAIN, ScalarStyle.SINGLE_QUOTED, ScalarStyle.DOUBLE_QUOTED
+]
+"""The styles a one-line scalar or a key can be written in."""
+
+_MINIMAL_CHAIN: Final[tuple[QuoteStyle, ...]] = (
+    ScalarStyle.PLAIN,
+    ScalarStyle.SINGLE_QUOTED,
+    ScalarStyle.DOUBLE_QUOTED,
+)
+_FLOW_CONTEXTS: Final = frozenset({Context.FLOW_VALUE, Context.FLOW_KEY})
+_KEY_CONTEXTS: Final = frozenset({Context.BLOCK_KEY, Context.FLOW_KEY})
+
+_CONTROL: Final = re.compile("[\x00-\x1f\x7f-\x9f]")
+"""Control characters (6.4-6.6): C0, DEL and C1."""
+_CONTROL_EXCEPT_TAB: Final = re.compile("[\x00-\x08\x0a-\x1f\x7f-\x9f]")
+_NOT_PRINTABLE: Final = re.compile("[\ud800-\udfff\ufffe\uffff]")
+"""Non-control characters YAML cannot hold literally (outside ``c-printable``)."""
+_SURROGATE: Final = re.compile("[\ud800-\udfff]")
+_FLOW_INDICATORS: Final = frozenset(",[]{}")
+_MERGE_KEY: Final = "<<"
+"""A plain key with this text is a YAML merge key, which the loader refuses (see the merge-key
+rule in ``troupe.config.loader``, whose constant is private); such a key is quoted instead."""
+
+_NAMED_ESCAPES: Final = {
+    "\x00": "\\0",
+    "\x07": "\\a",
+    "\x08": "\\b",
+    "\x09": "\\t",
+    "\x0a": "\\n",
+    "\x0b": "\\v",
+    "\x0c": "\\f",
+    "\x0d": "\\r",
+    "\x1b": "\\e",
+    "\x85": "\\N",
+    "\\": "\\\\",
+    '"': '\\"',
+}
+_DOUBLE_QUOTED_ESCAPED: Final = re.compile('[\\\\"\x00-\x1f\x7f-\x9f\ud800-\udfff\ufffe\uffff]')
+
+_PROBE_VALUE: Final = "v"
+"""The value written after a probed key."""
+
+
+def quote_style_of(style: ScalarStyle | None) -> QuoteStyle | None:
+    """Narrow a model style to a quote style; literal, folded and ``None`` give ``None``.
+
+    ``None`` comes in for a sibling whose value has no scalar style (a text-include directive).
+    """
+    if style is ScalarStyle.PLAIN:
+        return ScalarStyle.PLAIN
+    if style is ScalarStyle.SINGLE_QUOTED:
+        return ScalarStyle.SINGLE_QUOTED
+    if style is ScalarStyle.DOUBLE_QUOTED:
+        return ScalarStyle.DOUBLE_QUOTED
+    return None
+
+
+def can_represent(style: QuoteStyle, text: str, context: Context) -> bool:
+    """Return whether ``text`` in ``style`` at ``context`` reads back as ``text`` (6.4, 6.5).
+
+    Double-quoted represents every string (characters YAML cannot hold literally are escaped).
+    """
+    if style is ScalarStyle.DOUBLE_QUOTED:
+        return True
+    if style is ScalarStyle.SINGLE_QUOTED:
+        return not (_CONTROL_EXCEPT_TAB.search(text) or _NOT_PRINTABLE.search(text))
+    return _plain_possible(text, context)
+
+
+def choose_style(value: str, context: Context, preferred: QuoteStyle | None) -> QuoteStyle:
+    """Keep ``preferred`` if it can represent ``value``, else plain, single-, double-quoted.
+
+    ``preferred`` is the existing style of a changed scalar (6.1, 6.2) or the style of the
+    preceding sibling of a new key or value (7.1-7.3); ``None`` starts the minimal chain directly.
+    """
+    if preferred is not None and can_represent(preferred, value, context):
+        return preferred
+    for style in _MINIMAL_CHAIN:
+        if can_represent(style, value, context):
+            return style
+    raise AssertionError("unreachable: double-quoted represents every string")  # pragma: no cover
+
+
+def render_scalar(
+    value: NewScalar, context: Context, preferred: QuoteStyle | None, path: ConfigPath
+) -> str:
+    """Return the text of ``value`` written at ``context``.
+
+    Non-strings are written plain in the spelling given in VALUE (6.3; an empty spelling of null
+    gives an empty text). Strings are written in :func:`choose_style`'s style; a string with a line
+    break is double-quoted here (callers in block context use a literal block instead).
+
+    Raises :class:`WriteRefusedError` naming ``path`` when the string holds a lone surrogate (from
+    a ``\\ud800`` escape in VALUE), which cannot be written as UTF-8.
+    """
+    if not isinstance(value.value, str):
+        if value.spelling is None:
+            raise ValueError(f"non-string scalar {value.value!r} has no VALUE spelling")
+        return value.spelling
+    _refuse_surrogates(value.value, path)
+    return _render(value.value, choose_style(value.value, context, preferred))
+
+
+def render_key(
+    key: str, context: Context, preferred: QuoteStyle | None, *, path: ConfigPath | None = None
+) -> str:
+    """Return the text of mapping key ``key`` written at ``context`` (a block or flow key, 7.1).
+
+    Raises :class:`WriteRefusedError` (naming ``path`` when given) for a lone surrogate.
+    """
+    if context not in _KEY_CONTEXTS:
+        raise ValueError(f"{context} is not a key context")
+    _refuse_surrogates(key, path)
+    return _render(key, choose_style(key, context, preferred))
+
+
+def _render(text: str, style: QuoteStyle) -> str:
+    if style is ScalarStyle.PLAIN:
+        return text
+    if style is ScalarStyle.SINGLE_QUOTED:
+        return "'" + text.replace("'", "''") + "'"
+    return '"' + _DOUBLE_QUOTED_ESCAPED.sub(_escape, text) + '"'
+
+
+def _escape(match: re.Match[str]) -> str:
+    """Escape one character for a double-quoted scalar (6.6)."""
+    char = match.group()
+    named = _NAMED_ESCAPES.get(char)
+    if named is not None:
+        return named
+    code = ord(char)
+    return f"\\x{code:02X}" if code <= 0xFF else f"\\u{code:04X}"
+
+
+def _refuse_surrogates(text: str, path: ConfigPath | None) -> None:
+    match = _SURROGATE.search(text)
+    if match is not None:
+        raise WriteRefusedError(
+            f"the string {text!r} contains the lone surrogate U+{ord(match.group()):04X}, "
+            "which cannot be written as UTF-8",
+            path=None if path is None else str(path),
+        )
+
+
+# --- plain representability ----------------------------------------------------------------------
+
+
+def _plain_possible(text: str, context: Context) -> bool:
+    if text == "" or text != text.strip(" \t"):
+        return False
+    if _CONTROL.search(text) or _NOT_PRINTABLE.search(text):
+        return False
+    if context in _FLOW_CONTEXTS and not _FLOW_INDICATORS.isdisjoint(text):
+        return False
+    if context not in _KEY_CONTEXTS and not isinstance(resolve_plain_scalar(text), str):
+        return False
+    if context in _KEY_CONTEXTS and text == _MERGE_KEY:
+        return False
+    return all(_probe(document, pick, text) for document, pick in _probes(text, context))
+
+
+_Pick: TypeAlias = Callable[[Node], Node | None]  # noqa: UP040
+"""Picks the probed node out of a composed probe document."""
+
+
+def _probes(text: str, context: Context) -> tuple[tuple[str, _Pick], ...]:
+    """The probe documents placing ``text`` at ``context`` (a value: as mapping value and item)."""
+    if context is Context.BLOCK_VALUE:
+        return ((f"k: {text}\n", _mapping_value), (f"- {text}\n", _sequence_item))
+    if context is Context.FLOW_VALUE:
+        return ((f"[{text}]\n", _sequence_item), (f"{{k: {text}}}\n", _mapping_value))
+    if context is Context.BLOCK_KEY:
+        return ((f"{text}: {_PROBE_VALUE}\n", _mapping_key),)
+    return ((f"{{{text}: {_PROBE_VALUE}}}\n", _mapping_key),)
+
+
+def _probe(document: str, pick: _Pick, text: str) -> bool:
+    """Compose ``document`` and check the picked node is an untagged plain scalar ``text``."""
+    try:
+        root = YAML(typ="rt").compose(document)
+    except YAMLError:
+        return False
+    if not isinstance(root, Node):
+        return False
+    node = pick(root)
+    return (
+        isinstance(node, ScalarNode)
+        and node.style is None
+        and node.anchor is None
+        and node.ctag.handle is None
+        and str(node.value) == text
+    )
+
+
+# ruamel.yaml node attributes are typed ``Any`` upstream; they are narrowed with ``isinstance``.
+def _mapping_value(root: Node) -> Node | None:
+    if isinstance(root, MappingNode) and len(root.value) == 1:
+        key, value = root.value[0]
+        if isinstance(key, ScalarNode) and key.value == "k" and isinstance(value, Node):
+            return value
+    return None
+
+
+def _mapping_key(root: Node) -> Node | None:
+    if isinstance(root, MappingNode) and len(root.value) == 1:
+        key, value = root.value[0]
+        if isinstance(value, ScalarNode) and value.value == _PROBE_VALUE and isinstance(key, Node):
+            return key
+    return None
+
+
+def _sequence_item(root: Node) -> Node | None:
+    if isinstance(root, SequenceNode) and len(root.value) == 1 and isinstance(root.value[0], Node):
+        return root.value[0]
+    return None
diff --git a/src/troupe/config/writeback/setter.py b/src/troupe/config/writeback/setter.py
new file mode 100644
index 0000000..711136e
--- /dev/null
+++ b/src/troupe/config/writeback/setter.py
@@ -0,0 +1,105 @@
+"""SetCommand: the ``set_value`` use case (no-op, plan, verify, write all, roll back, record).
+
+Everything up to the first write is pure: the target is resolved on ``theatre.document`` (the files
+as on disk, product-owner decision A), a no-op returns before planning (14.6), every patch is
+planned and verified together (13.6) and the history changes are derived, so a refusal changes no
+file (14.7). Then every patch is written atomically in order; when a write fails, the files already
+written are restored in reverse order and the failure is re-raised with PATH (14.5, 16.2). The
+changes are recorded in one batch only after every write succeeded; when recording fails, every
+written file is restored and the store error is re-raised (15.6). A failing restore never stops the
+remaining restores; the original error keeps its exit code and names each unrestored file (14.10).
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from pathlib import Path
+
+from troupe.config.errors import TroupeError, WriteRefusedError
+from troupe.config.history import LeafChange
+from troupe.config.model import SourceFile
+from troupe.config.paths import ConfigPath
+from troupe.config.theatre import Theatre
+from troupe.config.writeback.atomic import restore_file, write_atomically
+from troupe.config.writeback.compare import plain_equal
+from troupe.config.writeback.leaf_diff import diff_leaves
+from troupe.config.writeback.planner import FilePatch, plan_patch
+from troupe.config.writeback.target import resolve_target
+from troupe.config.writeback.value import NewValue
+from troupe.config.writeback.verify import verify_patch
+
+
+@dataclass(frozen=True)
+class SetOutcome:
+    """The result of a set: the written files (in write order) and the recorded changes."""
+
+    written: tuple[Path, ...]  # empty for a no-op
+    changes: tuple[LeafChange, ...]
+
+
+def set_value(theatre: Theatre, path: ConfigPath, value: NewValue) -> SetOutcome:
+    """Set the value at ``path`` to ``value`` in the files of ``theatre`` and record the history.
+
+    Raises the refusal of any pure step (exit 3 or 5) before any file is written; a
+    :class:`WriteRefusedError` naming the failed file and PATH when a file cannot be written (the
+    already-written files restored, nothing recorded); the store's :class:`ConfigLoadError` when
+    the changes cannot be recorded (every written file restored).
+    """
+    document = theatre.document
+    request = resolve_target(document, path, value)
+    if plain_equal(request.current, request.intended, ordered=False):
+        return SetOutcome(written=(), changes=())
+    patches = plan_patch(document, request)
+    after = verify_patch(theatre.config_file, document, patches, request)
+    changes = diff_leaves(document, after)
+    write_patches(patches, path)
+    try:
+        theatre.history.record_changes(changes)
+    except Exception as error:
+        unrestored = _restore([patch.file for patch in patches])
+        if unrestored:
+            raise _naming_unrestored(error, unrestored) from error
+        raise
+    return SetOutcome(written=tuple(patch.file.path for patch in patches), changes=changes)
+
+
+def write_patches(patches: Sequence[FilePatch], path: ConfigPath) -> None:
+    """Write each patch atomically, in order; on a failure restore the written files, then raise.
+
+    The failure is re-raised as a :class:`WriteRefusedError` naming the failed file, PATH and the
+    reason, plus every already-written file that could not be restored (14.5, 14.10, 16.2).
+    """
+    written: list[SourceFile] = []
+    for patch in patches:
+        try:
+            write_atomically(patch.file, patch.new_text)
+        except WriteRefusedError as error:
+            unrestored = _restore(written)
+            problem = error.problem + _unrestored_note(unrestored)
+            raise WriteRefusedError(problem, file=error.file, path=str(path)) from error
+        written.append(patch.file)
+
+
+def _restore(files: Sequence[SourceFile]) -> tuple[Path, ...]:
+    """Restore ``files`` to their original text in reverse order; return those that failed."""
+    unrestored: list[Path] = []
+    for file in reversed(files):
+        try:
+            restore_file(file)
+        except WriteRefusedError:
+            unrestored.append(file.path)
+    return tuple(unrestored)
+
+
+def _unrestored_note(unrestored: Sequence[Path]) -> str:
+    if not unrestored:
+        return ""
+    return f"; not restored: {', '.join(str(file) for file in unrestored)}"
+
+
+def _naming_unrestored(error: Exception, unrestored: Sequence[Path]) -> Exception:
+    """Return ``error`` with the unrestored files named, keeping its type (exit code) and file."""
+    note = _unrestored_note(unrestored)
+    if isinstance(error, TroupeError):
+        return type(error)(error.problem + note, file=error.file, path=error.path)
+    error.add_note(note.removeprefix("; "))
+    return error
diff --git a/src/troupe/config/writeback/target.py b/src/troupe/config/writeback/target.py
new file mode 100644
index 0000000..02a427c
--- /dev/null
+++ b/src/troupe/config/writeback/target.py
@@ -0,0 +1,213 @@
+"""TargetResolver: write-target rules 1-4, path errors (exit 5) and the intended configuration.
+
+:func:`resolve_target` decides what PATH addresses for a set:
+
+* an existing value is a :class:`ReplaceTarget` (rule 1, including include roots, whose refusals
+  are the planner's);
+* a missing key below an existing mapping is an :class:`AddKeyTarget` in that mapping's file, with
+  the missing intermediate mappings listed (rule 2);
+* an index equal to a list's length as the last segment is an :class:`AppendTarget` (rule 3);
+* everything else raises :class:`PathNotFoundError` (exit 5) naming PATH and the file of the
+  deepest existing node, so such paths never reach :func:`splice`.
+
+It also computes the intended configuration with :func:`splice`, supplying the text-include content
+rule (:func:`text_include_value`) so it applies at PATH and at any depth inside a replaced
+collection.
+"""
+
+import re
+from dataclasses import dataclass
+from typing import Final, TypeAlias
+
+from troupe.config.errors import PathNotFoundError
+from troupe.config.model import (
+    ConfigDocument,
+    ConfigMapping,
+    ConfigNode,
+    ConfigScalar,
+    ConfigSequence,
+    IncludeKind,
+    LineEnding,
+    SourceFile,
+)
+from troupe.config.paths import ConfigPath, is_index_segment
+from troupe.config.resolve import PathWalk, WalkStop, walk_path
+from troupe.config.writeback.compare import (
+    IncludeDirective,
+    PlainMapping,
+    PlainValue,
+    new_to_plain,
+    node_to_plain,
+    splice,
+)
+from troupe.config.writeback.value import NewValue
+
+
+@dataclass(frozen=True)
+class ReplaceTarget:
+    """PATH names an existing value: ``node``, reached from ``parent`` through ``key``."""
+
+    node: ConfigNode
+    parent: ConfigMapping | ConfigSequence
+    key: str | int
+    """The mapping key (``str``) or the list index (``int``) of ``node`` in ``parent``."""
+
+
+@dataclass(frozen=True)
+class AddKeyTarget:
+    """PATH continues below an existing mapping with keys it does not have."""
+
+    mapping: ConfigMapping
+    missing: tuple[str, ...]
+    """The first missing key, then the intermediate keys; VALUE goes at the last."""
+
+
+@dataclass(frozen=True)
+class AppendTarget:
+    """PATH ends with an index equal to the length of ``sequence``."""
+
+    sequence: ConfigSequence
+
+
+# A runtime union (not a ``type`` statement) so callers can also use it with ``isinstance``.
+WriteTarget: TypeAlias = ReplaceTarget | AddKeyTarget | AppendTarget  # noqa: UP040
+"""Where a set writes."""
+
+
+@dataclass(frozen=True)
+class SetRequest:
+    """A resolved set: the target, VALUE and the current and intended configurations."""
+
+    path: ConfigPath
+    target: WriteTarget
+    value: NewValue
+    current: PlainMapping
+    """The plain tree of the configuration as loaded."""
+    intended: PlainMapping
+    """The plain tree the configuration must become (include directives kept)."""
+
+
+_BARE_LINE_FEED: Final = re.compile(r"(?<!\r)\n")
+
+
+def text_include_value(value: str, target: SourceFile) -> str:
+    """Return the new content of the text-include ``target`` when ``value`` is set over it.
+
+    VALUE exactly, except that every line feed not already preceded by a carriage return is written
+    as CRLF when ``target`` uses CRLF for every line break (2.2, 2.3).
+    """
+    if target.line_ending is LineEnding.CRLF:
+        return _BARE_LINE_FEED.sub("\r\n", value)
+    return value
+
+
+def resolve_target(document: ConfigDocument, path: ConfigPath, value: NewValue) -> SetRequest:
+    """Resolve PATH on ``document`` and compute the intended configuration for VALUE.
+
+    Raises :class:`PathNotFoundError` (exit 5) naming PATH and the file holding the deepest
+    existing node when PATH lies below a scalar (including null and a text include), applies a
+    non-index segment to a list, uses an index beyond a list's length, continues after an index
+    equal to the length, or would create a digit-only key (3.4-3.6, 4.2, 4.3, 16.3).
+    """
+    walk = walk_path(document.root, path)
+    target = _target(walk)
+    current = node_to_plain(document.root)
+    if not isinstance(current, dict):  # pragma: no cover - the root is never an include
+        raise TypeError("the root of a configuration must be a mapping")
+    text_targets = _text_include_targets(document.root, current)
+
+    def text_content(text: str, directive: IncludeDirective) -> PlainValue:
+        return text_include_value(text, text_targets[id(directive)])
+
+    intended = splice(current, path, new_to_plain(value), text_content)
+    return SetRequest(path=path, target=target, value=value, current=current, intended=intended)
+
+
+def _target(walk: PathWalk) -> WriteTarget:
+    """Map a path walk to a write target, or raise the exit-5 error for it."""
+    path = walk.path
+    deepest = walk.deepest
+    if walk.stop is WalkStop.COMPLETE:
+        parent = walk.nodes[-2]
+        if isinstance(parent, ConfigScalar):  # pragma: no cover - a walk never passes a scalar
+            raise TypeError("a path walk never continues below a scalar")
+        segment = path.segments[-1]
+        key: str | int = int(segment) if isinstance(parent, ConfigSequence) else segment
+        return ReplaceTarget(node=deepest, parent=parent, key=key)
+    remaining = path.segments[walk.consumed :]
+    segment = remaining[0]
+    if walk.stop is WalkStop.MISSING_KEY and isinstance(deepest, ConfigMapping):
+        digit_keys = [key for key in remaining if is_index_segment(key)]
+        if digit_keys:
+            raise _not_found(
+                walk,
+                f"not found: key {digit_keys[0]!r} would have to be created, "
+                "but a key of digits only cannot be created (it reads as a list index)",
+            )
+        return AddKeyTarget(mapping=deepest, missing=remaining)
+    if walk.stop is WalkStop.INDEX_OUT_OF_RANGE and isinstance(deepest, ConfigSequence):
+        index = int(segment)
+        length = len(deepest.items)
+        if index > length:
+            raise _not_found(
+                walk,
+                f"not found: list index {index} is beyond the end of a list of {length} "
+                f"(use index {length} to append)",
+            )
+        if len(remaining) > 1:
+            raise _not_found(
+                walk,
+                f"not found: list index {index} appends a new item, "
+                f"so no segment may follow it (at segment {remaining[1]!r})",
+            )
+        return AppendTarget(sequence=deepest)
+    if walk.stop is WalkStop.NOT_AN_INDEX:
+        raise _not_found(
+            walk, f"not found: a list can only be indexed by a number (at segment {segment!r})"
+        )
+    raise _not_found(
+        walk,
+        f"not found: {_scalar_kind(walk)} has no children (at segment {segment!r})",
+    )
+
+
+def _scalar_kind(walk: PathWalk) -> str:
+    node = walk.deepest
+    if node.include is not None and node.include.kind is IncludeKind.TEXT:
+        return "a text include"
+    if isinstance(node, ConfigScalar) and node.value is None:
+        return "a null value"
+    return "a scalar value"
+
+
+def _not_found(walk: PathWalk, problem: str) -> PathNotFoundError:
+    return PathNotFoundError(problem, file=walk.deepest.origin.file.path, path=str(walk.path))
+
+
+def _text_include_targets(node: ConfigNode, plain: PlainValue) -> dict[int, SourceFile]:
+    """Map each text-include directive object of ``plain`` (by identity) to its target file.
+
+    ``plain`` is ``node_to_plain(node)``; :func:`splice` hands the existing directive objects of
+    that tree to the content callback, so identity finds the target the directive loads.
+    """
+    targets: dict[int, SourceFile] = {}
+    _collect_text_targets(node, plain, targets)
+    return targets
+
+
+def _collect_text_targets(
+    node: ConfigNode, plain: PlainValue, targets: dict[int, SourceFile]
+) -> None:
+    if isinstance(plain, IncludeDirective):
+        if node.include is not None and node.include.kind is IncludeKind.TEXT:
+            targets[id(plain)] = node.include.target
+            return
+        if plain.content is None:  # pragma: no cover - loaded directives always have content
+            return
+        plain = plain.content
+    if isinstance(node, ConfigMapping) and isinstance(plain, dict):
+        for entry in node.entries:
+            _collect_text_targets(entry.value, plain[entry.key], targets)
+    elif isinstance(node, ConfigSequence) and isinstance(plain, list):
+        for item, item_plain in zip(node.items, plain, strict=True):
+            _collect_text_targets(item, item_plain, targets)
diff --git a/src/troupe/config/writeback/value.py b/src/troupe/config/writeback/value.py
new file mode 100644
index 0000000..8604b97
--- /dev/null
+++ b/src/troupe/config/writeback/value.py
@@ -0,0 +1,174 @@
+"""ValueParser: the typed, style-free value tree of a VALUE given to ``troupe config set``.
+
+The parsed-value types live here so that the parser and the plain-tree module share them.
+
+VALUE is composed with ruamel.yaml's round-trip composer (never loaded), using the same
+techniques as the foundation loader: tags and anchors are detected from the node's own source
+text, duplicate keys are checked here (the composer does not reject them), and plain scalars are
+typed with the shared :func:`~troupe.config.scalars.resolve_plain_scalar` so VALUE and the loaded
+configuration agree.
+"""
+
+from dataclasses import dataclass
+from typing import Final, TypeAlias
+
+from ruamel.yaml import YAML
+from ruamel.yaml.error import MarkedYAMLError, YAMLError
+from ruamel.yaml.nodes import MappingNode, Node, ScalarNode, SequenceNode
+
+from troupe.config.errors import UsageError
+from troupe.config.paths import ConfigPath
+from troupe.config.scalars import ScalarValue, resolve_plain_scalar
+
+
+@dataclass(frozen=True)
+class NewScalar:
+    """A scalar of VALUE: its typed value and, for non-strings, the plain text it was written as."""
+
+    value: ScalarValue
+    spelling: str | None
+    """Source text for ``int``/``float``/``bool``/``None`` (e.g. ``0x1F``); ``None`` for strings."""
+
+
+@dataclass(frozen=True)
+class NewMapping:
+    """A flow mapping of VALUE; entries keep VALUE order."""
+
+    entries: tuple[tuple[str, "NewValue"], ...]
+
+
+@dataclass(frozen=True)
+class NewSequence:
+    """A flow list of VALUE."""
+
+    items: tuple["NewValue", ...]
+
+
+# A runtime union (not a ``type`` statement) so callers can also use it with ``isinstance``.
+NewValue: TypeAlias = NewScalar | NewMapping | NewSequence  # noqa: UP040
+"""One node of a parsed VALUE."""
+
+
+_NOT_A_FLOW_NODE: Final = "VALUE is not a single flow node"
+
+
+def parse_value(text: str, path: ConfigPath) -> NewValue:
+    """Parse ``text`` as exactly one YAML 1.2 core-schema flow node (1.2-1.4).
+
+    Raises :class:`UsageError` naming ``path`` when VALUE is not valid UTF-8-encodable YAML, is
+    empty or comment-only, holds several documents, a block node, a tag, an anchor or an alias, or
+    when a mapping in it has a duplicate, empty or non-scalar key (the message names that key).
+    """
+    return _Parser(text, path).parse()
+
+
+class _Parser:
+    """Composes one VALUE and converts its nodes, refusing anything outside the contract."""
+
+    def __init__(self, text: str, path: ConfigPath) -> None:
+        self._text = text
+        self._path = path
+
+    def parse(self) -> NewValue:
+        try:
+            self._text.encode("utf-8")
+        except UnicodeEncodeError as error:
+            raise self._not_flow(
+                f"character {self._text[error.start]!r} cannot be encoded as UTF-8"
+            ) from error
+        return self._convert(self._compose())
+
+    # ruamel.yaml's ``compose`` and node attributes are typed ``Any`` upstream; they are narrowed
+    # here with ``isinstance`` checks and explicit ``str``/``int`` conversions.
+    def _compose(self) -> Node:
+        try:
+            node = YAML(typ="rt").compose(self._text)
+        except MarkedYAMLError as error:
+            raise self._not_flow(_describe_marked_error(error)) from error
+        except YAMLError as error:
+            first_line = str(error).splitlines()[0] if str(error) else type(error).__name__
+            raise self._not_flow(f"invalid YAML: {first_line}") from error
+        if node is None:
+            raise self._not_flow("VALUE is empty or contains only comments")
+        if not isinstance(node, Node):  # pragma: no cover - ruamel returns a Node or None
+            raise self._not_flow("invalid YAML: unexpected composer result")
+        return node
+
+    def _convert(self, node: Node) -> NewValue:
+        self._refuse_properties(node)
+        if isinstance(node, ScalarNode):
+            return self._scalar(node)
+        if isinstance(node, SequenceNode):
+            self._refuse_block_collection(node, "list")
+            return NewSequence(tuple(self._convert(item) for item in node.value))
+        if isinstance(node, MappingNode):
+            self._refuse_block_collection(node, "mapping")
+            return self._mapping(node)
+        raise self._not_flow(  # pragma: no cover - the composer produces only these node kinds
+            f"unsupported YAML node {type(node).__name__}"
+        )
+
+    def _scalar(self, node: ScalarNode) -> NewScalar:
+        text = str(node.value)
+        if node.style is None:
+            value = resolve_plain_scalar(text)
+            return NewScalar(value, None if isinstance(value, str) else text)
+        if node.style in ("'", '"'):
+            return NewScalar(text, None)
+        raise self._not_flow(f"block scalar {self._source(node)!r} (style {node.style})")
+
+    def _mapping(self, node: MappingNode) -> NewMapping:
+        entries: list[tuple[str, NewValue]] = []
+        seen_text: set[str] = set()
+        seen_typed: set[tuple[type, ScalarValue]] = set()
+        for key_node, value_node in node.value:
+            if not isinstance(key_node, ScalarNode):
+                raise self._bad_key(f"mapping key {self._source(key_node)} is not a scalar")
+            self._refuse_properties(key_node)
+            key = str(key_node.value)
+            if key == "":
+                raise self._bad_key("mapping key '' is empty")
+            # As in the loader: equal key text is a duplicate, and so are plain keys with equal
+            # typed values (``true``/``True``, ``~``/``null``).
+            typed_value = resolve_plain_scalar(key) if key_node.style is None else key
+            typed = (type(typed_value), typed_value)
+            is_typed = key_node.style is None and not isinstance(typed_value, str)
+            if key in seen_text or (is_typed and typed in seen_typed):
+                raise self._bad_key(f"duplicate mapping key {key!r}")
+            seen_text.add(key)
+            if is_typed:
+                seen_typed.add(typed)
+            entries.append((key, self._convert(value_node)))
+        return NewMapping(tuple(entries))
+
+    def _refuse_properties(self, node: Node) -> None:
+        """Refuse an anchor (and so any alias of it) or an explicit tag on ``node``."""
+        if node.anchor is not None:
+            raise self._not_flow(f"anchor '&{node.anchor}' (anchors and aliases are refused)")
+        own_text = self._text[int(node.start_mark.index) :]
+        if node.ctag.handle is not None or own_text.startswith("!"):
+            tag = own_text.split()[0] if own_text.startswith("!") else str(node.tag)
+            raise self._not_flow(f"explicit tag '{tag}' (tags are refused)")
+
+    def _refuse_block_collection(self, node: MappingNode | SequenceNode, kind: str) -> None:
+        if node.flow_style is not True:
+            raise self._not_flow(f"block {kind} (write it in flow style, e.g. {{a: 1}} or [a, b])")
+
+    def _source(self, node: Node) -> str:
+        return self._text[int(node.start_mark.index) : int(node.end_mark.index)]
+
+    def _not_flow(self, reason: str) -> UsageError:
+        return UsageError(f"{_NOT_A_FLOW_NODE}: {reason}", path=str(self._path))
+
+    def _bad_key(self, reason: str) -> UsageError:
+        return UsageError(f"invalid VALUE: {reason}", path=str(self._path))
+
+
+def _describe_marked_error(error: MarkedYAMLError) -> str:
+    """Return ``invalid YAML: <context>, <problem> (line L, column C)``, 1-based positions."""
+    parts = [str(part) for part in (error.context, error.problem) if part]
+    problem = ", ".join(parts) if parts else type(error).__name__
+    mark = error.problem_mark or error.context_mark
+    if mark is None:
+        return f"invalid YAML: {problem}"
+    return f"invalid YAML: {problem} (line {int(mark.line) + 1}, column {int(mark.column) + 1})"
diff --git a/src/troupe/config/writeback/verify.py b/src/troupe/config/writeback/verify.py
new file mode 100644
index 0000000..a781fa0
--- /dev/null
+++ b/src/troupe/config/writeback/verify.py
@@ -0,0 +1,55 @@
+"""WriteVerifier: re-load the configuration with every patch in memory and compare.
+
+:func:`verify_patch` proves, before any file is written, that the patched texts of all files
+together load as the intended configuration (13.6, 14.1). Every file of the loaded document is
+overridden with its loaded text and every patched file with its new text; targets of includes
+written by this set are not overridden and are read (never written) from disk by the loader,
+exactly as a later ``show`` would read them. Any load error (including a missing, unreadable or
+unloadable target of a new include and an include cycle) and any difference from the intended
+configuration (including key order and include directives) is a :class:`WriteRefusedError`
+(exit 3) naming the first patched file and PATH (14.2, 14.8).
+"""
+
+from collections.abc import Sequence
+from pathlib import Path
+
+from troupe.config.errors import ConfigLoadError, WriteRefusedError
+from troupe.config.loader import load_config
+from troupe.config.model import ConfigDocument
+from troupe.config.writeback.compare import node_to_plain, plain_equal
+from troupe.config.writeback.planner import FilePatch
+from troupe.config.writeback.target import SetRequest
+
+
+def verify_patch(
+    config_file: Path,
+    document: ConfigDocument,
+    patches: Sequence[FilePatch],
+    request: SetRequest,
+) -> ConfigDocument:
+    """Re-load ``config_file`` with all ``patches`` applied in memory and return the result.
+
+    Raises :class:`WriteRefusedError` naming the first patched file and PATH when the patched
+    configuration cannot be loaded (the problem carries the loader's message, which names the
+    failing file and, for includes, the include target) or when it differs from
+    ``request.intended`` (ordered comparison; further patched files are listed in the problem).
+    """
+    if not patches:  # pragma: no cover - plan_patch never returns an empty plan
+        raise ValueError("verify_patch needs at least one patch")
+    overrides = {file.real_path: file.text for file in document.files}
+    overrides.update((patch.file.real_path, patch.new_text) for patch in patches)
+    first = patches[0].file.path
+    path = str(request.path)
+    try:
+        after = load_config(config_file, overrides)
+    except ConfigLoadError as error:
+        raise WriteRefusedError(
+            f"written value cannot be read back: {error}", file=first, path=path
+        ) from error
+    if not plain_equal(node_to_plain(after.root), request.intended, ordered=True):
+        problem = "written configuration differs from the intended configuration"
+        others = [str(patch.file.path) for patch in patches[1:]]
+        if others:
+            problem += f" (also patched: {', '.join(others)})"
+        raise WriteRefusedError(problem, file=first, path=path)
+    return after
