+
+# ---- 1.1, 1.2: show and history with --theatre from another directory ----
+
+
+def test_show_with_theatre_option_prints_the_value(
+    make_theatre: MakeTheatre, run_cli: RunCli, tmp_path: Path
+) -> None:
