@@ -0,0 +1,111 @@
+"""Entry point of the ``troupe`` console script: the ``troupe config`` command group.
+
+``run`` parses the command line, dispatches to the subcommand's handler with an in-memory bytes
+buffer and copies the buffer to stdout only when the handler succeeded. Every
+:class:`~troupe.config.errors.TroupeError` (including usage errors raised by the parser) is written
+to stderr as its formatted message and its exit code is returned; stdout stays empty (10.1-10.3).
+``run`` never opens the theatre: each handler validates its own arguments first and then opens the
+theatre in a ``with`` block, so usage errors create no state and the store is closed at the end
+of every command (1.5, 7.4, 7.9). Unexpected exceptions are not caught (traceback, exit 1); stdout
+is still empty because output is buffered.
+"""
+
+import argparse
+import io
+import sys
+from collections.abc import Sequence
+from typing import BinaryIO, Final, NoReturn, TextIO
+
+from troupe.cli.render import format_history_line, format_show_output
+from troupe.cli.set_command import add_set_subparser
+from troupe.cli.shell import SubcommandRegistrar, TroupeArgumentParser, theatre_option_parent
+from troupe.config.errors import TroupeError
+from troupe.config.paths import ConfigPath
+from troupe.config.theatre import list_history, open_theatre, show_value
+
+
+def handle_show(args: argparse.Namespace, buffer: io.BytesIO) -> None:
+    """Handler of ``troupe config show PATH``: print the scalar at PATH."""
+    path = ConfigPath.parse(args.path)
+    with open_theatre(args.theatre) as theatre:
+        buffer.write(format_show_output(show_value(theatre, path)))
+
+
+def handle_history(args: argparse.Namespace, buffer: io.BytesIO) -> None:
+    """Handler of ``troupe config history [PATH]``: print one JSON line per history record."""
+    prefix = None if args.path is None else ConfigPath.parse(args.path)
+    with open_theatre(args.theatre) as theatre:
+        for record in list_history(theatre, prefix):
+            buffer.write(format_history_line(record))
+
+
+def add_show_subparser(subparsers: "argparse._SubParsersAction[TroupeArgumentParser]") -> None:
+    """Register ``show PATH``."""
+    parser = subparsers.add_parser(
+        "show",
+        parents=[theatre_option_parent()],
+        help="print the value at PATH",
+        description="Print the scalar value at PATH as written in the configuration files.",
+    )
+    parser.add_argument("path", metavar="PATH", help="dotted path, e.g. agents.lead or items.0")
+    parser.set_defaults(handler=handle_show)
+
+
+def add_history_subparser(
+    subparsers: "argparse._SubParsersAction[TroupeArgumentParser]",
+) -> None:
+    """Register ``history [PATH]``."""
+    parser = subparsers.add_parser(
+        "history",
+        parents=[theatre_option_parent()],
+        help="list the configuration history as JSON lines",
+        description="List the recorded configuration changes, oldest first, one JSON line each.",
+    )
+    parser.add_argument(
+        "path", metavar="PATH", nargs="?", default=None, help="only PATH and paths below it"
+    )
+    parser.set_defaults(handler=handle_history)
+
+
+# ---- REGISTRATION POINT ----
+# Each entry adds one `troupe config` subcommand. config-set-writeback extends this tuple with
+# exactly one entry (its `set` registrar, imported from its own module); nothing else changes.
+SUBCOMMAND_REGISTRARS: Final[tuple[SubcommandRegistrar, ...]] = (
+    add_show_subparser,
+    add_history_subparser,
+    add_set_subparser,
+)
+
+
+def build_parser() -> TroupeArgumentParser:
+    """Build ``troupe config {...}`` with one subparser per entry of SUBCOMMAND_REGISTRARS."""
+    parser = TroupeArgumentParser(prog="troupe")
+    groups = parser.add_subparsers(dest="group", metavar="COMMAND", required=True)
+    config = groups.add_parser(
+        "config",
+        help="inspect a theatre's configuration",
+        description="Inspect a theatre's configuration and its history.",
+    )
+    subcommands = config.add_subparsers(dest="subcommand", metavar="SUBCOMMAND", required=True)
+    for register in SUBCOMMAND_REGISTRARS:
+        register(subcommands)
+    return parser
+
+
+def run(argv: Sequence[str], stdout: BinaryIO, stderr: TextIO) -> int:
+    """Run one command; return its exit code. stdout is written only on success."""
+    buffer = io.BytesIO()
+    try:
+        args = build_parser().parse_args(argv)
+        args.handler(args, buffer)
+    except TroupeError as error:
+        stderr.write(f"{error}\n")
+        return int(error.exit_code)
+    stdout.write(buffer.getvalue())
+    stdout.flush()
+    return 0
+
+
+def main() -> NoReturn:
+    """Console-script entry point."""
+    sys.exit(run(sys.argv[1:], sys.stdout.buffer, sys.stderr))
diff --git a/src/troupe/cli/render.py b/src/troupe/cli/render.py
new file mode 100644
index 0000000..850c7e5
--- /dev/null
+++ b/src/troupe/cli/render.py
@@ -0,0 +1,61 @@
+"""Pure formatting of command output as UTF-8 bytes (6.1-6.6, 8.2, 8.6, 8.7).
+
+``show`` prints one scalar per :func:`format_show_output`; ``history`` prints one JSON line per
+record per :func:`format_history_line`. Both return bytes so handlers can write them into the
+binary output buffer without newline translation (a CRLF in a text include is kept).
+"""
+
+import json
+import math
+
+from troupe.config.history import HistoryRecord
+from troupe.config.scalars import ScalarValue
+
+
+def format_show_output(value: ScalarValue) -> bytes:
+    """Return the ``show`` output for ``value``: its text followed by a newline, as UTF-8.
+
+    A string is printed exactly and gets a newline only when it does not already end with one;
+    booleans print as ``true``/``false`` (checked before ``int``, of which ``bool`` is a subclass),
+    ``None`` as ``null``, integers in decimal and floats in ``repr()`` form (``inf``, ``nan``).
+    """
+    if isinstance(value, str):
+        text = value if value.endswith("\n") else value + "\n"
+    elif isinstance(value, bool):
+        text = "true\n" if value else "false\n"
+    elif value is None:
+        text = "null\n"
+    elif isinstance(value, int):
+        text = str(value) + "\n"
+    else:
+        text = repr(value) + "\n"
+    return text.encode("utf-8")
+
+
+def format_history_line(record: HistoryRecord) -> bytes:
+    """Return one JSON Lines line for ``record`` with members seq, op, path, old, new, as UTF-8.
+
+    Infinite and NaN values in ``old``/``new`` become the strings ``".inf"``, ``"-.inf"`` and
+    ``".nan"``; the line is encoded with ``allow_nan=False`` so it is always strict JSON.
+    """
+    line = json.dumps(
+        {
+            "seq": record.seq,
+            "op": record.op,
+            "path": record.path,
+            "old": _json_safe(record.old),
+            "new": _json_safe(record.new),
+        },
+        allow_nan=False,
+    )
+    return (line + "\n").encode("utf-8")
+
+
+def _json_safe(value: ScalarValue) -> ScalarValue:
+    """Replace a non-finite float by its YAML 1.2 canonical string; return others unchanged."""
+    if isinstance(value, float):
+        if math.isnan(value):
+            return ".nan"
+        if math.isinf(value):
+            return ".inf" if value > 0 else "-.inf"
+    return value
diff --git a/src/troupe/cli/set_command.py b/src/troupe/cli/set_command.py
new file mode 100644
index 0000000..9c7f208
--- /dev/null
+++ b/src/troupe/cli/set_command.py
@@ -0,0 +1,79 @@
+"""CLI ``troupe config set PATH VALUE``: registration and handler (1.1, 1.5, 1.6, 16.1, 16.2, 16.4).
+
+Imports only :mod:`troupe.cli.shell` from the CLI package (never ``troupe.cli.main``, which imports
+this module), so the import chain is ``troupe.cli.shell <- set_command <- troupe.cli.main``.
+
+VALUEs starting with ``-``: plain argparse takes ``-1e3``, ``-.inf`` or ``-x`` for (unknown)
+options and exits 2. The ``set`` parser therefore treats an argument as an option only when it
+starts with ``--`` (``--theatre DIR``, ``--theatre=DIR``, ``--help``, or an unknown ``--bogus``,
+which still exits 2) or is exactly ``-h``; every other argument starting with a single ``-`` is a
+positional PATH or VALUE. A VALUE spelled like a long option (e.g. ``--theatre``) or ``-h`` is
+still read as the option (conservative: ``set a --theatre`` exits 2 rather than silently writing
+the text ``--theatre``); such a VALUE is given after ``--``, e.g. ``set a -- --theatre``.
+"""
+
+import argparse
+import io
+from typing import Any
+
+from troupe.cli.shell import (
+    Handler,
+    SubcommandRegistrar,
+    TroupeArgumentParser,
+    theatre_option_parent,
+)
+from troupe.config.paths import ConfigPath
+from troupe.config.theatre import open_theatre
+from troupe.config.writeback.setter import set_value
+from troupe.config.writeback.value import parse_value
+
+_HELP_OPTION = "-h"
+
+
+class _SetArgumentParser(TroupeArgumentParser):
+    """The ``set`` parser: a single-dash argument other than ``-h`` is a positional."""
+
+    # The return type of argparse's private ``_parse_optional`` differs between patch releases
+    # (a tuple or a list of tuples); this override only adds ``None`` (= positional) and otherwise
+    # returns the base result unchanged, so it is typed ``Any``.
+    def _parse_optional(self, arg_string: str) -> Any:
+        single_dash = arg_string.startswith("-") and not arg_string.startswith("--")
+        if single_dash and arg_string != _HELP_OPTION:
+            return None
+        return super()._parse_optional(arg_string)
+
+
+def handle_set(args: argparse.Namespace, out: io.BytesIO) -> None:
+    """Handler of ``troupe config set PATH VALUE``: change the value at PATH; print nothing.
+
+    PATH and VALUE are parsed before the theatre is opened, so their usage errors (exit 2) create
+    no history state; the theatre is opened (and imported, 1.6) in a ``with`` block so the history
+    store is closed when the command ends. Every error propagates to the foundation's ``run``.
+    """
+    path = ConfigPath.parse(args.path)
+    value = parse_value(args.value, path)
+    with open_theatre(args.theatre) as theatre:
+        set_value(theatre, path, value)
+
+
+def add_set_subparser(subparsers: "argparse._SubParsersAction[TroupeArgumentParser]") -> None:
+    """Register ``set PATH VALUE`` with the shared ``--theatre`` option."""
+    parser = subparsers.add_parser(
+        "set",
+        parents=[theatre_option_parent()],
+        help="set the value at PATH to VALUE",
+        description=(
+            "Set the value at PATH to VALUE (one YAML flow node) by editing the configuration "
+            "files in place. A VALUE spelled like an option (e.g. --theatre) goes after '--'."
+        ),
+    )
+    # Same parser, with the leading-dash rule above (no new state: only a method is overridden).
+    parser.__class__ = _SetArgumentParser
+    parser.add_argument("path", metavar="PATH", help="dotted path, e.g. agents.lead or items.0")
+    parser.add_argument("value", metavar="VALUE", help="YAML flow value, e.g. 0.2, abc, [a, b]")
+    parser.set_defaults(handler=handle_set)
+
+
+# Static conformance to the foundation's protocols (checked by ``mypy --strict``).
+_REGISTRAR: SubcommandRegistrar = add_set_subparser
+_HANDLER: Handler = handle_set
diff --git a/src/troupe/cli/shell.py b/src/troupe/cli/shell.py
new file mode 100644
index 0000000..ffcd1c8
--- /dev/null
+++ b/src/troupe/cli/shell.py
@@ -0,0 +1,49 @@
+"""CLI shell: the names every ``troupe config`` subcommand module needs (1.2-1.4, 10.5).
+
+This is a leaf module: it imports only the standard library and :mod:`troupe.config.errors`, never
+another ``troupe.cli`` module. Subcommand modules (here and in other specifications) import these
+names from ``troupe.cli.shell``; ``troupe.cli.main`` imports the subcommand modules. The import
+direction is therefore ``shell <- subcommand modules <- main`` and has no cycle.
+"""
+
+import argparse
+import io
+from collections.abc import Callable
+from pathlib import Path
+from typing import NoReturn
+
+from troupe.config.errors import UsageError
+
+
+class TroupeArgumentParser(argparse.ArgumentParser):
+    """An argument parser whose errors raise :class:`UsageError` (exit 2) instead of exiting."""
+
+    def error(self, message: str) -> NoReturn:
+        raise UsageError(f"{self.prog}: {message}")
+
+
+type Handler = Callable[[argparse.Namespace, io.BytesIO], None]
+"""A subcommand handler.
+
+It validates its own arguments (e.g. ``ConfigPath.parse``), then enters
+``with open_theatre(args.theatre) as theatre:`` itself, runs its use case inside the block (so the
+history store is closed at the end, 7.9) and writes its complete output as UTF-8 bytes into the
+buffer. ``run`` copies the buffer to stdout only when the handler returns normally. A handler is
+registered on its subparser with ``subparser.set_defaults(handler=...)``.
+"""
+
+type SubcommandRegistrar = Callable[[argparse._SubParsersAction[TroupeArgumentParser]], None]
+"""Adds one subparser (with ``parents=[theatre_option_parent()]``) and sets its handler."""
+
+
+def theatre_option_parent() -> TroupeArgumentParser:
+    """Return a parent parser adding ``--theatre DIR`` (default: the current directory)."""
+    parent = TroupeArgumentParser(add_help=False)
+    parent.add_argument(
+        "--theatre",
+        metavar="DIR",
+        type=Path,
+        default=Path.cwd(),
+        help="theatre directory holding .troupe/ (default: the current directory)",
+    )
+    return parent
