+
+def test_history_with_path_filters_by_prefix(make_theatre: MakeTheatre, run_cli: RunCli) -> None:
+    theatre = make_theatre(CONFIG)
+
+    result = run_cli("config", "history", "--theatre", str(theatre), "agents")
