+    if base.kind != "map" or over.kind != "map":
+        return over
+    item = Item("map", over.doc, over.node, {}, flow=over.flow, parts=[base, over])
+    item.parent, item.key, item.key_node = over.parent, over.key, over.key_node
+    for k, child in base.value.items():
+        if k in over.value:
