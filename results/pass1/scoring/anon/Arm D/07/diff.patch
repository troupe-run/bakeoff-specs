+
+def test_schema_validation(theatre):
+    theatre.write("troupe.schema.json", json.dumps(SCHEMA))
+    theatre.write("troupe.yml", "level: 9\n")
+    code, _, err = theatre.run("get", "level")
+    assert code == 4 and "level" in err
