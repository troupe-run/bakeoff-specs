+def test_new_key_under_include_is_an_override(theatre):
+    coder = theatre / ".troupe/agents/coder.yaml"
+    coder.write_text("model: sonnet\nlimits:\n  tokens: 5\ntools: [read, write]\nsteps:\n  - name: a\n")
