+def test_refused_set_keeps_earlier_reconcile_events(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({CONFIG: REPORTER})
+    imported = history_events(theatre)
+    edited = REPORTER.replace("opus", "haiku")
