+    assert "coder.settings.model" in result.err and "--expand-alias" in result.err
+    assert core(history_events(theatre)) == [*core(imported), *_seq_events(4, "opus", "haiku")]
+    assert snapshot(theatre) == _bytes({CONFIG: edited})
