+# --- WP05 T022: anchors kept on kind-changing replacement (R-9, C5); indentation with anchors ---
+
+
+@pytest.mark.parametrize(
+    ("before", "value", "after", "resolved"),
+    [
+        (  # scalar -> mapping
+            "model: &m opus\nx: *m\n",
