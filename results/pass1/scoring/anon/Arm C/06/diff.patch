+
+@pytest.mark.parametrize(
+    ("path", "value"),
+    [("plain.model", "x"), ("plain.new", "1"), ("defaults.model", "x"), ("list.1", "c")],
+)
+def test_expand_alias_without_alias_on_path_equals_plain_set(
+    make_theatre: MakeTheatre, tmp_path: Path, path: str, value: str
+) -> None:  # US4-8, C10
