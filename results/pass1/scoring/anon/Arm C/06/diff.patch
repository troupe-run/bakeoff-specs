+
+def test_expand_alias_with_reason_records_lineage(make_theatre: MakeTheatre) -> None:  # US4-10
+    theatre = make_theatre({CONFIG: REPORTER})
+
+    events = _expand(
+        theatre,
+        "coder.settings.model",
+        "sonnet",
+        "--reason",
