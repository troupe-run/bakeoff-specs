index 0000000..f9f8d17
--- /dev/null
+++ b/src/troupe/commands/set_value.py
@@ -0,0 +1,52 @@
+"""``troupe config set PATH VALUE``: change one value byte-surgically, record it (FR-010..023).
+
+Order (plan "Engineering Alignment"; research R-04, R-12, R-17):
+
+1. Parse PATH and VALUE: a usage error (exit 2) happens before anything is loaded or imported.
+2. Open the session: load the files on disk and import the theatre if this is its first command.
+3. ``apply_set``: decide placement, render, verify in memory. Refusals (exit 3) and path errors
+   (exit 5) happen here, before any write; a no-op returns no files.
+4. Write the changed file(s) atomically.
+5. Only after a successful write, append one event per changed leaf (``leaves.diff`` of the tree
+   before and the verified tree after). A failed write appends nothing.
+
+Success prints nothing.
+"""
+
+import argparse
+
+from troupe.errors import WriteRefused
+from troupe.leaves import diff, flatten
+from troupe.paths import parse_path
+from troupe.session import open_session
+from troupe.theatre import Theatre
+from troupe.values import parse_value
+from troupe.writeback.apply import apply_set
+from troupe.writeback.fileio import write_files
+
+
+def run(theatre: Theatre, args: argparse.Namespace) -> str:
+    """Set ``args.path`` to ``args.value``; return the (empty) stdout text.
+
+    Raises:
+        UsageError: If PATH has an empty segment or VALUE is not one YAML flow node (exit 2).
+        LoadError: If the configuration cannot be loaded (exit 4).
+        WriteRefused: If the change cannot be written as contracted, or writing failed (exit 3).
+        PathError: If PATH cannot be reached or created (exit 5).
+    """
+    path: str = args.path
+    raw_value: str = args.value
+    segments = parse_path(path)
+    value = parse_value(raw_value)
+    with open_session(theatre) as session:
+        plan = apply_set(session.tree, segments, path, value, raw_value)
+        if plan.tree is None:
+            return ""
+        changes = diff(flatten(session.tree), flatten(plan.tree))
+        try:
+            write_files(plan.files)
+        except OSError as err:
+            names = ", ".join(str(file.path) for file in plan.files)
+            raise WriteRefused(f"{path}: cannot write {names}: {err.strerror or err}") from err
+        session.history.record(changes)
+    return ""
diff --git a/src/troupe/commands/show.py b/src/troupe/commands/show.py
new file mode 100644
index 0000000..c63b9f4
--- /dev/null
+++ b/src/troupe/commands/show.py
@@ -0,0 +1,35 @@
+"""``troupe config show PATH``: print the scalar at PATH (FR-009).
+
+A text include is a string (the target file's exact text). A mapping, a list (including a whole
+YAML include) or a missing path is a ``PathError`` (exit 5).
+"""
+
+import argparse
+
+from troupe.errors import PathError
+from troupe.paths import lookup, parse_path, unwrap
+from troupe.session import open_session
+from troupe.theatre import Theatre
+from troupe.tree import MappingNode, ScalarNode, TextInclude
+from troupe.values import format_scalar
+
+
+def run(theatre: Theatre, args: argparse.Namespace) -> str:
+    """Return the printed scalar at ``args.path``.
+
+    Raises:
+        UsageError: If PATH has an empty segment (checked before anything is loaded).
+        LoadError: If the configuration cannot be loaded.
+        PathError: If PATH does not exist or names a mapping or list.
+    """
+    path: str = args.path
+    segments = parse_path(path)
+    with open_session(theatre) as session:
+        node = unwrap(lookup(session.tree, segments, path))
+    if isinstance(node, ScalarNode):
+        return format_scalar(node.value)
+    if isinstance(node, TextInclude):
+        return format_scalar(node.target.text)
+    # ``unwrap`` never returns a YamlInclude, so what is left is a mapping or a list.
+    kind = "mapping" if isinstance(node, MappingNode) else "list"
+    raise PathError(f"{path} is a {kind}, not a scalar")
diff --git a/src/troupe/errors.py b/src/troupe/errors.py
new file mode 100644
index 0000000..3dff1eb
--- /dev/null
+++ b/src/troupe/errors.py
@@ -0,0 +1,43 @@
+"""Error hierarchy and the single place where CLI exit codes are decided.
+
+Every contracted failure is a ``TroupeError`` subclass whose ``exit_code`` is the code the CLI
+returns. Constructors take the complete, user-facing message; callers format it, and it must
+name the offending configuration path (e.g. ``model.temperature``) or file (absolute or
+theatre-relative path), so the user can see where the problem is (TROUPE-003).
+"""
+
+from typing import ClassVar
+
+
+class TroupeError(Exception):
+    """Base for every contracted failure; carries the user-facing message."""
+
+    exit_code: ClassVar[int] = 1
+
+    def __init__(self, message: str) -> None:
+        super().__init__(message)
+        self.message = message
+
+
+class UsageError(TroupeError):
+    """Malformed invocation or unparsable VALUE."""
+
+    exit_code = 2
+
+
+class WriteRefused(TroupeError):
+    """A write was refused and no file was changed."""
+
+    exit_code = 3
+
+
+class LoadError(TroupeError):
+    """The configuration cannot be loaded."""
+
+    exit_code = 4
+
+
+class PathError(TroupeError):
+    """A configuration path was not found or names the wrong kind of node."""
+
+    exit_code = 5
diff --git a/src/troupe/history.py b/src/troupe/history.py
new file mode 100644
index 0000000..3297a4d
--- /dev/null
+++ b/src/troupe/history.py
@@ -0,0 +1,168 @@
+"""The configuration's change history: an event-sourced aggregate persisted in SQLite (FR-021).
+
+One ``ConfigHistory`` aggregate per theatre, with a fixed id (the database is per theatre), is
+stored by the real ``eventsourcing`` library in ``<theatre>/.troupe/history.sqlite`` (SQLite may
+add ``history.sqlite-wal``/``-shm`` beside it). Each leaf change is one domain event; the
+creation event is version 1, so a change event's ``seq`` is its version minus 1 (research R-02,
+R-15). Every operation saves its events in one ``save()`` call, which SQLite applies atomically.
+
+Values are JSON scalars. Non-finite floats (``.inf``, ``.nan``) round-trip through the store and
+are printed by ``json.dumps`` as ``Infinity``/``NaN``, which is not strict JSON; this edge is
+accepted.
+
+The persistence settings are fixed here and nothing is read from the process environment, so a
+user's environment variables (``PERSISTENCE_MODULE``, ``<APP>_SQLITE_DBNAME``, ``CIPHER_TOPIC``,
+...) cannot redirect the store or change its on-disk format.
+"""
+
+import uuid
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Final, Literal
+
+from eventsourcing.application import AggregateNotFoundError, Application
+from eventsourcing.domain import Aggregate, event
+from eventsourcing.utils import Environment, EnvType
+
+from troupe.leaves import Change, JsonScalar
+
+HISTORY_DB_NAME: Final = "history.sqlite"
+HISTORY_ID: Final = uuid.uuid5(uuid.NAMESPACE_URL, "troupe:config-history")
+
+
+class ConfigHistory(Aggregate):
+    """The history of one theatre's configuration; its events are the history."""
+
+    class LeafImported(Aggregate.Event):
+        path: str
+        new: JsonScalar
+
+    class LeafSet(Aggregate.Event):
+        path: str
+        old: JsonScalar
+        new: JsonScalar
+
+    class LeafRemoved(Aggregate.Event):
+        path: str
+        old: JsonScalar
+
+    @staticmethod
+    def create_id() -> uuid.UUID:
+        return HISTORY_ID
+
+    @event("Created")
+    def __init__(self) -> None:
+        pass
+
+    @event(LeafImported)
+    def leaf_imported(self, path: str, new: JsonScalar) -> None:
+        pass
+
+    @event(LeafSet)
+    def leaf_set(self, path: str, old: JsonScalar, new: JsonScalar) -> None:
+        pass
+
+    @event(LeafRemoved)
+    def leaf_removed(self, path: str, old: JsonScalar) -> None:
+        pass
+
+
+@dataclass(frozen=True)
+class HistoryRecord:
+    """One listed history event (contracts/history-event.schema.json).
+
+    Attributes:
+        seq: 1-based position in the history.
+        op: ``import``, ``set`` or ``remove``.
+        path: Dotted path in the merged configuration.
+        old: ``None`` for ``import``.
+        new: ``None`` for ``remove``.
+    """
+
+    seq: int
+    op: Literal["import", "set", "remove"]
+    path: str
+    old: JsonScalar
+    new: JsonScalar
+
+
+class _HistoryApplication(Application[uuid.UUID]):
+    """Application whose environment is exactly the one passed in (no ``os.environ``)."""
+
+    def construct_env(self, name: str, env: EnvType | None = None) -> Environment:
+        return Environment(name, dict(env or {}))
+
+
+class HistoryStore:
+    """The persisted history of one theatre.
+
+    Keep the instance referenced for as long as it is used and ``close`` it at the end:
+    ``eventsourcing`` closes the connection pool of an application that is garbage-collected.
+    Creating a store creates the database file; create it only after the configuration loaded.
+    """
+
+    def __init__(self, state_dir: Path) -> None:
+        """Open (creating if needed) ``state_dir / HISTORY_DB_NAME``."""
+        self._app = _HistoryApplication(
+            env={
+                "PERSISTENCE_MODULE": "eventsourcing.sqlite",
+                "SQLITE_DBNAME": str(state_dir / HISTORY_DB_NAME),
+            }
+        )
+
+    def is_imported(self) -> bool:
+        """Return whether the theatre has been imported (the aggregate exists)."""
+        try:
+            self._app.repository.get(HISTORY_ID)
+        except AggregateNotFoundError:
+            return False
+        return True
+
+    def import_leaves(self, leaves: dict[str, JsonScalar]) -> None:
+        """Create the history with one ``import`` event per leaf, in the given order.
+
+        An empty ``leaves`` still creates the history, so the theatre counts as imported.
+        """
+        history = ConfigHistory()
+        for path, value in leaves.items():
+            history.leaf_imported(path, value)
+        self._app.save(history)
+
+    def record(self, changes: list[Change]) -> None:
+        """Append one event per change, atomically; does nothing for ``[]``.
+
+        Raises:
+            AggregateNotFoundError: If the theatre has not been imported.
+        """
+        if not changes:
+            return
+        history: ConfigHistory = self._app.repository.get(HISTORY_ID)
+        for change in changes:
+            if change.op == "set":
+                history.leaf_set(change.path, change.old, change.new)
+            else:
+                history.leaf_removed(change.path, change.old)
+        self._app.save(history)
+
+    def records(self) -> list[HistoryRecord]:
+        """Return every change event, oldest first (``[]`` before import)."""
+        records: list[HistoryRecord] = []
+        for domain_event in self._app.events.get(HISTORY_ID):
+            seq = domain_event.originator_version - 1
+            if isinstance(domain_event, ConfigHistory.LeafImported):
+                records.append(
+                    HistoryRecord(seq, "import", domain_event.path, None, domain_event.new)
+                )
+            elif isinstance(domain_event, ConfigHistory.LeafSet):
+                records.append(
+                    HistoryRecord(seq, "set", domain_event.path, domain_event.old, domain_event.new)
+                )
+            elif isinstance(domain_event, ConfigHistory.LeafRemoved):
+                records.append(
+                    HistoryRecord(seq, "remove", domain_event.path, domain_event.old, None)
+                )
+        return records
+
+    def close(self) -> None:
+        """Close the database connections."""
+        self._app.close()
diff --git a/src/troupe/leaves.py b/src/troupe/leaves.py
new file mode 100644
index 0000000..182d9b3
--- /dev/null
+++ b/src/troupe/leaves.py
@@ -0,0 +1,95 @@
+"""Leaves of the merged configuration and the leaf-level difference between two configurations.
+
+A leaf is a scalar or a text include, addressed by its dotted path in the merged tree (research
+R-07): a YAML include is transparent, so its leaves sit at merged paths; a text include is one
+leaf whose value is the target file's exact text; list items are addressed ``list.0``,
+``list.1``. Empty mappings and lists contribute no leaves. Leaves are what history records.
+"""
+
+import math
+from dataclasses import dataclass
+from typing import Literal
+
+from troupe.tree import MappingNode, Node, ScalarNode, SequenceNode, TextInclude, YamlInclude
+
+JsonScalar = str | int | float | bool | None
+
+
+@dataclass(frozen=True)
+class Change:
+    """One leaf change: ``set`` (changed or created; ``old`` is None when created) or ``remove``.
+
+    Attributes:
+        op: ``"set"`` or ``"remove"``.
+        path: Dotted path in the merged configuration.
+        old: Value before (``None`` if the leaf did not exist).
+        new: Value after (``None`` for ``remove``).
+    """
+
+    op: Literal["set", "remove"]
+    path: str
+    old: JsonScalar
+    new: JsonScalar
+
+
+def _join(prefix: str, segment: str) -> str:
+    return f"{prefix}.{segment}" if prefix else segment
+
+
+def flatten(node: Node, prefix: str = "") -> dict[str, JsonScalar]:
+    """Return every leaf under ``node`` keyed by dotted path, in document order.
+
+    Args:
+        node: A SourceTree node (usually the root).
+        prefix: The dotted path of ``node`` itself (``""`` for the root).
+    """
+    leaves: dict[str, JsonScalar] = {}
+    _collect(node, prefix, leaves)
+    return leaves
+
+
+def _collect(node: Node, prefix: str, leaves: dict[str, JsonScalar]) -> None:
+    if isinstance(node, ScalarNode):
+        leaves[prefix] = node.value
+    elif isinstance(node, TextInclude):
+        leaves[prefix] = node.target.text
+    elif isinstance(node, YamlInclude):
+        _collect(node.root, prefix, leaves)
+    elif isinstance(node, MappingNode):
+        for entry in node.entries:
+            _collect(entry.value, _join(prefix, entry.key), leaves)
+    elif isinstance(node, SequenceNode):
+        for index, item in enumerate(node.items):
+            _collect(item, _join(prefix, str(index)), leaves)
+
+
+def same(a: JsonScalar, b: JsonScalar) -> bool:
+    """Type-aware equality: ``1``, ``1.0``, ``"1"`` and ``True`` all differ; NaN equals NaN."""
+    if type(a) is not type(b):
+        return False
+    if isinstance(a, float) and isinstance(b, float) and math.isnan(a) and math.isnan(b):
+        return True
+    return a == b
+
+
+def diff(before: dict[str, JsonScalar], after: dict[str, JsonScalar]) -> list[Change]:
+    """Return the leaf changes that turn ``before`` into ``after``.
+
+    Presence matters, not value: a leaf absent before is a ``set`` even when its new value is
+    ``None``, and a leaf absent after is a ``remove`` even when its old value was ``None``.
+
+    Returns:
+        ``set`` changes in ``after`` order, then ``remove`` changes in ``before`` order; ``[]``
+        when nothing differs.
+    """
+    changes = [
+        Change(op="set", path=path, old=before.get(path), new=value)
+        for path, value in after.items()
+        if path not in before or not same(before[path], value)
+    ]
+    changes.extend(
+        Change(op="remove", path=path, old=value, new=None)
+        for path, value in before.items()
+        if path not in after
+    )
+    return changes
diff --git a/src/troupe/loader.py b/src/troupe/loader.py
new file mode 100644
index 0000000..54a191a
--- /dev/null
+++ b/src/troupe/loader.py
@@ -0,0 +1,181 @@
+"""Build the SourceTree from the files on disk: root file plus recursive includes (FR-007, FR-008).
+
+Files are read fresh on every call (no caching across runs), as bytes decoded with strict UTF-8,
+never in text mode, so CRLF and a BOM stay in ``SourceFile.text`` and parser indices match it
+(research R-05, R-14).
+
+Include rule (the one place it is decided): a string value of any style whose text starts with
+``file:`` names a target relative to the directory of the (resolved) file containing it. A target
+ending ``.yml``/``.yaml`` (case-sensitive) is a ``YamlInclude`` whose content is embedded in
+place; any other target is a ``TextInclude`` whose value is the file's exact text. Mapping keys
+are never includes.
+"""
+
+from collections.abc import Mapping
+from pathlib import Path
+
+from troupe import yamlcore
+from troupe.errors import LoadError
+from troupe.tree import (
+    MappingEntry,
+    MappingNode,
+    Node,
+    Origin,
+    ScalarNode,
+    SequenceNode,
+    SourceFile,
+    TextInclude,
+    YamlInclude,
+)
+from troupe.yamlcore import RawMapping, RawNode, RawScalar
+
+INCLUDE_PREFIX = "file:"
+YAML_SUFFIXES = (".yml", ".yaml")
+BOM = "\ufeff"
+
+
+def read_source(path: Path) -> SourceFile:
+    """Read ``path`` as strict UTF-8 without newline translation.
+
+    Raises:
+        LoadError: If the file cannot be read or is not valid UTF-8; the message names the file.
+    """
+    resolved = path.resolve()
+    try:
+        data = resolved.read_bytes()
+    except OSError as err:
+        raise LoadError(f"cannot read {resolved}: {err.strerror or err}") from err
+    try:
+        text = data.decode("utf-8")
+    except UnicodeDecodeError as err:
+        raise LoadError(f"cannot read {resolved}: not valid UTF-8 at byte {err.start}") from err
+    return SourceFile(path=resolved, text=text)
+
+
+def load(config_file: Path, overrides: Mapping[Path, str] | None = None) -> Node:
+    """Load the configuration rooted at ``config_file`` into a SourceTree.
+
+    Args:
+        config_file: The theatre's root configuration file.
+        overrides: Text to use instead of the disk contents, keyed by (resolved) file path. Used
+            to re-load edited texts in memory and verify an edit before writing (research R-17).
+
+    Returns:
+        The root node. An empty document yields an empty block ``MappingNode``.
+
+    Raises:
+        LoadError: For unreadable or undecodable files, invalid YAML, a missing include target or
+            an include cycle; the message names the file(s).
+    """
+    return _Loader(overrides or {}).load_root(config_file)
+
+
+def dotted(segments: list[str]) -> str:
+    """Render path segments for messages (``(root)`` for the empty path)."""
+    return ".".join(segments) if segments else "(root)"
+
+
+class _Loader:
+    """State of one load: the SourceFile cache and the stack of YAML files being expanded."""
+
+    def __init__(self, overrides: Mapping[Path, str]) -> None:
+        self._overrides = {path.resolve(): text for path, text in overrides.items()}
+        self._files: dict[Path, SourceFile] = {}
+        self._stack: list[Path] = []
+
+    def load_root(self, config_file: Path) -> Node:
+        return self._load_yaml(self._source(config_file), [])
+
+    def _source(self, path: Path) -> SourceFile:
+        resolved = path.resolve()
+        cached = self._files.get(resolved)
+        if cached is None:
+            override = self._overrides.get(resolved)
+            if override is None:
+                cached = read_source(resolved)
+            else:
+                cached = SourceFile(path=resolved, text=override)
+            self._files[resolved] = cached
+        return cached
+
+    def _load_yaml(self, file: SourceFile, segments: list[str]) -> Node:
+        if file.path in self._stack:
+            chain = [*self._stack[self._stack.index(file.path) :], file.path]
+            raise LoadError(
+                f"include cycle at {dotted(segments)}: {' -> '.join(str(p) for p in chain)}"
+            )
+        self._stack.append(file.path)
+        try:
+            raw = yamlcore.compose(file.text, str(file.path))
+            if raw is None:
+                start = 1 if file.text.startswith(BOM) else 0
+                return MappingNode(origin=Origin(file, start, start), flow=False, entries=[])
+            return self._convert(raw, file, segments)
+        finally:
+            self._stack.pop()
+
+    def _convert(self, raw: RawNode, file: SourceFile, segments: list[str]) -> Node:
+        origin = Origin(file, raw.start, raw.end)
+        if isinstance(raw, RawScalar):
+            value = yamlcore.resolve_plain(raw.text) if raw.style == "plain" else raw.text
+            if isinstance(value, str) and value.startswith(INCLUDE_PREFIX):
+                return self._include(value[len(INCLUDE_PREFIX) :], origin, segments)
+            return ScalarNode(origin=origin, value=value, style=raw.style)
+        if isinstance(raw, RawMapping):
+            return MappingNode(
+                origin=origin, flow=raw.flow, entries=self._entries(raw, file, segments)
+            )
+        items = [
+            self._convert(item, file, [*segments, str(index)])
+            for index, item in enumerate(raw.items)
+        ]
+        return SequenceNode(origin=origin, flow=raw.flow, items=items)
+
+    def _entries(
+        self, raw: RawMapping, file: SourceFile, segments: list[str]
+    ) -> list[MappingEntry]:
+        entries: list[MappingEntry] = []
+        seen: set[str] = set()
+        for raw_key, raw_value in raw.pairs:
+            line = file.text.count("\n", 0, raw_key.start) + 1
+            if not isinstance(raw_key, RawScalar):
+                raise LoadError(
+                    f"cannot load {file.path}: mapping key at line {line} under"
+                    f" {dotted(segments)} is not a scalar"
+                )
+            key = raw_key.text
+            if key in seen:
+                raise LoadError(
+                    f"cannot load {file.path}: duplicate key {dotted([*segments, key])}"
+                    f" at line {line}"
+                )
+            seen.add(key)
+            entries.append(
+                MappingEntry(
+                    key=key,
+                    key_origin=Origin(file, raw_key.start, raw_key.end),
+                    key_style=raw_key.style,
+                    value=self._convert(raw_value, file, [*segments, key]),
+                )
+            )
+        return entries
+
+    def _include(self, target_text: str, origin: Origin, segments: list[str]) -> Node:
+        including = origin.file.path
+        target = including.parent / target_text
+        if not target.exists() and target.resolve() not in self._overrides:
+            raise LoadError(
+                f"include target not found: {target}"
+                f" (included from {including}, at {dotted(segments)})"
+            )
+        if target.suffix in YAML_SUFFIXES:
+            target_file = self._source(target)
+            return YamlInclude(
+                origin=origin, target=target_file, root=self._load_yaml(target_file, segments)
+            )
+        if target.is_dir():
+            raise LoadError(
+                f"include target is a directory: {target}"
+                f" (included from {including}, at {dotted(segments)})"
+            )
+        return TextInclude(origin=origin, target=self._source(target))
diff --git a/src/troupe/paths.py b/src/troupe/paths.py
new file mode 100644
index 0000000..5766adb
--- /dev/null
+++ b/src/troupe/paths.py
@@ -0,0 +1,98 @@
+"""Configuration paths (FR-003): ``.``-separated segments; a digit-only segment indexes a list.
+
+Walking is include-aware: a ``YamlInclude`` is transparent and the walk continues at its
+``root``. ``Walk.nodes`` deliberately holds the node *as found* at each step (not unwrapped), so
+a caller can tell that the whole value at a path comes from a YAML include
+(``isinstance(walk.nodes[-1], YamlInclude)``); use ``unwrap`` to get the embedded content.
+"""
+
+from dataclasses import dataclass
+
+from troupe.errors import PathError, UsageError
+from troupe.tree import MappingNode, Node, SequenceNode, YamlInclude
+
+
+def parse_path(text: str) -> list[str]:
+    """Split ``"a.b.0"`` into ``["a", "b", "0"]``.
+
+    Raises:
+        UsageError: If any segment is empty (including the empty path); the message names it.
+    """
+    segments = text.split(".")
+    if "" in segments:
+        raise UsageError(f"invalid path '{text}': empty segment")
+    return segments
+
+
+def is_index(segment: str) -> bool:
+    """Return whether ``segment`` is digit-only (ASCII ``0-9``), i.e. a list index."""
+    return segment.isascii() and segment.isdigit()
+
+
+def unwrap(node: Node) -> Node:
+    """Return the content of ``node``: the (innermost) root of a ``YamlInclude``, else ``node``."""
+    while isinstance(node, YamlInclude):
+        node = node.root
+    return node
+
+
+@dataclass
+class Walk:
+    """Result of walking a path as far as it exists.
+
+    Attributes:
+        nodes: ``nodes[0]`` is the root; ``nodes[i]`` is the node reached after ``i`` segments,
+            as found (a ``YamlInclude`` is not unwrapped; see ``unwrap``).
+        remaining: Segments not consumed; empty when the whole path exists. The walk stops at a
+            missing mapping key or at a list index ``>= len(list)``.
+    """
+
+    nodes: list[Node]
+    remaining: list[str]
+
+
+def walk(root: Node, segments: list[str]) -> Walk:
+    """Follow ``segments`` from ``root`` as far as they exist.
+
+    Raises:
+        PathError: If a non-index segment meets a list, or any segment meets a scalar or text
+            include; the message names the full dotted path and the offending prefix.
+    """
+    path = ".".join(segments)
+    nodes = [root]
+    for consumed, segment in enumerate(segments):
+        current = unwrap(nodes[-1])
+        prefix = ".".join(segments[:consumed]) or "(root)"
+        if isinstance(current, MappingNode):
+            entry = current.get(segment)
+            if entry is None:
+                return Walk(nodes, segments[consumed:])
+            nodes.append(entry.value)
+        elif isinstance(current, SequenceNode):
+            if not is_index(segment):
+                raise PathError(f"{path}: {prefix} is a list; expected an index, got '{segment}'")
+            index = int(segment)
+            if index >= len(current.items):
+                return Walk(nodes, segments[consumed:])
+            nodes.append(current.items[index])
+        else:
+            raise PathError(f"{path}: {prefix} is a scalar")
+    return Walk(nodes, [])
+
+
+def lookup(root: Node, segments: list[str], dotted: str) -> Node:
+    """Return the node at ``segments`` as found (not unwrapped; see ``unwrap``).
+
+    Args:
+        root: The tree root.
+        segments: Parsed path.
+        dotted: The path as the user wrote it, for messages.
+
+    Raises:
+        PathError: If the path does not exist (or ``walk`` raises); the message names ``dotted``.
+    """
+    result = walk(root, segments)
+    if result.remaining:
+        missing = segments[: len(segments) - len(result.remaining) + 1]
+        raise PathError(f"path not found: {dotted} (no {'.'.join(missing)})")
+    return result.nodes[-1]
diff --git a/src/troupe/session.py b/src/troupe/session.py
new file mode 100644
index 0000000..2d2b3c7
--- /dev/null
+++ b/src/troupe/session.py
@@ -0,0 +1,52 @@
+"""One command's view of a theatre: the loaded tree and the open history (research R-04).
+
+This is the only place a theatre is imported: every command that loads the configuration does so
+through ``open_session``, which imports (one ``import`` event per leaf, in document order) when
+the history does not exist yet. Importing is not reconciling: once imported, later hand edits
+never produce events.
+"""
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+from dataclasses import dataclass
+
+from troupe.history import HistoryStore
+from troupe.leaves import flatten
+from troupe.loader import load
+from troupe.theatre import Theatre
+from troupe.tree import Node
+
+
+@dataclass
+class Session:
+    """What a command works with.
+
+    Attributes:
+        theatre: The located theatre.
+        tree: The configuration as the files on disk were at the start of the command.
+        history: The theatre's history, open for the duration of the session.
+    """
+
+    theatre: Theatre
+    tree: Node
+    history: HistoryStore
+
+
+@contextmanager
+def open_session(theatre: Theatre) -> Iterator[Session]:
+    """Load the configuration, then open (and if needed import into) the history.
+
+    The configuration is loaded before the history is opened, so a load failure leaves no
+    history file behind. A command that fails after the session opened keeps the import.
+
+    Raises:
+        LoadError: If the configuration cannot be loaded; nothing is created.
+    """
+    tree = load(theatre.config_file)
+    store = HistoryStore(theatre.state_dir)
+    try:
+        if not store.is_imported():
+            store.import_leaves(flatten(tree))
+        yield Session(theatre, tree, store)
+    finally:
+        store.close()
diff --git a/src/troupe/theatre.py b/src/troupe/theatre.py
new file mode 100644
index 0000000..c0f1415
--- /dev/null
+++ b/src/troupe/theatre.py
@@ -0,0 +1,54 @@
+"""Theatre and root-file discovery (FR-002).
+
+A theatre is a directory whose configuration lives in exactly one of
+``<theatre>/.troupe/troupe.yml`` or ``<theatre>/.troupe/troupe.yaml``. Discovery only reads the
+filesystem; it never creates anything.
+"""
+
+from dataclasses import dataclass
+from pathlib import Path
+
+from troupe.errors import LoadError
+
+STATE_DIR_NAME = ".troupe"
+ROOT_FILE_NAMES = ("troupe.yml", "troupe.yaml")
+
+
+@dataclass(frozen=True)
+class Theatre:
+    """A located theatre.
+
+    Attributes:
+        directory: The theatre directory (resolved, absolute).
+        state_dir: ``directory / ".troupe"``.
+        config_file: The single root configuration file.
+    """
+
+    directory: Path
+    state_dir: Path
+    config_file: Path
+
+
+def locate(directory: Path) -> Theatre:
+    """Find the theatre's single root configuration file.
+
+    Args:
+        directory: The ``--theatre`` directory, relative or absolute.
+
+    Returns:
+        The located theatre.
+
+    Raises:
+        LoadError: If the directory does not exist, no root file exists, or both exist.
+    """
+    resolved = directory.resolve()
+    if not resolved.is_dir():
+        raise LoadError(f"theatre directory does not exist: {resolved}")
+    state_dir = resolved / STATE_DIR_NAME
+    yml, yaml = (state_dir / name for name in ROOT_FILE_NAMES)
+    present = [candidate for candidate in (yml, yaml) if candidate.is_file()]
+    if not present:
+        raise LoadError(f"no configuration file: {yml} (or {yaml.name})")
+    if len(present) > 1:
+        raise LoadError(f"both {yml} and {yaml} exist; remove one")
+    return Theatre(directory=resolved, state_dir=state_dir, config_file=present[0])
diff --git a/src/troupe/tree.py b/src/troupe/tree.py
new file mode 100644
index 0000000..97023d3
--- /dev/null
+++ b/src/troupe/tree.py
@@ -0,0 +1,112 @@
+"""SourceTree node types: the merged configuration, where every node knows its source span.
+
+The tree is rebuilt from the files on disk by ``troupe.loader.load`` for every command. Each node
+carries an ``Origin``: the ``SourceFile`` that contains its bytes and the code-point span
+``file.text[start:end]`` it was parsed from. A node reached through a YAML include belongs to the
+included file. This module is stdlib-only so that every other module can depend on it.
+"""
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+
+Scalar = str | int | float | bool | None
+ScalarStyle = Literal["plain", "single", "double", "literal", "folded"]
+
+
+@dataclass(eq=False)
+class SourceFile:
+    """One file read from disk (identity semantics: one object per resolved path per load).
+
+    Attributes:
+        path: Absolute, resolved path.
+        text: Strict UTF-8 decoded text with original newlines; a leading BOM stays as U+FEFF, so
+            parser indices and ``text`` agree character for character (research R-14).
+    """
+
+    path: Path
+    text: str
+
+
+@dataclass(frozen=True)
+class Origin:
+    """Where a node's bytes live: ``file.text[start:end]`` (code-point indices, end exclusive).
+
+    Spans are recorded exactly as the parser reports them; see ``troupe.yamlcore`` for where the
+    ends of block scalars, block collections and empty values land.
+    """
+
+    file: SourceFile
+    start: int
+    end: int
+
+    @property
+    def source(self) -> str:
+        """The source text the span covers."""
+        return self.file.text[self.start : self.end]
+
+
+@dataclass
+class ScalarNode:
+    """A scalar; ``value`` is resolved per the YAML 1.2 core schema (plain) or a string."""
+
+    origin: Origin
+    value: Scalar
+    style: ScalarStyle
+
+
+@dataclass
+class MappingEntry:
+    """One ``key: value`` pair; ``key`` is the key text as written (unescaped)."""
+
+    key: str
+    key_origin: Origin
+    key_style: ScalarStyle
+    value: "Node"
+
+
+@dataclass
+class MappingNode:
+    """An ordered mapping (block or flow)."""
+
+    origin: Origin
+    flow: bool
+    entries: list[MappingEntry]
+
+    def get(self, key: str) -> MappingEntry | None:
+        """Return the entry whose key is ``key``, or ``None``."""
+        return next((entry for entry in self.entries if entry.key == key), None)
+
+
+@dataclass
+class SequenceNode:
+    """An ordered list (block or flow)."""
+
+    origin: Origin
+    flow: bool
+    items: list["Node"]
+
+
+@dataclass
+class YamlInclude:
+    """A ``file:`` string naming a ``.yml``/``.yaml`` target whose content is embedded here.
+
+    ``origin`` is the span of the ``file:`` string in the including file; ``root`` is the
+    target's converted root node (an empty mapping for an empty target).
+    """
+
+    origin: Origin
+    target: SourceFile
+    root: "Node"
+
+
+@dataclass
+class TextInclude:
+    """A ``file:`` string naming any other target; its value is ``target.text`` exactly."""
+
+    origin: Origin
+    target: SourceFile
+
+
+# A plain union (not a ``type`` alias) so that ``isinstance(x, Node)`` works.
+Node = ScalarNode | MappingNode | SequenceNode | YamlInclude | TextInclude
diff --git a/src/troupe/values.py b/src/troupe/values.py
new file mode 100644
index 0000000..9d1f31b
--- /dev/null
+++ b/src/troupe/values.py
@@ -0,0 +1,79 @@
+"""VALUE arguments and scalar printing: the one place both conversions are decided (FR-004/005).
+
+``parse_value`` turns a ``set`` VALUE argument into a plain Python value. VALUE is exactly one
+YAML 1.2 core-schema *flow* node: plain scalars resolve per ``yamlcore.resolve_plain``, quoted
+scalars are strings, ``{...}`` is a ``dict`` and ``[...]`` a ``list``. Block nodes (``a: 1``,
+``- a``, ``|``/``>`` scalars) are refused, because they cannot be told apart from a mistyped
+argument. ``format_scalar`` is how ``show`` prints a scalar.
+"""
+
+from troupe import yamlcore
+from troupe.errors import LoadError, UsageError
+from troupe.tree import Scalar
+from troupe.yamlcore import RawMapping, RawNode, RawScalar
+
+type Value = Scalar | dict[str, Value] | list[Value]
+
+_BLOCK_SCALAR_STYLES = ("literal", "folded")
+
+
+def parse_value(text: str) -> Value:
+    """Parse a VALUE argument as one YAML 1.2 core flow node.
+
+    An empty (or comment-only) VALUE is the empty plain scalar, i.e. ``None``.
+
+    Raises:
+        UsageError: If ``text`` is not valid YAML, is not a single flow node, uses anchors,
+            aliases or tags, or has a duplicate or non-scalar mapping key; the message quotes
+            ``text``.
+    """
+    try:
+        raw = yamlcore.compose(text, source=f"VALUE {text!r}")
+    except LoadError as err:
+        raise UsageError(err.message) from err
+    if raw is None:
+        return None
+    if _is_block(raw):
+        raise UsageError(f"VALUE is not a single YAML flow node: {text!r}")
+    return _convert(raw, text)
+
+
+def _is_block(raw: RawNode) -> bool:
+    # Only the root needs checking: YAML forbids block nodes inside flow collections.
+    if isinstance(raw, RawScalar):
+        return raw.style in _BLOCK_SCALAR_STYLES
+    return not raw.flow
+
+
+def _convert(raw: RawNode, text: str) -> Value:
+    if isinstance(raw, RawScalar):
+        return yamlcore.resolve_plain(raw.text) if raw.style == "plain" else raw.text
+    if isinstance(raw, RawMapping):
+        mapping: dict[str, Value] = {}
+        for raw_key, raw_value in raw.pairs:
+            if not isinstance(raw_key, RawScalar):
+                raise UsageError(f"VALUE has a mapping key that is not a scalar: {text!r}")
+            if raw_key.text in mapping:
+                raise UsageError(f"VALUE has duplicate key {raw_key.text!r}: {text!r}")
+            mapping[raw_key.text] = _convert(raw_value, text)
+        return mapping
+    return [_convert(item, text) for item in raw.items]
+
+
+def format_scalar(value: Scalar) -> str:
+    """Return how ``show`` prints ``value`` (contracts/cli.md "Scalar printing").
+
+    A string prints exactly, plus ``"\\n"`` unless it already ends with one; ``true``/``false``;
+    ``null``; integers in decimal; floats as ``repr()``. Every result ends with ``"\\n"``.
+    """
+    if isinstance(value, str):
+        return value if value.endswith("\n") else value + "\n"
+    if isinstance(value, bool):  # before int: bool is an int subclass
+        printed = "true" if value else "false"
+    elif value is None:
+        printed = "null"
+    elif isinstance(value, int):
+        printed = str(value)
+    else:
+        printed = repr(value)
+    return printed + "\n"
diff --git a/src/troupe/writeback/__init__.py b/src/troupe/writeback/__init__.py
new file mode 100644
index 0000000..3ce3659
--- /dev/null
+++ b/src/troupe/writeback/__init__.py
@@ -0,0 +1,57 @@
+"""Byte-surgical write-back: never re-serialise a file, splice only the replacement text.
+
+Decision DM-01M3XGW5Z97R8VC909JF3TVPTT (research R-01): renderers look at the original text and
+the spans recorded in the SourceTree and return ``TextEdit`` values, each replacing one span of a
+``SourceFile.text`` with new text. ``apply_edits`` splices them into the original text, so every
+byte outside the edited spans is identical by construction. Only once every edit for every file
+has been planned and verified are the new texts written, atomically, by ``fileio.write_files``
+(NFR-002).
+
+Building blocks:
+
+- ``fileio``: newline detection, CRLF conversion and atomic file replacement.
+- ``scalars``: which quoting style can represent a string, style choice and rendering (FR-015).
+- ``comments``: rebuilding one changed line so its end-of-line comment keeps its column (FR-020).
+"""
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from itertools import pairwise
+
+
+@dataclass(frozen=True)
+class TextEdit:
+    """Replace ``text[start:end]`` of one file's text with ``text``.
+
+    Attributes:
+        start: Code-point index into ``SourceFile.text``.
+        end: Exclusive end index; ``start == end`` is a pure insertion.
+        text: The replacement text.
+    """
+
+    start: int
+    end: int
+    text: str
+
+
+def apply_edits(text: str, edits: Sequence[TextEdit]) -> str:
+    """Return ``text`` with every edit spliced in; indices refer to the original ``text``.
+
+    Edits may be given in any order. Two insertions at the same index are applied in the order
+    given (the first one ends up first).
+
+    Raises:
+        ValueError: If an edit is out of bounds or two edits overlap. This is a programming error
+            in a renderer, not a contract error.
+    """
+    ordered = sorted(edits, key=lambda edit: (edit.start, edit.end))
+    for edit in ordered:
+        if not 0 <= edit.start <= edit.end <= len(text):
+            raise ValueError(f"edit {edit} is out of bounds for a text of length {len(text)}")
+    for previous, current in pairwise(ordered):
+        if current.start < previous.end:
+            raise ValueError(f"overlapping edits {previous} and {current}")
+    result = text
+    for edit in reversed(ordered):
+        result = result[: edit.start] + edit.text + result[edit.end :]
+    return result
diff --git a/src/troupe/writeback/apply.py b/src/troupe/writeback/apply.py
new file mode 100644
index 0000000..848d101
--- /dev/null
+++ b/src/troupe/writeback/apply.py
@@ -0,0 +1,356 @@
+"""``apply_set``: plan, render and verify one ``set`` without touching the disk (FR-010..FR-020).
+
+``apply_set`` composes the building blocks: ``placement.place`` decides where the change goes,
+``scalars``/``comments``/``blocks``/``collections`` render ``TextEdit`` values, which are spliced
+into the original texts. Before anything may be written, the new texts are re-loaded in memory
+and verified (research R-17): the value at PATH must read back as the new value, and the rest of
+the configuration (every node outside PATH: kind, keys, order, values, scalar styles, includes)
+must be unchanged. Any mismatch is a refusal (exit 3), so a renderer bug can never become a
+corrupted file. A ``set`` whose value is already the current value is a no-op: no texts at all.
+
+How an existing scalar is written (``ReplaceScalar``):
+
+- a single-line value replaces exactly the scalar's span, in its current quoting style if that
+  can represent it (``scalars.render_scalar``); the line's end-of-line comment keeps its column
+  (``comments.replace_in_line``);
+- a multi-line string replacing a plain or quoted scalar becomes a literal block, or a
+  double-quoted scalar inside a flow collection (``blocks.replace_with_multiline``);
+- a string replacing a literal or folded block scalar is written by ``blocks.replace_block``;
+- a collection value, a value for an empty (zero-width) null, and a non-string value replacing a
+  block scalar are kind changes (``collections.replace_value_edits``).
+
+Text includes follow research R-16 (revised): with a CRLF target VALUE must be a string, written
+with CRLF line endings (else exit 3); with an LF or break-free target a string is written as
+parsed and any non-string VALUE (scalar, mapping or list) as the VALUE argument exactly as typed.
+
+Choices made where the contract is silent (TROUPE-002, TROUPE-008):
+
+- A string a block scalar cannot hold (control characters other than tab) replacing a plain or
+  quoted scalar in block context is written double-quoted on the scalar's line.
+- A string ``file:...`` written as a value becomes an include when the files are read again; it
+  is verified as written text (the include string), not as the included content.
+- Comparisons (no-op and verification) are type-aware (``leaves.same``: ``1``, ``1.0``, ``"1"``
+  and ``true`` differ) and ignore mapping key order only in the no-op check, where the
+  configuration means the same either way.
+"""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import NoReturn
+
+from troupe import yamlcore
+from troupe.errors import LoadError, PathError, WriteRefused
+from troupe.leaves import same
+from troupe.loader import load
+from troupe.paths import walk
+from troupe.tree import (
+    MappingNode,
+    Node,
+    ScalarNode,
+    SequenceNode,
+    SourceFile,
+    TextInclude,
+    YamlInclude,
+)
+from troupe.values import Value
+from troupe.writeback import TextEdit, apply_edits
+from troupe.writeback.blocks import can_block, parse_block, replace_block, replace_with_multiline
+from troupe.writeback.collections import (
+    detect_indent,
+    entry_column,
+    new_item_edits,
+    new_key_edits,
+    replace_value_edits,
+)
+from troupe.writeback.comments import replace_in_line
+from troupe.writeback.fileio import detect_newline, to_crlf, uses_crlf
+from troupe.writeback.placement import (
+    AddKeys,
+    AppendItem,
+    Placement,
+    ReplaceCollection,
+    ReplaceScalar,
+    ReplaceText,
+    place,
+)
+from troupe.writeback.scalars import QuoteStyle, render_scalar, render_string
+
+_QUOTE_STYLES: dict[str, QuoteStyle] = {"plain": "plain", "single": "single", "double": "double"}
+
+
+@dataclass(frozen=True)
+class WritePlan:
+    """The verified result of a ``set`` (data-model "Write plan").
+
+    Attributes:
+        files: The complete new text of every file that changes; empty for a no-op.
+        tree: The configuration re-loaded from the new texts (the tree as it will be on disk once
+            ``files`` are written); ``None`` for a no-op.
+    """
+
+    files: dict[SourceFile, str]
+    tree: Node | None
+
+
+def apply_set(
+    root: Node, segments: list[str], dotted: str, value: Value, raw_value: str
+) -> WritePlan:
+    """Plan ``set dotted VALUE`` on the configuration ``root`` loaded from disk.
+
+    Args:
+        root: The configuration as loaded (its origin file is the root configuration file).
+        segments: The parsed PATH.
+        dotted: PATH as the user wrote it, for messages.
+        value: The parsed VALUE.
+        raw_value: The VALUE argument exactly as typed (text includes, research R-16).
+
+    Returns:
+        The new file texts and the re-loaded tree, verified; no files for a no-op.
+
+    Raises:
+        WriteRefused: Exit 3; nothing may be written (include replacement, CRLF text include with
+            a non-string VALUE, a renderer refusal, or a failed verification).
+        PathError: Exit 5 (see ``placement.place``).
+    """
+    placement = place(root, segments, dotted)
+    if isinstance(placement, ReplaceText):
+        return _plan_text(root, segments, dotted, placement.node, value, raw_value)
+    if isinstance(placement, ReplaceScalar | ReplaceCollection) and _matches(placement.node, value):
+        return WritePlan({}, None)
+    file, edits = _edits(placement, dotted, value)
+    new_text = apply_edits(file.text, edits)
+    if new_text == file.text:
+        _refuse(dotted)
+    files = {file: new_text}
+    tree = _verify(root, segments, dotted, files, lambda node: _matches(node, value))
+    return WritePlan(files, tree)
+
+
+# --- Text includes (R-16) -----------------------------------------------------------------------
+
+
+def _plan_text(
+    root: Node,
+    segments: list[str],
+    dotted: str,
+    node: TextInclude,
+    value: Value,
+    raw_value: str,
+) -> WritePlan:
+    target = node.target
+    if uses_crlf(target.text):
+        if not isinstance(value, str):
+            raise WriteRefused(
+                f"{dotted}: text include {target.path} uses CRLF line endings, so VALUE must be"
+                " a string; no file changed"
+            )
+        content = to_crlf(value)
+    else:
+        content = value if isinstance(value, str) else raw_value
+    if content == target.text:
+        return WritePlan({}, None)
+    files = {target: content}
+
+    def reads_back(new: Node) -> bool:
+        return isinstance(new, TextInclude) and new.target.text == content
+
+    return WritePlan(files, _verify(root, segments, dotted, files, reads_back))
+
+
+# --- Rendering ----------------------------------------------------------------------------------
+
+
+def _edits(placement: Placement, dotted: str, value: Value) -> tuple[SourceFile, list[TextEdit]]:
+    """Return the file the change goes into and its edits."""
+    if isinstance(placement, AddKeys):
+        file = placement.mapping.origin.file
+        step = detect_indent(file.text)
+        return file, new_key_edits(
+            file, placement.mapping, placement.keys, value, step, path=dotted
+        )
+    if isinstance(placement, AppendItem):
+        file = placement.sequence.origin.file
+        step = detect_indent(file.text)
+        return file, new_item_edits(file, placement.sequence, value, step, path=dotted)
+    if isinstance(placement, ReplaceCollection):
+        file = placement.node.origin.file
+        step = detect_indent(file.text)
+        edits = replace_value_edits(
+            file, placement.parent, placement.slot, placement.node, value, step, path=dotted
+        )
+        return file, edits
+    if isinstance(placement, ReplaceScalar):
+        return placement.node.origin.file, _scalar_edits(placement, dotted, value)
+    raise AssertionError(f"unexpected placement {placement!r}")  # ReplaceText is handled earlier
+
+
+def _scalar_edits(placement: ReplaceScalar, dotted: str, value: Value) -> list[TextEdit]:
+    node = placement.node
+    file = node.origin.file
+    text = file.text
+    step = detect_indent(text)
+    start, end = node.origin.start, node.origin.end
+    is_block = node.style in ("literal", "folded")
+    kind_change = isinstance(value, dict | list) or start == end
+    if kind_change or (is_block and not (isinstance(value, str) and can_block(value))):
+        return replace_value_edits(
+            file, placement.parent, placement.slot, node, value, step, path=dotted
+        )
+    parent_indent = entry_column(text, placement.parent)
+    newline = detect_newline(text)
+    if is_block:
+        assert isinstance(value, str)
+        block = parse_block(text, start, parent_indent, step)
+        return replace_block(block, text, value, newline, dotted)
+    if isinstance(value, str) and "\n" in value:
+        if placement.context == "flow" or can_block(value):
+            return replace_with_multiline(
+                text,
+                start,
+                end,
+                value,
+                context=placement.context,
+                parent_indent=parent_indent,
+                path=dotted,
+                indent_step=step,
+                newline=newline,
+            )
+        return [_replace_span(text, start, end, render_string(value, "double"))]
+    assert not isinstance(value, dict | list)
+    rendered = render_scalar(value, _QUOTE_STYLES.get(node.style), placement.context)
+    return [_replace_span(text, start, end, rendered)]
+
+
+def _replace_span(text: str, start: int, end: int, new_text: str) -> TextEdit:
+    """Replace ``text[start:end]``; the comment on the line where the span ends keeps its column.
+
+    The span may cover several lines (a multi-line plain or quoted scalar); they become one.
+    """
+    first = text.rfind("\n", 0, start) + 1
+    last = text.rfind("\n", 0, end) + 1
+    line_end = text.find("\n", end)
+    line_end = len(text) if line_end < 0 else line_end
+    if line_end > last and text[line_end - 1] == "\r":
+        line_end -= 1
+    new_line = replace_in_line(text[last:line_end], 0, end - last, text[first:start] + new_text)
+    return TextEdit(first, line_end, new_line)
+
+
+# --- Comparison and verification (R-17) ---------------------------------------------------------
+
+
+def _matches(node: Node, value: Value) -> bool:
+    """Whether ``node`` holds ``value`` as written: deep, type-aware, key order ignored.
+
+    An include node holds the include string it was written as (``file:...``), so writing that
+    string again is recognised as unchanged.
+    """
+    if isinstance(node, ScalarNode):
+        return not isinstance(value, dict | list) and same(node.value, value)
+    if isinstance(node, YamlInclude | TextInclude):
+        written = _include_string(node)
+        return isinstance(value, str) and written is not None and written == value
+    if isinstance(node, MappingNode):
+        if not isinstance(value, dict) or len(value) != len(node.entries):
+            return False
+        return all(
+            entry.key in value and _matches(entry.value, value[entry.key]) for entry in node.entries
+        )
+    if not isinstance(value, list) or len(value) != len(node.items):
+        return False
+    return all(
+        _matches(item, item_value) for item, item_value in zip(node.items, value, strict=True)
+    )
+
+
+def _include_string(node: YamlInclude | TextInclude) -> str | None:
+    """The string an include node was written as (``file:...``), or ``None`` if unreadable."""
+    try:
+        raw = yamlcore.compose(node.origin.source, "<include string>")
+    except LoadError:
+        return None
+    return raw.text if isinstance(raw, yamlcore.RawScalar) else None
+
+
+def _verify(
+    root: Node,
+    segments: list[str],
+    dotted: str,
+    files: Mapping[SourceFile, str],
+    reads_back: Callable[[Node], bool],
+) -> Node:
+    """Re-load the configuration from the new texts and check the change is exactly the one asked.
+
+    Returns:
+        The re-loaded tree.
+
+    Raises:
+        WriteRefused: If the new texts do not load, the value at PATH does not read back, or
+            anything outside PATH differs.
+    """
+    config_file = root.origin.file.path
+    overrides: dict[Path, str] = {file.path: text for file, text in files.items()}
+    try:
+        new_root = load(config_file, overrides=overrides)
+        found = walk(new_root, segments)
+    except (LoadError, PathError):
+        _refuse(dotted)
+    if found.remaining or not reads_back(found.nodes[-1]):
+        _refuse(dotted)
+    if not _same_outside(root, new_root, [], segments):
+        _refuse(dotted)
+    return new_root
+
+
+def _refuse(dotted: str) -> NoReturn:
+    raise WriteRefused(f"{dotted}: cannot write this change byte-surgically; no file changed")
+
+
+def _same_outside(old: Node, new: Node, here: list[str], target: list[str]) -> bool:
+    """Whether ``old`` and ``new`` are identical except at ``target`` and below.
+
+    Kinds, flow flags, keys and their order, scalar values (type-aware) and styles, and include
+    targets must all be equal. On the way to ``target`` a mapping may gain the key and a list the
+    item that the ``set`` adds.
+    """
+    if here == target:
+        return True
+    on_route = here == target[: len(here)]
+    if isinstance(old, ScalarNode):
+        return isinstance(new, ScalarNode) and new.style == old.style and same(old.value, new.value)
+    if isinstance(old, TextInclude):
+        return (
+            isinstance(new, TextInclude)
+            and new.target.path == old.target.path
+            and new.target.text == old.target.text
+        )
+    if isinstance(old, YamlInclude):
+        return (
+            isinstance(new, YamlInclude)
+            and new.target.path == old.target.path
+            and _same_outside(old.root, new.root, here, target)
+        )
+    if isinstance(old, MappingNode):
+        if not isinstance(new, MappingNode) or new.flow != old.flow:
+            return False
+        old_keys = [entry.key for entry in old.entries]
+        new_keys = [entry.key for entry in new.entries]
+        if new_keys != old_keys:
+            added = target[len(here)] if on_route else None
+            if added is None or added in old_keys or new_keys != [*old_keys, added]:
+                return False
+        return all(
+            _same_outside(entry.value, new.entries[index].value, [*here, entry.key], target)
+            for index, entry in enumerate(old.entries)
+        )
+    if not isinstance(new, SequenceNode) or new.flow != old.flow:
+        return False
+    if len(new.items) != len(old.items):
+        appended = on_route and target[len(here)] == str(len(old.items))
+        if not appended or len(new.items) != len(old.items) + 1:
+            return False
+    return all(
+        _same_outside(item, new.items[index], [*here, str(index)], target)
+        for index, item in enumerate(old.items)
+    )
