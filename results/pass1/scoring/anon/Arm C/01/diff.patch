+++ b/tests/unit/test_history_store.py
@@ -0,0 +1,141 @@
+"""HistoryStore against the real eventsourcing library and a real SQLite file."""
+
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+
+from troupe.history import HISTORY_DB_NAME, HistoryRecord, HistoryStore
+from troupe.leaves import Change, JsonScalar
+
+
+@pytest.fixture
+def state_dir(tmp_path: Path) -> Path:
+    directory = tmp_path / ".troupe"
+    directory.mkdir()
+    return directory
+
+
+@pytest.fixture
+def store(state_dir: Path) -> Iterator[HistoryStore]:
+    opened = HistoryStore(state_dir)
+    yield opened
+    opened.close()
+
+
+def _reopened(state_dir: Path) -> list[HistoryRecord]:
+    fresh = HistoryStore(state_dir)
+    try:
+        return fresh.records()
+    finally:
+        fresh.close()
+
+
+def test_new_store_is_not_imported_and_has_no_records(store: HistoryStore) -> None:
+    assert not store.is_imported()
+    assert store.records() == []
+
+
+def test_store_persists_in_history_sqlite_in_the_state_dir(
+    store: HistoryStore, state_dir: Path
+) -> None:
+    store.import_leaves({"a": 1})
+
+    assert (state_dir / HISTORY_DB_NAME).is_file()
+    assert {p.name for p in state_dir.iterdir()} <= {
+        HISTORY_DB_NAME,
+        f"{HISTORY_DB_NAME}-wal",
+        f"{HISTORY_DB_NAME}-shm",
+        f"{HISTORY_DB_NAME}-journal",
+    }
+
+
+def test_import_is_read_back_by_a_new_store_instance_with_seq_from_one(
+    store: HistoryStore, state_dir: Path
+) -> None:
+    store.import_leaves({"model.name": "gpt", "tools.0": "search", "retries": 3})
+    store.close()
+
+    assert _reopened(state_dir) == [
+        HistoryRecord(1, "import", "model.name", None, "gpt"),
+        HistoryRecord(2, "import", "tools.0", None, "search"),
+        HistoryRecord(3, "import", "retries", None, 3),
+    ]
+
+
+def test_import_of_no_leaves_still_marks_theatre_imported(
+    store: HistoryStore, state_dir: Path
+) -> None:
+    store.import_leaves({})
+    store.close()
+
+    reopened = HistoryStore(state_dir)
+    try:
+        assert reopened.is_imported()
+        assert reopened.records() == []
+    finally:
+        reopened.close()
+
+
+def test_record_appends_after_import_with_continuing_seq(
+    store: HistoryStore, state_dir: Path
+) -> None:
+    store.import_leaves({"a": 1, "b": 2})
+    store.record([Change("set", "a", 1, 5), Change("remove", "b", 2, None)])
+    store.record([Change("set", "c", None, "new")])
+    store.close()
+
+    assert _reopened(state_dir) == [
+        HistoryRecord(1, "import", "a", None, 1),
+        HistoryRecord(2, "import", "b", None, 2),
+        HistoryRecord(3, "set", "a", 1, 5),
+        HistoryRecord(4, "remove", "b", 2, None),
+        HistoryRecord(5, "set", "c", None, "new"),
+    ]
+
+
+def test_record_of_no_changes_appends_nothing(store: HistoryStore) -> None:
+    store.import_leaves({"a": 1})
+    store.record([])
+
+    assert store.records() == [HistoryRecord(1, "import", "a", None, 1)]
+
+
+def test_values_keep_their_json_types_through_the_store(
+    store: HistoryStore, state_dir: Path
+) -> None:
+    values: dict[str, JsonScalar] = {
+        "bool": True,
+        "false": False,
+        "float": 1.0,
+        "int": 1,
+        "null": None,
+        "str": "1",
+    }
+    store.import_leaves(values)
+    store.record([Change("set", "bool", True, 0.5)])
+    store.close()
+
+    records = _reopened(state_dir)
+
+    read_back = {r.path: r.new for r in records if r.op == "import"}
+    assert [(type(v), v) for v in read_back.values()] == [(type(v), v) for v in values.values()]
+    assert (type(records[-1].old), type(records[-1].new)) == (bool, float)
+
+
+def test_environment_variables_cannot_redirect_the_store(
+    state_dir: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setenv("PERSISTENCE_MODULE", "eventsourcing.popo")
+    monkeypatch.setenv("SQLITE_DBNAME", str(state_dir / "elsewhere.sqlite"))
+    monkeypatch.setenv("_HISTORYAPPLICATION_SQLITE_DBNAME", str(state_dir / "other.sqlite"))
+
+    opened = HistoryStore(state_dir)
+    try:
+        opened.import_leaves({"a": 1})
+    finally:
+        opened.close()
+
+    assert {p.name for p in state_dir.iterdir() if not p.name.endswith(("-wal", "-shm"))} == {
+        HISTORY_DB_NAME
+    }
diff --git a/tests/unit/test_leaves.py b/tests/unit/test_leaves.py
new file mode 100644
index 0000000..dd7e53c
--- /dev/null
+++ b/tests/unit/test_leaves.py
@@ -0,0 +1,134 @@
+"""Leaves of the merged configuration (flatten) and leaf-level differences (diff, same)."""
+
+import pytest
+
+from conftest import MakeTheatre
+from troupe.leaves import Change, JsonScalar, diff, flatten, same
+from troupe.loader import load
+from troupe.theatre import locate
+
+
+def _leaves(make_theatre: MakeTheatre, files: dict[str, str | bytes]) -> dict[str, JsonScalar]:
+    return flatten(load(locate(make_theatre(files)).config_file))
+
+
+def test_flatten_lists_nested_mapping_and_list_leaves_in_document_order(
+    make_theatre: MakeTheatre,
+) -> None:
+    leaves = _leaves(
+        make_theatre,
+        {
+            "troupe.yml": (
+                "model:\n  name: gpt\n  temperature: 0.2\n"
+                "tools: [search, 3, true, null]\n"
+                "retries: 1\n"
+            )
+        },
+    )
+
+    assert list(leaves.items()) == [
+        ("model.name", "gpt"),
+        ("model.temperature", 0.2),
+        ("tools.0", "search"),
+        ("tools.1", 3),
+        ("tools.2", True),
+        ("tools.3", None),
+        ("retries", 1),
+    ]
+
+
+def test_flatten_puts_yaml_include_leaves_at_merged_paths(make_theatre: MakeTheatre) -> None:
+    leaves = _leaves(
+        make_theatre,
+        {
+            "troupe.yml": "agents:\n  coder: file:agents/coder.yaml\nafter: x\n",
+            "agents/coder.yaml": "name: Cody\nskills:\n  - python\n",
+        },
+    )
+
+    assert list(leaves.items()) == [
+        ("agents.coder.name", "Cody"),
+        ("agents.coder.skills.0", "python"),
+        ("after", "x"),
+    ]
+
+
+def test_flatten_makes_text_include_one_leaf_holding_the_file_text(
+    make_theatre: MakeTheatre,
+) -> None:
+    leaves = _leaves(
+        make_theatre,
+        {"troupe.yml": "prompt: file:prompt.md\n", "prompt.md": "Be kind.\r\nBe brief.\r\n"},
+    )
+
+    assert leaves == {"prompt": "Be kind.\r\nBe brief.\r\n"}
+
+
+def test_flatten_gives_no_leaves_for_empty_collections(make_theatre: MakeTheatre) -> None:
+    leaves = _leaves(make_theatre, {"troupe.yml": "a: {}\nb: []\nc: 1\n"})
+
+    assert leaves == {"c": 1}
+
+
+def test_flatten_of_empty_document_is_empty(make_theatre: MakeTheatre) -> None:
+    assert _leaves(make_theatre, {"troupe.yml": ""}) == {}
+
+
+@pytest.mark.parametrize(
+    ("a", "b"),
+    [(1, 1.0), (1, "1"), (True, 1), (False, 0), (None, ""), (0.0, False)],
+)
+def test_same_distinguishes_values_of_different_types(a: JsonScalar, b: JsonScalar) -> None:
+    assert not same(a, b)
+    assert not same(b, a)
+
+
+@pytest.mark.parametrize("value", [1, 1.5, "x", True, None, float("nan"), float("inf")])
+def test_same_holds_for_equal_values_including_nan(value: JsonScalar) -> None:
+    assert same(value, value)
+
+
+def test_diff_of_identical_leaves_is_empty() -> None:
+    leaves: dict[str, JsonScalar] = {"a": 1, "b.0": "x", "c": None}
+
+    assert diff(leaves, dict(leaves)) == []
+
+
+def test_diff_reports_changed_leaf_as_set_with_old_and_new() -> None:
+    assert diff({"a": 1, "b": 2}, {"a": 1, "b": 3}) == [Change("set", "b", 2, 3)]
+
+
+def test_diff_reports_created_leaf_as_set_with_null_old() -> None:
+    assert diff({"a": 1}, {"a": 1, "b": "new"}) == [Change("set", "b", None, "new")]
+
+
+def test_diff_reports_created_null_leaf_as_set() -> None:
+    assert diff({}, {"a": None}) == [Change("set", "a", None, None)]
+
+
+def test_diff_reports_vanished_leaf_as_remove_with_null_new() -> None:
+    assert diff({"a": 1, "b": None}, {"a": 1}) == [Change("remove", "b", None, None)]
+
+
+def test_diff_reports_list_shrink_as_remove_of_the_last_index() -> None:
+    before: dict[str, JsonScalar] = {"tools.0": "a", "tools.1": "b"}
+
+    assert diff(before, {"tools.0": "a"}) == [Change("remove", "tools.1", "b", None)]
+
+
+def test_diff_reports_type_change_as_set() -> None:
+    assert diff({"a": 1}, {"a": "1"}) == [Change("set", "a", 1, "1")]
+
+
+def test_diff_lists_sets_in_after_order_then_removes_in_before_order() -> None:
+    before: dict[str, JsonScalar] = {"x": 1, "y": 2, "z": 3, "w": 4}
+    after: dict[str, JsonScalar] = {"n": 0, "y": 20, "m": 5}
+
+    assert diff(before, after) == [
+        Change("set", "n", None, 0),
+        Change("set", "y", 2, 20),
+        Change("set", "m", None, 5),
+        Change("remove", "x", 1, None),
+        Change("remove", "z", 3, None),
+        Change("remove", "w", 4, None),
+    ]
