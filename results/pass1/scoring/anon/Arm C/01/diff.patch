index 0000000..2e9dd25
--- /dev/null
+++ b/src/troupe/writeback/scalars.py
@@ -0,0 +1,183 @@
+"""Scalar quoting: representability, style choice and rendering (FR-015, research R-10).
+
+Contract (FR-015): a changed scalar keeps its quoting style if that style can represent the new
+value; otherwise plain if possible, else single-quoted, else double-quoted. A new key or new string
+value copies the preceding sibling's style; with no sibling, plain or the minimal quoting the text
+needs. Callers express both rules through ``preferred`` (the current or sibling style, or
+``None``). A double-quoted scalar escapes only ``\\``, ``"`` and control characters; everything else
+is written literally. Non-string values are always written plain in their YAML 1.2 core canonical
+form, because quoting them would turn them into strings.
+"""
+
+import math
+from typing import Literal
+
+from troupe import yamlcore
+from troupe.errors import LoadError
+from troupe.tree import Scalar
+from troupe.yamlcore import RawMapping, RawScalar, RawSequence
+
+Context = Literal["block", "flow"]
+QuoteStyle = Literal["plain", "single", "double"]
+
+_STYLE_ORDER: tuple[QuoteStyle, ...] = ("plain", "single", "double")
+# Characters that always start something other than a plain scalar.
+_PLAIN_FIRST_FORBIDDEN = frozenset(",[]{}#&*!|>'\"%@`")
+# Indicators that may start a plain scalar only when followed by a non-space character ("-v").
+_PLAIN_FIRST_IF_FOLLOWED = frozenset("-?:")
+# YAML-printable characters this module still never writes literally outside double quotes:
+# U+0085/U+2028/U+2029 (ruamel's scanner treats them as line breaks) and U+FEFF (byte order mark).
+_LITERAL_REFUSED = frozenset("\x85\u2028\u2029\ufeff")
+_FLOW_INDICATORS = frozenset(",[]{}")
+_DOCUMENT_MARKERS = ("---", "...")
+_DOUBLE_ESCAPES = {
+    "\\": "\\\\",
+    '"': '\\"',
+    "\0": "\\0",
+    "\a": "\\a",
+    "\b": "\\b",
+    "\t": "\\t",
+    "\n": "\\n",
+    "\v": "\\v",
+    "\f": "\\f",
+    "\r": "\\r",
+    "\x1b": "\\e",
+    "\x85": "\\N",
+    "\u2028": "\\L",
+    "\u2029": "\\P",
+}
+
+
+def can_plain(s: str, context: Context) -> bool:
+    """Return whether ``s`` can be written as a plain scalar and read back as the same string.
+
+    Conservative syntactic rules come first; then the text must resolve to a string under the
+    YAML 1.2 core schema (so ``true``, ``0.2``, ``null`` are refused) and composing it in its
+    context must yield a plain scalar with exactly this text.
+    """
+    if not s or s[0].isspace() or s[-1].isspace() or "\t" in s or not can_single(s):
+        # Conservative: no leading/trailing whitespace of any kind (NBSP, U+3000 included), no tab.
+        return False
+    if s[0] in _PLAIN_FIRST_FORBIDDEN or s.startswith(_DOCUMENT_MARKERS):
+        return False
+    if s[0] in _PLAIN_FIRST_IF_FOLLOWED and (len(s) == 1 or s[1] == " "):
+        return False
+    if ": " in s or " #" in s or s.endswith(":"):
+        return False
+    if context == "flow" and any(ch in _FLOW_INDICATORS for ch in s):
+        return False
+    resolved = yamlcore.resolve_plain(s)
+    if not isinstance(resolved, str) or resolved != s:
+        return False
+    return _round_trips_plain(s, context)
+
+
+def can_single(s: str) -> bool:
+    """Return whether ``s`` can be single-quoted: no line breaks, nothing that needs escaping.
+
+    Accepts tab and every YAML 1.2 ``c-printable`` character except line breaks and the
+    characters in ``_LITERAL_REFUSED``.
+    """
+    return all(ch == "\t" or _is_printable_non_break(ch) for ch in s)
+
+
+def choose_style(s: str, preferred: QuoteStyle | None, context: Context) -> QuoteStyle:
+    """Return ``preferred`` if it can represent ``s``, else the first of plain, single, double.
+
+    Args:
+        s: The string to write.
+        preferred: The scalar's current style (changed value), the preceding sibling's style (new
+            key or value), or ``None`` (no sibling).
+        context: Whether the scalar sits in a block collection or inside ``[...]``/``{...}``.
+    """
+    if preferred is not None and _can_represent(s, preferred, context):
+        return preferred
+    return next(style for style in _STYLE_ORDER if _can_represent(s, style, context))
+
+
+def render_string(s: str, style: QuoteStyle) -> str:
+    """Render ``s`` in ``style``; the caller has checked that the style can represent it."""
+    if style == "plain":
+        return s
+    if style == "single":
+        return "'" + s.replace("'", "''") + "'"
+    return '"' + "".join(_escape_double(ch) for ch in s) + '"'
+
+
+def render_nonstring(v: int | float | bool | None) -> str:
+    """Render a non-string scalar as its plain YAML 1.2 core canonical text (research R-10).
+
+    Raises:
+        ValueError: If the text would not read back as ``v`` (cannot happen for Python floats;
+            guards the rendering rule).
+    """
+    if v is None:
+        return "null"
+    if isinstance(v, bool):
+        return "true" if v else "false"
+    if isinstance(v, int):
+        return str(v)
+    if math.isnan(v):
+        return ".nan"
+    if math.isinf(v):
+        return ".inf" if v > 0 else "-.inf"
+    text = repr(v)
+    if yamlcore.resolve_plain(text) != v:
+        raise ValueError(f"float {v!r} has no plain YAML 1.2 core rendering")
+    return text
+
+
+def render_scalar(v: Scalar, preferred: QuoteStyle | None, context: Context) -> str:
+    """Render any scalar: strings in the chosen quoting style, everything else plain."""
+    if isinstance(v, str):
+        return render_string(v, choose_style(v, preferred, context))
+    return render_nonstring(v)
+
+
+def _can_represent(s: str, style: QuoteStyle, context: Context) -> bool:
+    if style == "plain":
+        return can_plain(s, context)
+    if style == "single":
+        return can_single(s)
+    return True
+
+
+def _round_trips_plain(s: str, context: Context) -> bool:
+    document = f"k: {s}\n" if context == "block" else f"[{s}]\n"
+    try:
+        root = yamlcore.compose(document, "<scalar check>")
+    except LoadError:
+        return False
+    if isinstance(root, RawMapping) and len(root.pairs) == 1:
+        scalar = root.pairs[0][1]
+    elif isinstance(root, RawSequence) and len(root.items) == 1:
+        scalar = root.items[0]
+    else:
+        return False
+    return isinstance(scalar, RawScalar) and scalar.style == "plain" and scalar.text == s
+
+
+def _is_printable_non_break(ch: str) -> bool:
+    """YAML 1.2 ``c-printable`` minus tab, line breaks and ``_LITERAL_REFUSED``."""
+    code = ord(ch)
+    if ch in _LITERAL_REFUSED:
+        return False
+    return (
+        0x20 <= code <= 0x7E
+        or 0xA0 <= code <= 0xD7FF
+        or 0xE000 <= code <= 0xFFFD
+        or 0x10000 <= code <= 0x10FFFF
+    )
+
+
+def _escape_double(ch: str) -> str:
+    named = _DOUBLE_ESCAPES.get(ch)
+    if named is not None:
+        return named
+    code = ord(ch)
+    if code < 0x20 or 0x7F <= code <= 0x9F:
+        return f"\\x{code:02x}"
+    if 0xD800 <= code <= 0xDFFF or code in (0xFFFE, 0xFFFF):
+        # Not YAML-printable at all; writing it literally would make the file unreadable.
+        return f"\\u{code:04x}"
+    return ch
diff --git a/src/troupe/yamlcore.py b/src/troupe/yamlcore.py
new file mode 100644
index 0000000..2b5968e
--- /dev/null
+++ b/src/troupe/yamlcore.py
@@ -0,0 +1,161 @@
+"""The one place that knows the YAML library (ruamel.yaml) and the YAML 1.2 core schema.
+
+No other module imports ``ruamel``: ``compose`` turns ruamel's node graph into the small typed
+``Raw*`` dataclasses below, and ``resolve_plain`` resolves plain scalars ourselves, because
+ruamel's own resolver is not the YAML 1.2 core schema (research R-13).
+
+Span behaviour (ruamel 0.19, verified by ``tests/unit/test_yamlcore.py``). ``start``/``end`` are
+code-point indices into the composed string; a leading BOM is index 0 and CRLF counts as two.
+Spans are recorded exactly as ruamel reports them; consumers that need precise ends of block
+nodes must derive them from the text:
+
+- Plain scalars: the span covers the scalar text only; trailing spaces and comments are excluded.
+  A multi-line plain scalar's span covers all its lines.
+- Quoted scalars: the span includes the quotes.
+- Block scalars (``|``, ``>``): the span starts at the indicator and ends after the content
+  *including* the trailing line breaks the scalar consumes (e.g. blank lines kept by ``|+`` or
+  stripped by clip/``-``); comment lines after the content are not included.
+- Empty (null) values are zero-width spans whose position is unreliable: ``a:`` followed by a
+  newline yields the start of the *next* line, ``- `` yields the column after the dash, and a
+  value at end of file yields ``len(text)``.
+- Block collections: ``start`` is the first key/dash; ``end`` is the start of the next token
+  after the collection, so it usually lies past trailing blank lines *and comment lines* (at the
+  start of the next sibling's line, or at end of file).
+- Flow collections: the span is exactly ``[...]`` / ``{...}``.
+- Anchors and tags would be inside a node's span; they are rejected here (out of contract, C-004).
+"""
+
+import math
+import re
+from dataclasses import dataclass
+from typing import Any
+
+from ruamel.yaml import YAML
+from ruamel.yaml.error import MarkedYAMLError, YAMLError
+from ruamel.yaml.nodes import MappingNode, Node, ScalarNode, SequenceNode
+
+from troupe.errors import LoadError
+from troupe.tree import Scalar, ScalarStyle
+
+_STYLES: dict[str | None, ScalarStyle] = {
+    None: "plain",
+    "'": "single",
+    '"': "double",
+    "|": "literal",
+    ">": "folded",
+}
+
+# YAML 1.2 core schema (https://yaml.org/spec/1.2.2/#1023-core-schema), research R-13.
+_NULL = re.compile(r"null|Null|NULL|~|")
+_TRUE = re.compile(r"true|True|TRUE")
+_FALSE = re.compile(r"false|False|FALSE")
+_INT_DEC = re.compile(r"[-+]?[0-9]+")
+_INT_OCT = re.compile(r"0o[0-7]+")
+_INT_HEX = re.compile(r"0x[0-9a-fA-F]+")
+_FLOAT = re.compile(r"[-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?")
+_INF = re.compile(r"[-+]?\.(inf|Inf|INF)")
+_NAN = re.compile(r"\.(nan|NaN|NAN)")
+
+
+@dataclass(frozen=True)
+class RawScalar:
+    """A composed scalar: ``text`` is the unescaped/folded content, not yet resolved."""
+
+    text: str
+    style: ScalarStyle
+    start: int
+    end: int
+
+
+@dataclass(frozen=True)
+class RawMapping:
+    """A composed mapping; ``pairs`` are (key, value) in document order."""
+
+    pairs: list[tuple["RawNode", "RawNode"]]
+    flow: bool
+    start: int
+    end: int
+
+
+@dataclass(frozen=True)
+class RawSequence:
+    """A composed sequence."""
+
+    items: list["RawNode"]
+    flow: bool
+    start: int
+    end: int
+
+
+RawNode = RawScalar | RawMapping | RawSequence
+
+
+def resolve_plain(text: str) -> Scalar:
+    """Resolve a plain scalar's text per the YAML 1.2 core schema; anything else is a string.
+
+    Only for plain scalars: quoted and block scalars are always strings.
+    """
+    if _NULL.fullmatch(text):
+        return None
+    if _TRUE.fullmatch(text):
+        return True
+    if _FALSE.fullmatch(text):
+        return False
+    if _INT_DEC.fullmatch(text):
+        return int(text, 10)
+    if _INT_OCT.fullmatch(text):
+        return int(text[2:], 8)
+    if _INT_HEX.fullmatch(text):
+        return int(text[2:], 16)
+    if _FLOAT.fullmatch(text):
+        return float(text)
+    if _INF.fullmatch(text):
+        return -math.inf if text.startswith("-") else math.inf
+    if _NAN.fullmatch(text):
+        return math.nan
+    return text
+
+
+def compose(text: str, source: str) -> RawNode | None:
+    """Compose ``text`` (one YAML document) into raw nodes; ``None`` for an empty document.
+
+    Args:
+        text: The document text (as decoded from the file, BOM included).
+        source: The file name used in error messages.
+
+    Raises:
+        LoadError: If the text is not a single valid YAML document, or uses anchors, aliases or
+            tags (out of contract).
+    """
+    try:
+        node: Node | None = YAML(typ="safe", pure=True).compose(text)
+    except MarkedYAMLError as err:
+        raise LoadError(f"cannot parse {source}: {_describe(err)}") from err
+    except YAMLError as err:
+        first_line = str(err).splitlines()[0] if str(err) else type(err).__name__
+        raise LoadError(f"cannot parse {source}: {first_line}") from err
+    return None if node is None else _convert(node, text, source)
+
+
+def _describe(err: MarkedYAMLError) -> str:
+    problem = err.problem or err.context or "invalid YAML"
+    mark = err.problem_mark or err.context_mark
+    return f"{problem} at line {mark.line + 1}" if mark is not None else str(problem)
+
+
+def _convert(node: Node, text: str, source: str) -> RawNode:
+    start: int = node.start_mark.index
+    end: int = node.end_mark.index
+    if end > start and text[start] in "&!":  # node content never starts so
+        line = text.count("\n", 0, start) + 1
+        raise LoadError(f"cannot parse {source}: anchors and tags are not supported at line {line}")
+    if isinstance(node, ScalarNode):
+        value: Any = node.value
+        return RawScalar(text=str(value), style=_STYLES[node.style], start=start, end=end)
+    if isinstance(node, MappingNode):
+        pairs = [(_convert(k, text, source), _convert(v, text, source)) for k, v in node.value]
+        return RawMapping(pairs=pairs, flow=bool(node.flow_style), start=start, end=end)
+    if isinstance(node, SequenceNode):
+        items = [_convert(item, text, source) for item in node.value]
+        return RawSequence(items=items, flow=bool(node.flow_style), start=start, end=end)
+    raise LoadError(f"cannot parse {source}: unsupported node {type(node).__name__}")
