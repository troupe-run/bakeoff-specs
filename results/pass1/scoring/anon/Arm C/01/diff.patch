@@ -0,0 +1,417 @@
+"""Loading real theatre files into the SourceTree: values, spans, includes, errors (FR-007/008)."""
+
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+
+from conftest import MakeTheatre
+from troupe.errors import LoadError
+from troupe.loader import load, read_source
+from troupe.paths import lookup, unwrap
+from troupe.theatre import locate
+from troupe.tree import (
+    MappingNode,
+    Node,
+    Origin,
+    ScalarNode,
+    SequenceNode,
+    TextInclude,
+    YamlInclude,
+)
+
+
+def _load(make_theatre: MakeTheatre, files: dict[str, str | bytes]) -> Node:
+    return load(locate(make_theatre(files)).config_file)
+
+
+def _at(root: Node, dotted: str) -> Node:
+    return unwrap(lookup(root, dotted.split("."), dotted))
+
+
+def _scalar(root: Node, dotted: str) -> ScalarNode:
+    node = _at(root, dotted)
+    assert isinstance(node, ScalarNode)
+    return node
+
+
+def _origins(node: Node) -> Iterator[Origin]:
+    """Every key and scalar/include origin in document order, following YAML includes."""
+    if isinstance(node, MappingNode):
+        for entry in node.entries:
+            yield entry.key_origin
+            yield from _origins(entry.value)
+    elif isinstance(node, SequenceNode):
+        for item in node.items:
+            yield from _origins(item)
+    elif isinstance(node, YamlInclude):
+        yield node.origin
+        yield from _origins(node.root)
+    else:
+        yield node.origin
+
+
+def _sources(root: Node) -> list[tuple[str, str]]:
+    return [(o.file.path.name, o.file.text[o.start : o.end]) for o in _origins(root)]
+
+
+NESTED = (
+    "# troupe\n"
+    "model:\n"
+    '  name: "gpt"   # quoted\n'
+    "  temperature: 0.2\n"
+    "  stop: ~\n"
+    "  enabled: yes\n"
+    "tools:\n"
+    "  - grep\n"
+    "  - {name: sed, args: ['-n', 1]}\n"
+    "notes: |\n"
+    "  line one\n"
+    "  line two\n"
+    "'quoted key': 0x1F\n"
+)
+
+
+def test_nested_mappings_and_lists_load_with_values_and_styles(make_theatre: MakeTheatre) -> None:
+    root = _load(make_theatre, {"troupe.yml": NESTED})
+
+    found = [
+        (dotted, _scalar(root, dotted).value, _scalar(root, dotted).style)
+        for dotted in (
+            "model.name",
+            "model.temperature",
+            "model.stop",
+            "model.enabled",
+            "tools.0",
+            "tools.1.name",
+            "tools.1.args.0",
+            "tools.1.args.1",
+            "notes",
+            "quoted key",
+        )
+    ]
+
+    assert found == [
+        ("model.name", "gpt", "double"),
+        ("model.temperature", 0.2, "plain"),
+        ("model.stop", None, "plain"),
+        ("model.enabled", "yes", "plain"),
+        ("tools.0", "grep", "plain"),
+        ("tools.1.name", "sed", "plain"),
+        ("tools.1.args.0", "-n", "single"),
+        ("tools.1.args.1", 1, "plain"),
+        ("notes", "line one\nline two\n", "literal"),
+        ("quoted key", 31, "plain"),
+    ]
+    flow = _at(root, "tools.1")
+    assert isinstance(flow, MappingNode)
+    assert flow.flow
+    assert isinstance(root, MappingNode)
+    assert root.get("quoted key") is not None
+    assert root.entries[-1].key_style == "single"
+
+
+def test_every_origin_slice_reproduces_its_source_text(make_theatre: MakeTheatre) -> None:
+    root = _load(make_theatre, {"troupe.yml": NESTED})
+
+    assert _sources(root) == [
+        ("troupe.yml", text)
+        for text in [
+            "model", "name", '"gpt"', "temperature", "0.2", "stop", "~", "enabled", "yes",
+            "tools", "grep", "name", "sed", "args", "'-n'", "1",
+            "notes", "|\n  line one\n  line two\n",
+            "'quoted key'", "0x1F",
+        ]
+    ]  # fmt: skip
+
+
+def test_bom_and_crlf_are_kept_in_text_and_spans_align(make_theatre: MakeTheatre) -> None:
+    raw = "\ufeffa: 'one'\r\nb:\r\n  - two\r\n".encode()
+    theatre = make_theatre({"troupe.yaml": raw})
+
+    root = load(theatre / ".troupe" / "troupe.yaml")
+
+    assert isinstance(root, MappingNode)
+    assert root.origin.file.text.encode("utf-8") == raw
+    assert _sources(root) == [
+        ("troupe.yaml", "a"),
+        ("troupe.yaml", "'one'"),
+        ("troupe.yaml", "b"),
+        ("troupe.yaml", "two"),
+    ]
+
+
+def test_source_file_path_is_absolute_and_resolved(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: 1\n"})
+
+    root = load(theatre / ".troupe" / ".." / ".troupe" / "troupe.yml")
+
+    assert isinstance(root, MappingNode)
+    assert root.origin.file.path == (theatre / ".troupe" / "troupe.yml").resolve()
+
+
+@pytest.mark.parametrize("text", ["", "# nothing yet\n"])
+def test_empty_document_is_empty_block_mapping_at_start(
+    make_theatre: MakeTheatre, text: str
+) -> None:
+    root = _load(make_theatre, {"troupe.yml": text})
+
+    assert isinstance(root, MappingNode)
+    assert (root.entries, root.flow, root.origin.start, root.origin.end) == ([], False, 0, 0)
+
+
+def test_empty_document_with_bom_starts_after_bom(make_theatre: MakeTheatre) -> None:
+    root = _load(make_theatre, {"troupe.yml": "\ufeff"})
+
+    assert isinstance(root, MappingNode)
+    assert (root.origin.start, root.origin.end) == (1, 1)
+
+
+def test_yaml_include_embeds_target_whose_nodes_belong_to_target_file(
+    make_theatre: MakeTheatre,
+) -> None:
+    root = _load(
+        make_theatre,
+        {"troupe.yml": "agents: file:agents.yaml  # team\n", "agents.yaml": "lead: ada\n"},
+    )
+
+    include = lookup(root, ["agents"], "agents")
+    assert isinstance(include, YamlInclude)
+    assert include.origin.file.text[include.origin.start : include.origin.end] == (
+        "file:agents.yaml"
+    )
+    assert include.target.path.name == "agents.yaml"
+    lead = _scalar(root, "agents.lead")
+    assert lead.value == "ada"
+    assert lead.origin.file is include.target
+    assert _sources(root) == [
+        ("troupe.yml", "agents"),
+        ("troupe.yml", "file:agents.yaml"),
+        ("agents.yaml", "lead"),
+        ("agents.yaml", "ada"),
+    ]
+
+
+@pytest.mark.parametrize("written", ["'file:a.yml'", '"file:a.yml"', "file:a.yml"])
+def test_include_is_recognised_in_any_quoting_style(
+    make_theatre: MakeTheatre, written: str
+) -> None:
+    root = _load(make_theatre, {"troupe.yml": f"x: {written}\n", "a.yml": "k: v\n"})
+
+    assert isinstance(lookup(root, ["x"], "x"), YamlInclude)
+
+
+def test_nested_include_is_relative_to_including_files_directory(
+    make_theatre: MakeTheatre,
+) -> None:
+    root = _load(
+        make_theatre,
+        {
+            "troupe.yml": "team: file:teams/core.yaml\n",
+            "teams/core.yaml": "members:\n  - file:members/ada.yml\n",
+            "teams/members/ada.yml": "role: lead\n",
+            "members/ada.yml": "role: WRONG\n",
+        },
+    )
+
+    role = _scalar(root, "team.members.0.role")
+
+    assert role.value == "lead"
+    assert role.origin.file.path.parts[-3:] == ("teams", "members", "ada.yml")
+
+
+def test_yaml_include_of_empty_file_is_empty_mapping(make_theatre: MakeTheatre) -> None:
+    root = _load(make_theatre, {"troupe.yml": "extra: file:empty.yaml\n", "empty.yaml": ""})
+
+    extra = _at(root, "extra")
+
+    assert isinstance(extra, MappingNode)
+    assert extra.entries == []
+
+
+def test_same_file_included_twice_shares_one_source_file(make_theatre: MakeTheatre) -> None:
+    root = _load(
+        make_theatre,
+        {"troupe.yml": "a: file:common.yml\nb: file:./common.yml\n", "common.yml": "k: v\n"},
+    )
+
+    first, second = lookup(root, ["a"], "a"), lookup(root, ["b"], "b")
+
+    assert isinstance(first, YamlInclude)
+    assert isinstance(second, YamlInclude)
+    assert first.target is second.target
+    assert _scalar(root, "a.k").origin.file is _scalar(root, "b.k").origin.file
+
+
+def test_text_include_is_exact_text_with_crlf_and_no_trailing_newline(
+    make_theatre: MakeTheatre,
+) -> None:
+    root = _load(
+        make_theatre,
+        {"troupe.yml": "prompt: file:prompt.md\n", "prompt.md": b"line 1\r\nline 2"},
+    )
+
+    prompt = lookup(root, ["prompt"], "prompt")
+
+    assert isinstance(prompt, TextInclude)
+    assert prompt.target.text == "line 1\r\nline 2"
+    assert prompt.target.path.name == "prompt.md"
+
+
+def test_include_suffix_match_is_case_sensitive(make_theatre: MakeTheatre) -> None:
+    root = _load(make_theatre, {"troupe.yml": "x: file:a.YAML\n", "a.YAML": "k: v\n"})
+
+    include = lookup(root, ["x"], "x")
+
+    assert isinstance(include, TextInclude)
+    assert include.target.text == "k: v\n"
+
+
+def test_missing_include_target_names_target_includer_and_path(
+    make_theatre: MakeTheatre,
+) -> None:
+    theatre = make_theatre({"troupe.yml": "team:\n  lead: file:people/ada.yaml\n"})
+    state = (theatre / ".troupe").resolve()
+
+    with pytest.raises(LoadError) as caught:
+        load(state / "troupe.yml")
+
+    assert caught.value.message == (
+        f"include target not found: {state / 'people' / 'ada.yaml'}"
+        f" (included from {state / 'troupe.yml'}, at team.lead)"
+    )
+    assert caught.value.exit_code == 4
+
+
+def test_missing_text_include_target_is_load_error(make_theatre: MakeTheatre) -> None:
+    with pytest.raises(LoadError, match=r"include target not found: .*prompt\.txt"):
+        _load(make_theatre, {"troupe.yml": "p: file:prompt.txt\n"})
+
+
+def test_two_file_include_cycle_is_load_error_naming_chain(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: file:a.yaml\n", "a.yaml": "b: file:b.yaml\n",
+                            "b.yaml": "back: file:a.yaml\n"})  # fmt: skip
+    state = (theatre / ".troupe").resolve()
+
+    with pytest.raises(LoadError) as caught:
+        load(state / "troupe.yml")
+
+    assert caught.value.message == (
+        f"include cycle at a.b.back: {state / 'a.yaml'} -> {state / 'b.yaml'} -> {state / 'a.yaml'}"
+    )
+
+
+def test_self_include_is_load_error(make_theatre: MakeTheatre) -> None:
+    with pytest.raises(LoadError, match=r"include cycle at me: .*troupe\.yml -> .*troupe\.yml$"):
+        _load(make_theatre, {"troupe.yml": "me: file:troupe.yml\n"})
+
+
+def test_include_through_symlink_to_including_file_is_cycle(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: file:a.yaml\n", "a.yaml": "x: file:link.yaml\n"})
+    (theatre / ".troupe" / "link.yaml").symlink_to(theatre / ".troupe" / "a.yaml")
+
+    with pytest.raises(LoadError, match=r"include cycle at a\.x"):
+        load(theatre / ".troupe" / "troupe.yml")
+
+
+def test_same_file_in_sibling_branches_is_not_a_cycle(make_theatre: MakeTheatre) -> None:
+    root = _load(
+        make_theatre,
+        {"troupe.yml": "a: file:x.yaml\nb: file:y.yaml\n", "x.yaml": "c: file:y.yaml\n",
+         "y.yaml": "v: 1\n"},
+    )  # fmt: skip
+
+    assert (_scalar(root, "a.c.v").value, _scalar(root, "b.v").value) == (1, 1)
+
+
+def test_invalid_yaml_in_root_is_load_error_naming_file(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: [1,\n"})
+
+    with pytest.raises(LoadError) as caught:
+        load(theatre / ".troupe" / "troupe.yml")
+
+    assert caught.value.message.startswith(
+        f"cannot parse {(theatre / '.troupe' / 'troupe.yml').resolve()}: "
+    )
+
+
+def test_invalid_yaml_in_include_is_load_error_naming_include(make_theatre: MakeTheatre) -> None:
+    with pytest.raises(LoadError, match=r"cannot parse \S*broken\.yaml: .* at line 2"):
+        _load(
+            make_theatre, {"troupe.yml": "a: file:broken.yaml\n", "broken.yaml": "k: v\n  x: y\n"}
+        )
+
+
+@pytest.mark.parametrize("target", ["troupe.yml", "prompt.txt"])
+def test_invalid_utf8_is_load_error_naming_file(make_theatre: MakeTheatre, target: str) -> None:
+    files: dict[str, str | bytes] = {"troupe.yml": "p: file:prompt.txt\n"}
+    files[target] = b"p: file:prompt.txt\n\xff\n" if target == "troupe.yml" else b"\xc3("
+
+    with pytest.raises(LoadError, match=rf"cannot read \S*{target}: not valid UTF-8"):
+        _load(make_theatre, files)
+
+
+def test_text_include_of_directory_is_load_error(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "p: file:prompts\n"})
+    (theatre / ".troupe" / "prompts").mkdir()
+
+    with pytest.raises(LoadError, match=r"include target is a directory: \S*prompts .* at p\)"):
+        load(theatre / ".troupe" / "troupe.yml")
+
+
+def test_duplicate_key_is_load_error_naming_file_and_path(make_theatre: MakeTheatre) -> None:
+    with pytest.raises(LoadError, match=r"troupe\.yml: duplicate key model\.name at line 3"):
+        _load(make_theatre, {"troupe.yml": "model:\n  name: a\n  name: b\n"})
+
+
+def test_non_scalar_key_is_load_error_naming_file(make_theatre: MakeTheatre) -> None:
+    with pytest.raises(LoadError, match=r"troupe\.yml: mapping key at line 1 under \(root\)"):
+        _load(make_theatre, {"troupe.yml": "[a, b]: 1\n"})
+
+
+def test_overrides_replace_disk_text_without_touching_files(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: 1\nb: file:b.yaml\n", "b.yaml": "c: 2\n"})
+    state = theatre / ".troupe"
+
+    root = load(state / "troupe.yml", overrides={(state / "b.yaml").resolve(): "c: 3\n"})
+
+    assert _scalar(root, "a").value == 1
+    assert _scalar(root, "b.c").value == 3
+    assert _scalar(root, "b.c").origin.file.text == "c: 3\n"
+    assert (state / "b.yaml").read_text(encoding="utf-8") == "c: 2\n"
+
+
+def test_override_of_root_can_add_includes(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: 1\n", "p.txt": "hi"})
+    config = (theatre / ".troupe" / "troupe.yml").resolve()
+
+    root = load(config, overrides={config: "a: 1\np: file:p.txt\n"})
+
+    prompt = lookup(root, ["p"], "p")
+    assert isinstance(prompt, TextInclude)
+    assert prompt.target.text == "hi"
+
+
+def test_each_load_reads_current_disk_contents(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: 1\n"})
+    config = theatre / ".troupe" / "troupe.yml"
+    assert _scalar(load(config), "a").value == 1
+
+    config.write_bytes(b"a: edited\n")
+
+    assert _scalar(load(config), "a").value == "edited"
+
+
+def test_read_source_keeps_bytes_exactly(tmp_path: Path) -> None:
+    raw = "\ufeffa: 'é'\r\n\rb: 1".encode()
+    (tmp_path / "f.yml").write_bytes(raw)
+
+    source = read_source(tmp_path / "f.yml")
+
+    assert source.text.encode("utf-8") == raw
+    assert source.path == (tmp_path / "f.yml").resolve()
+
+
+def test_read_source_of_missing_file_is_load_error_naming_it(tmp_path: Path) -> None:
+    with pytest.raises(LoadError, match=r"cannot read \S*nope\.yml"):
+        read_source(tmp_path / "nope.yml")
diff --git a/tests/integration/test_set_blocks.py b/tests/integration/test_set_blocks.py
new file mode 100644
index 0000000..481cc08
--- /dev/null
+++ b/tests/integration/test_set_blocks.py
@@ -0,0 +1,278 @@
+"""``set`` with multi-line strings: literal and folded block scalars, through the real CLI.
+
+Contract: FR-017 (multi-line string replacing a plain/quoted scalar is a literal block, ``|-``
+without a trailing newline, double-quoted under a flow parent; an existing block scalar keeps its
+indicator and chomping unless the value's trailing newlines require another) and FR-018 (folded
+values: unchanged paragraphs keep their bytes, a changed paragraph is re-wrapped greedily at its
+old longest content-line width, an over-long word takes its own line, a new paragraph wraps at
+the value's longest old content line, a more-indented line exits 3). Every test compares the
+complete bytes of every theatre file; after a successful ``set``, ``show`` prints the new value.
+"""
+
+import json
+from pathlib import Path
+from typing import Any
+
+from conftest import CliResult, MakeTheatre, run_cli, snapshot
+
+ROOT = ".troupe/troupe.yml"
+
+
+def _set(theatre: Path, path: str, value: str) -> CliResult:
+    return run_cli("config", "set", path, value, "--theatre", str(theatre))
+
+
+def _show(theatre: Path, path: str) -> str:
+    result = run_cli("config", "show", path, "--theatre", str(theatre))
+    assert (result.code, result.err) == (0, ""), result.err
+    return result.out
+
+
+def _history(theatre: Path) -> list[dict[str, Any]]:
+    result = run_cli("config", "history", "--theatre", str(theatre))
+    assert (result.code, result.err) == (0, ""), result.err
+    return [json.loads(line) for line in result.out.splitlines()]
+
+
+def _check(
+    make_theatre: MakeTheatre, before: str | bytes, path: str, value: str, after: str | bytes
+) -> Path:
+    """The theatre holds only the root file; assert its whole bytes and ``show PATH``.
+
+    ``value`` is the VALUE argument; ``show`` must print what it parses to.
+    """
+    theatre = make_theatre({"troupe.yml": before})
+    result = _set(theatre, path, value)
+    assert (result.code, result.out, result.err) == (0, "", "")
+    expected = after.encode("utf-8") if isinstance(after, str) else after
+    assert snapshot(theatre) == {ROOT: expected}
+    parsed = json.loads(value) if value.startswith('"') else value
+    assert _show(theatre, path) == (parsed if parsed.endswith("\n") else parsed + "\n")
+    return theatre
+
+
+def _refused(make_theatre: MakeTheatre, before: str, path: str, value: str) -> None:
+    theatre = make_theatre({"troupe.yml": before})
+    imported = _history(theatre)
+
+    result = _set(theatre, path, value)
+
+    assert (result.code, result.out) == (3, "")
+    assert path in result.err
+    assert snapshot(theatre) == {ROOT: before.encode("utf-8")}
+    assert _history(theatre) == imported
+
+
+# --- Literal blocks (FR-017, US2 scenario 7) ----------------------------------------------------
+
+
+def test_multi_line_string_replacing_plain_scalar_is_literal_block(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(
+        make_theatre,
+        "notes: short\nnext: 1\n",
+        "notes",
+        '"line one\\nline two\\n"',
+        "notes: |\n  line one\n  line two\nnext: 1\n",
+    )
+
+
+def test_multi_line_string_without_trailing_newline_is_strip_literal(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(
+        make_theatre,
+        "notes: 'short'\nnext: 1\n",
+        "notes",
+        '"line one\\nline two"',
+        "notes: |-\n  line one\n  line two\nnext: 1\n",
+    )
+
+
+def test_literal_header_keeps_the_comment_column(make_theatre: MakeTheatre) -> None:
+    _check(
+        make_theatre,
+        "notes: short  # n\n",
+        "notes",
+        '"a\\nb\\n"',
+        "notes: |      # n\n  a\n  b\n",
+    )
+
+
+def test_multi_line_list_item_is_literal_block_indented_below_dash(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(
+        make_theatre,
+        "items:\n  - one\n  - two\n",
+        "items.0",
+        '"a\\nb\\n"',
+        "items:\n  - |\n    a\n    b\n  - two\n",
+    )
+
+
+def test_literal_block_in_crlf_file_uses_crlf(make_theatre: MakeTheatre) -> None:
+    _check(
+        make_theatre,
+        b"notes: short\r\nnext: 1\r\n",
+        "notes",
+        '"a\\nb\\n"',
+        b"notes: |\r\n  a\r\n  b\r\nnext: 1\r\n",
+    )
+
+
+def test_multi_line_string_in_flow_collection_is_double_quoted(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(
+        make_theatre,
+        "m: [a, b]  # c\n",
+        "m.0",
+        '"x\\ny"',
+        'm: ["x\\ny", b] # c\n',
+    )
+
+
+def test_existing_literal_block_keeps_indicator_and_chomping(make_theatre: MakeTheatre) -> None:
+    _check(
+        make_theatre,
+        "text: |\n  old one\n  old two\nnext: 1\n",
+        "text",
+        '"new\\nlines here\\n"',
+        "text: |\n  new\n  lines here\nnext: 1\n",
+    )
+
+
+def test_existing_literal_block_changes_chomping_when_trailing_newline_goes(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(
+        make_theatre,
+        "text: |  # c\n  a\nnext: 1\n",
+        "text",
+        '"b\\nc"',
+        "text: |- # c\n  b\n  c\nnext: 1\n",
+    )
+
+
+def test_existing_strip_literal_becomes_clip_for_trailing_newline(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(make_theatre, "text: |-\n  a\n", "text", '"b\\n"', "text: |\n  b\n")
+
+
+def test_existing_literal_becomes_keep_for_two_trailing_newlines(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(
+        make_theatre,
+        "text: |\n  a\nnext: 1\n",
+        "text",
+        '"b\\n\\n"',
+        "text: |+\n  b\n\nnext: 1\n",
+    )
+
+
+def test_single_line_string_replacing_literal_stays_block_with_strip(
+    make_theatre: MakeTheatre,
+) -> None:
+    _check(
+        make_theatre, "text: |\n  a\n  b\nnext: 1\n", "text", "one", "text: |-\n  one\nnext: 1\n"
+    )
+
+
+def test_non_string_replacing_block_scalar_is_written_plain(make_theatre: MakeTheatre) -> None:
+    _check(make_theatre, "text: |\n  a\n  b\nnext: 1\n", "text", "5", "text: 5\nnext: 1\n")
+
+
+def test_block_scalar_set_to_its_value_is_a_no_op(make_theatre: MakeTheatre) -> None:
+    before = "text: |\n  a\n  b\nnext: 1\n"
+    theatre = make_theatre({"troupe.yml": before})
+    imported = _history(theatre)
+    mtime = (theatre / ROOT).stat().st_mtime_ns
+
+    result = _set(theatre, "text", '"a\\nb\\n"')
+
+    assert (result.code, result.out, result.err) == (0, "", "")
+    assert snapshot(theatre) == {ROOT: before.encode("utf-8")}
+    assert (theatre / ROOT).stat().st_mtime_ns == mtime
+    assert _history(theatre) == imported
+
+
+# --- Folded blocks (FR-018, US2 scenario 8) -----------------------------------------------------
+
+FOLDED = (
+    "text: >\n"
+    "  The quick brown fox\n"
+    "  jumps over.\n"
+    "\n"
+    "  Second\n"
+    "  paragraph here stays.\n"
+    "\n"
+    "  Third one.\n"
+    "next: 1\n"
+)
+P1 = "The quick brown fox jumps over."
+P2 = "Second paragraph here stays."
+P3 = "Third one."
+
+
+def _value(*paragraphs: str) -> str:
+    return json.dumps("\n".join(paragraphs) + "\n")
+
+
+def test_folded_changed_paragraph_is_rewrapped_others_keep_bytes(
+    make_theatre: MakeTheatre,
+) -> None:
+    # Paragraph 1's widest old line is 19 code points; paragraph 2's odd wrapping is kept.
+    _check(
+        make_theatre,
+        FOLDED,
+        "text",
+        _value("The slow brown fox jumps over the lazy dog.", P2, P3),
+        FOLDED.replace(
+            "  The quick brown fox\n  jumps over.\n",
+            "  The slow brown fox\n  jumps over the lazy\n  dog.\n",
+        ),
+    )
+
+
+def test_folded_over_long_word_takes_its_own_line(make_theatre: MakeTheatre) -> None:
+    # Paragraph 3's old width is 10.
+    _check(
+        make_theatre,
+        FOLDED,
+        "text",
+        _value(P1, P2, "A supercalifragilistic word"),
+        FOLDED.replace("  Third one.\n", "  A\n  supercalifragilistic\n  word\n"),
+    )
+
+
+def test_folded_new_paragraph_wraps_at_longest_old_line(make_theatre: MakeTheatre) -> None:
+    # The value's longest old content line is "paragraph here stays." (21).
+    _check(
+        make_theatre,
+        FOLDED,
+        "text",
+        _value(P1, P2, P3, "Fourth paragraph is new and fairly long text"),
+        FOLDED.replace(
+            "  Third one.\n",
+            "  Third one.\n\n  Fourth paragraph is\n  new and fairly long\n  text\n",
+        ),
+    )
+
+
+def test_folded_value_with_more_indented_line_exits_3(make_theatre: MakeTheatre) -> None:
+    _refused(
+        make_theatre,
+        "text: >\n  normal line\n    indented line\nnext: 1\n",
+        "text",
+        '"other\\n"',
+    )
+
+
+def test_folded_change_introducing_more_indented_line_exits_3(
+    make_theatre: MakeTheatre,
+) -> None:
+    _refused(make_theatre, FOLDED, "text", _value(P1, " indented", P3))
diff --git a/tests/integration/test_set_existing.py b/tests/integration/test_set_existing.py
new file mode 100644
index 0000000..093f9ec
--- /dev/null
+++ b/tests/integration/test_set_existing.py
@@ -0,0 +1,517 @@
+"""``set PATH VALUE`` on existing scalars, includes and errors, through the real CLI (US2).
+
+Every test compares the complete bytes of every file of the theatre (history store excluded)
+after the command: the changed file against its whole expected text, every other file against its
+original bytes (NFR-001). Refusals and errors must leave every byte unchanged (NFR-002) and print
+nothing on stdout. After a successful ``set``, ``show PATH`` prints the new value.
+"""
+
+import json
+from pathlib import Path
+from typing import Any
+
+from conftest import HISTORY_PREFIX, CliResult, MakeTheatre, all_files, run_cli, snapshot
+
+type Files = dict[str, str | bytes]
+
+
+def _set(theatre: Path, path: str, value: str) -> CliResult:
+    return run_cli("config", "set", path, value, "--theatre", str(theatre))
+
+
+def _show(theatre: Path, path: str) -> str:
+    result = run_cli("config", "show", path, "--theatre", str(theatre))
+    assert (result.code, result.err) == (0, ""), result.err
+    return result.out
+
+
+def _history(theatre: Path) -> list[dict[str, Any]]:
+    result = run_cli("config", "history", "--theatre", str(theatre))
+    assert (result.code, result.err) == (0, ""), result.err
+    return [json.loads(line) for line in result.out.splitlines()]
+
+
+def _bytes(files: Files) -> dict[str, bytes]:
+    return {
+        f".troupe/{rel}": content.encode("utf-8") if isinstance(content, str) else content
+        for rel, content in files.items()
+    }
+
+
+def _set_ok(theatre: Path, path: str, value: str, expected: Files, shown: str) -> None:
+    """Run ``set``; assert success, the whole theatre's bytes, and ``show PATH``."""
+    result = _set(theatre, path, value)
+    assert (result.code, result.out, result.err) == (0, "", "")
+    assert snapshot(theatre) == _bytes(expected)
+    assert _show(theatre, path) == shown
+
+
+def _set_fails(theatre: Path, path: str, value: str, code: int, names: str) -> CliResult:
+    """Run ``set``; assert the exit code, empty stdout, a message naming ``names``, no change."""
+    before = snapshot(theatre)
+    result = _set(theatre, path, value)
+    assert result.code == code
+    assert result.out == ""
+    assert result.err.startswith("troupe: ") and result.err.count("\n") == 1
+    assert names in result.err
+    assert snapshot(theatre) == before
+    return result
+
+
+FIXTURE: Files = {
+    "troupe.yml": (
+        "model:\n"
+        '  name: "claude"   # default model\n'
+        "  temperature: 0.2  # creativity\n"
+        "  stop:\n"
+        "tools: [read, write]\n"
+        "agents:\n"
+        "  coder: file:agents/coder.yaml\n"
+        "prompt: file:prompts/sys.md\n"
+    ),
+    "agents/coder.yaml": "name: Ada\nskills: file:skills/coder.yml\n",
+    "agents/skills/coder.yml": "primary: python  # main\n",
+    "prompts/sys.md": "You are helpful.\n",
+}
+
+
+def _fixture(**changes: str | bytes) -> Files:
+    """FIXTURE with whole files replaced; keys use ``__`` for ``/`` and ``_`` for ``.``."""
+    files = dict(FIXTURE)
+    for key, content in changes.items():
+        files[key.replace("__", "/").replace("_", ".")] = content
+    return files
+
+
+def _root(text: str) -> Files:
+    return {**FIXTURE, "troupe.yml": text}
+
+
+# --- Comment column (FR-020, US2 scenario 1) ----------------------------------------------------
+
+
+def test_comment_keeps_column_then_gets_one_space_then_stays_at_its_new_column(
+    make_theatre: MakeTheatre,
+) -> None:
+    theatre = make_theatre(FIXTURE)
+    line = "  temperature: 0.2  # creativity\n"
+
+    def root_with(new_line: str) -> Files:
+        return _root(str(FIXTURE["troupe.yml"]).replace(line, new_line))
+
+    _set_ok(
+        theatre,
+        "model.temperature",
+        "0.75",
+        root_with("  temperature: 0.75 # creativity\n"),
+        "0.75\n",
+    )
+    _set_ok(
+        theatre,
+        "model.temperature",
+        "0.12345",
+        root_with("  temperature: 0.12345 # creativity\n"),
+        "0.12345\n",
+    )
+    # The comment's previous column is now the one it had after the last write.
+    _set_ok(
+        theatre,
+        "model.temperature",
+        "0.2",
+        root_with("  temperature: 0.2     # creativity\n"),
+        "0.2\n",
+    )
+
+
+def test_comment_column_counts_code_points_not_bytes(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: ab     # c\nb: 1\n"})
+
+    _set_ok(theatre, "a", "éé", {"troupe.yml": "a: éé     # c\nb: 1\n"}, "éé\n")
+    _set_ok(theatre, "a", "ééé", {"troupe.yml": "a: ééé    # c\nb: 1\n"}, "ééé\n")
+
+
+def test_line_without_comment_changes_only_the_value(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: 1\nb:   22\nc: 3\n"})
+
+    _set_ok(theatre, "b", "333", {"troupe.yml": "a: 1\nb:   333\nc: 3\n"}, "333\n")
+
+
+# --- Quoting (FR-015, US2 scenario 2) -----------------------------------------------------------
+
+
+def test_double_quoted_value_keeps_double_quotes(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre(FIXTURE)
+
+    expected = str(FIXTURE["troupe.yml"]).replace('"claude"   #', '"Grace"    #')
+    _set_ok(theatre, "model.name", "Grace", _root(expected), "Grace\n")
+
+
+def test_single_quoted_value_keeps_single_quotes_and_doubles_apostrophe(
+    make_theatre: MakeTheatre,
+) -> None:
+    theatre = make_theatre({"troupe.yml": "name: 'Ada'\n"})
+
+    _set_ok(theatre, "name", "it's", {"troupe.yml": "name: 'it''s'\n"}, "it's\n")
+
+
+def test_plain_value_that_cannot_stay_plain_falls_back_to_single_quotes(
+    make_theatre: MakeTheatre,
+) -> None:
+    theatre = make_theatre({"troupe.yml": "a: abc\n"})
+
+    _set_ok(theatre, "a", '"a: b"', {"troupe.yml": "a: 'a: b'\n"}, "a: b\n")
+
+
+def test_plain_value_set_to_string_true_is_single_quoted(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: abc\n"})
+
+    _set_ok(theatre, "a", '"true"', {"troupe.yml": "a: 'true'\n"}, "true\n")
+    assert _history(theatre)[-1] == {
+        "seq": 2,
+        "op": "set",
+        "path": "a",
+        "old": "abc",
+        "new": "true",
+    }
+
+
+def test_int_set_to_numeric_string_is_quoted(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "port: 8080\n"})
+
+    _set_ok(theatre, "port", '"9090"', {"troupe.yml": "port: '9090'\n"}, "9090\n")
+
+
+def test_quoted_string_set_to_int_is_written_plain(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": 'port: "8080"\n'})
+
+    _set_ok(theatre, "port", "9090", {"troupe.yml": "port: 9090\n"}, "9090\n")
+
+
+def test_non_string_scalars_are_written_plain_canonical(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: 'x'\n"})
+
+    _set_ok(theatre, "a", "true", {"troupe.yml": "a: true\n"}, "true\n")
+    _set_ok(theatre, "a", "~", {"troupe.yml": "a: null\n"}, "null\n")
+    _set_ok(theatre, "a", "0x1F", {"troupe.yml": "a: 31\n"}, "31\n")
+
+
+def test_plain_string_with_tab_falls_back_to_single_quotes(make_theatre: MakeTheatre) -> None:
+    theatre = make_theatre({"troupe.yml": "a: x\n"})
+
