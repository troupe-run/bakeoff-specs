@@ -0,0 +1,209 @@
+"""User Stories 2 and 3: remote content is read-only; new keys become local overrides (real CLI).
+
+Remote content is served by the ``remote`` test server on 127.0.0.1 (spec C-006). Refusals
+assert exit 3, empty stdout, exactly one stderr line naming PATH and containing the include
+string exactly as written in the local file, every theatre file unchanged, no event recorded and
+only ``GET`` requests at the server (NFR-001, NFR-002). Successful writes compare the whole root
+file byte for byte (NFR-003). The comment number is the acceptance scenario covered.
+"""
+
+from pathlib import Path
+
+from conftest import MakeTheatre, history_events, run_cli, snapshot
+from remote_server import RemoteServer
+
+DASH = "—"
+
+TEAM = "model: opus\ntools: [read, write]\nbase: &b {model: opus}\ncoder: *b\n"
+
+
+def _set(theatre: Path, *args: str) -> tuple[int, str, str]:
+    result = run_cli("config", "set", *args, "--theatre", str(theatre))
+    return result.code, result.out, result.err
+
+
+def _get(theatre: Path, path: str) -> str:
+    result = run_cli("config", "get", path, "--theatre", str(theatre))
+    assert (result.code, result.err) == (0, ""), result.err
+    return result.out
+
+
+def _root(theatre: Path) -> Path:
+    return theatre / ".troupe" / "troupe.yml"
+
+
+def _refusal(theatre: Path, dotted: str, written: str, line: int) -> str:
+    return (
+        f"troupe: {dotted}: value comes from remote include {written}"
+        f" ({_root(theatre).resolve()} line {line}); troupe does not change remote content"
+        f" {DASH} change that include line instead; no file changed\n"
+    )
+
+
+def _assert_refused(
+    theatre: Path, remote: RemoteServer, args: tuple[str, ...], dotted: str, written: str, line: int
+) -> None:
+    """Run ``set *args``; assert the remote refusal and that nothing changed anywhere."""
+    events = history_events(theatre)  # imports the theatre first: the refusal records nothing
+    before = snapshot(theatre)
+    remote.clear_log()
+
+    assert _set(theatre, *args) == (3, "", _refusal(theatre, dotted, written, line))
+
+    assert snapshot(theatre) == before
+    assert history_events(theatre) == events
+    assert {request.method for request in remote.requests()} == {"GET"}
+
+
+def test_changing_a_remote_value_exits_3_quoting_the_include_line(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US2-1
+    url = remote.serve("/team.yaml", TEAM)
+    theatre = make_theatre({"troupe.yml": f"# shared settings\nteam: {url}\n"})
+
+    _assert_refused(theatre, remote, ("team.model", "sonnet"), "team.model", url, 2)
+
+
+def test_setting_a_remote_text_include_exits_3(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US2-2
+    url = remote.serve("/sys.md", "be terse\n")
+    theatre = make_theatre({"troupe.yml": f"prompt: {url}\n"})
+
+    _assert_refused(theatre, remote, ("prompt", "x"), "prompt", url, 1)
+
+
+def test_list_append_in_remote_content_exits_3(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US2-3
+    url = remote.serve("/team.yaml", TEAM)
+    theatre = make_theatre({"troupe.yml": f"team: {url}\n"})
+
+    _assert_refused(theatre, remote, ("team.tools.2", "x"), "team.tools.2", url, 1)
+
+
+def test_in_include_into_remote_content_exits_3(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US2-3
+    url = remote.serve("/team.yaml", TEAM)
+    theatre = make_theatre({"troupe.yml": f"team: {url}\n"})
+
+    _assert_refused(theatre, remote, ("--in-include", "team.newkey", "1"), "team.newkey", url, 1)
+
+
+def test_replacing_a_whole_remote_include_exits_3(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US2-3
+    url = remote.serve("/team.yaml", TEAM)
+    theatre = make_theatre({"troupe.yml": f"team: '{url}'\n"})
+
+    _assert_refused(theatre, remote, ("team", "{a: 1}"), "team", f"'{url}'", 1)
+
+
+def test_value_from_nested_remote_include_names_the_outermost_include(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US2-4
+    inner = remote.serve("/inner.yaml", "deep: 1\n")
+    outer = remote.serve("/outer.yaml", f"nested: {inner}\n")
+    theatre = make_theatre({"troupe.yml": f"team: {outer}\n"})
+
+    _assert_refused(theatre, remote, ("team.nested.deep", "2"), "team.nested.deep", outer, 1)
+
+
+def test_local_override_of_remote_include_changes_only_that_line(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US2-5
+    url = remote.serve("/coder.yaml", "temperature: 0.7\nmodel: gpt\n")
+    text = f"coder:\n  $ref: {url}\n  temperature: 0.3  # local\nother: 1\n"
+    theatre = make_theatre({"troupe.yml": text})
+    remote.clear_log()
+
+    assert _set(theatre, "coder.temperature", "0.5") == (0, "", "")
+
+    expected = f"coder:\n  $ref: {url}\n  temperature: 0.5  # local\nother: 1\n"
+    assert _root(theatre).read_text(encoding="utf-8") == expected
+    assert _get(theatre, "coder.temperature") == "0.5\n"
+    assert _get(theatre, "coder.model") == "gpt\n"
+    assert {request.method for request in remote.requests()} == {"GET"}
+
+
+def test_new_key_under_scalar_remote_include_becomes_a_local_override(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US3-1
+    url = remote.serve("/team.yaml", "model: opus\n")
+    theatre = make_theatre({"troupe.yml": f"team: {url}  # shared\n"})
+
+    assert _set(theatre, "team.temperature", "0.3") == (0, "", "")
+
+    expected = f"team:  # shared\n  $ref: {url}\n  temperature: 0.3\n"
+    assert _root(theatre).read_text(encoding="utf-8") == expected
+    assert _get(theatre, "team.temperature") == "0.3\n"
+    assert _get(theatre, "team.model") == "opus\n"
+
+
+def test_new_key_under_mapping_form_remote_include_is_added_beside_overrides(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # US3-2
+    url = remote.serve("/coder.yaml", "temperature: 0.7\nmodel: gpt\n")
+    theatre = make_theatre({"troupe.yml": f"coder:\n  $ref: {url}\n  temperature: 0.3\nother: 1\n"})
+
+    assert _set(theatre, "coder.top_p", "0.9") == (0, "", "")
+
+    expected = f"coder:\n  $ref: {url}\n  temperature: 0.3\n  top_p: 0.9\nother: 1\n"
+    assert _root(theatre).read_text(encoding="utf-8") == expected
+    assert _get(theatre, "coder.top_p") == "0.9\n"
+
+
+def test_expand_alias_in_remote_content_exits_3_quoting_the_include(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # S-4
+    url = remote.serve("/team.yaml", TEAM)
+    theatre = make_theatre({"troupe.yml": f"team: {url}\n"})
+
+    _assert_refused(
+        theatre,
+        remote,
+        ("--expand-alias", "team.coder.model", "gpt"),
+        "team.coder.model",
+        url,
+        1,
+    )
+    _assert_refused(
+        theatre, remote, ("--expand-alias", "team.coder.extra", "1"), "team.coder.extra", url, 1
+    )
+
+
+def test_new_key_under_alias_in_remote_content_is_refused_mentioning_expand_alias(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # S-5
+    url = remote.serve("/team.yaml", TEAM)
+    theatre = make_theatre({"troupe.yml": f"team: {url}\n"})
+    events = history_events(theatre)
+    before = snapshot(theatre)
+
+    code, out, err = _set(theatre, "team.coder.extra", "1")
+
+    assert (code, out) == (3, "")
+    assert err.startswith("troupe: team.coder.extra: team.coder is the alias *b in ")
+    assert "--expand-alias" in err and err.count("\n") == 1
+    assert snapshot(theatre) == before
+    assert history_events(theatre) == events
+
+
+def test_in_include_into_remote_file_ending_inside_a_block_scalar_gets_the_remote_refusal(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # review regression (WP08 cycle 1, case a): checked before the renderer refuses
+    url = remote.serve("/t2.yaml", "tools:\n  - a\nitems:\n  - n: 1\nnote: |\n  text")
+    theatre = make_theatre({"troupe.yml": f"t: {url}\n"})
+
+    _assert_refused(theatre, remote, ("--in-include", "t.newk", "2"), "t.newk", url, 1)
+
+
+def test_new_key_under_a_multi_line_nested_remote_include_gets_the_remote_refusal(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # review regression (WP08 cycle 1, case b): the converter would refuse first
+    inner = remote.serve("/inner.yaml", "k: 1\n")
+    outer = remote.serve("/t3.yaml", f"x: >-\n  {inner}\n")
+    theatre = make_theatre({"troupe.yml": f"u: {outer}\n"})
+
+    _assert_refused(theatre, remote, ("u.x.newk", "1"), "u.x.newk", outer, 1)
diff --git a/tests/integration/test_schema_validation.py b/tests/integration/test_schema_validation.py
new file mode 100644
index 0000000..35be381
--- /dev/null
+++ b/tests/integration/test_schema_validation.py
@@ -0,0 +1,210 @@
+"""User Story 5, load part: the configuration matches its schema (real CLI; spec S-8, FR-009).
+
+When ``.troupe/troupe.schema.json`` exists, every command that loads the configuration validates
+the resolved configuration (remote content included) against it as JSON Schema 2020-12 and exits
+4 naming the schema file and the first failing path; an unreadable or invalid schema exits 4
+naming the schema file. The load happens before the history is opened, so a failure records
+nothing. Scenario 3 (``set``) belongs to the ``set`` tests. The number in a test's comment is the
+US5 acceptance scenario it covers.
+"""
+
+import json
+from pathlib import Path
+
+import pytest
+from test_show_sources import CONTRACT_FILES, CONTRACT_OUTPUT
+
+from conftest import HISTORY_PREFIX, MakeTheatre, all_files, core, history_events, run_cli, snapshot
+from remote_server import RemoteServer
+
+MODEL_IS_A_STRING = {"properties": {"model": {"type": "string"}}}
+LOADING_COMMANDS = {
+    "get": ("get", "name"),
+    "show": ("show",),
+    "set": ("set", "name", "other"),
+    "history": ("history",),
+}
+
+
+def _cli(theatre: Path, *args: str) -> tuple[int, str, str]:
+    result = run_cli("config", *args, "--theatre", str(theatre))
+    return result.code, result.out, result.err
+
+
+def _schema(document: object) -> str:
+    return json.dumps(document, indent=2) + "\n"
+
+
+def _schema_file(theatre: Path) -> Path:
+    return (theatre / ".troupe" / "troupe.schema.json").resolve()
+
+
+def _has_history(theatre: Path) -> bool:
+    return any(rel.startswith(HISTORY_PREFIX) for rel in all_files(theatre))
+
+
+@pytest.mark.parametrize("command", LOADING_COMMANDS.values(), ids=LOADING_COMMANDS.keys())
+def test_configuration_not_matching_the_schema_exits_4_naming_schema_and_path(
+    make_theatre: MakeTheatre, command: tuple[str, ...]
+) -> None:  # 1 (a local value)
+    theatre = make_theatre(
+        {"troupe.yml": "name: demo\nmodel: 5\n", "troupe.schema.json": _schema(MODEL_IS_A_STRING)}
+    )
+
+    assert _cli(theatre, *command) == (
+        4,
+        "",
+        f"troupe: configuration does not match schema {_schema_file(theatre)} at model: "
+        "5 is not of type 'string'\n",
+    )
+
+
+def test_value_from_a_remote_include_not_matching_the_schema_exits_4(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # 1 (a value in a remote file)
+    url = remote.serve("/team.yaml", "model: 5\n")
+    schema = {"properties": {"team": {"properties": {"model": {"type": "string"}}}}}
+    theatre = make_theatre({"troupe.yml": f"team: {url}\n", "troupe.schema.json": _schema(schema)})
+
+    assert _cli(theatre, "get", "team") == (
+        4,
+        "",
+        f"troupe: configuration does not match schema {_schema_file(theatre)} at team.model: "
+        "5 is not of type 'string'\n",
+    )
+
+
+def test_first_failure_in_path_order_is_reported(make_theatre: MakeTheatre) -> None:  # 1
+    schema = {"additionalProperties": {"type": "string"}, "required": ["zzz"]}
+    theatre = make_theatre({"troupe.yml": "b: 1\na: [1]\n", "troupe.schema.json": _schema(schema)})
+
+    assert _cli(theatre, "show") == (
+        4,
+        "",
+        f"troupe: configuration does not match schema {_schema_file(theatre)} at (root): "
+        "'zzz' is a required property\n",
+    )
+
+
+INVALID_SCHEMAS = {
+    "not-json": (
+        "{not json",
+        "not valid JSON: Expecting property name enclosed in double quotes at line 1 column 2",
+    ),
+    "nan": ('{"maximum": NaN}', "not valid JSON: NaN/Infinity are not JSON"),
+    "not-utf8": (b'{"title": "\xff"}', "not valid UTF-8 at byte 11"),
+    "wrong-dialect": (
+        '{"$schema": "http://json-schema.org/draft-07/schema#"}',
+        "$schema must be https://json-schema.org/draft/2020-12/schema, "
+        "got http://json-schema.org/draft-07/schema#",
+    ),
+    "meta-schema-failure": (
+        '{"type": 5}',
+        "not a valid JSON Schema 2020-12: 5 is not valid under any of the given schemas at /type",
+    ),
+    "remote-ref": (
+        '{"properties": {"model": {"$ref": "https://example.com/s.json"}}}',
+        "$ref https://example.com/s.json at /properties/model/$ref is not a fragment within "
+        "this file (references to other documents are not fetched)",
+    ),
+}
+
+
+@pytest.mark.parametrize("command", LOADING_COMMANDS.values(), ids=LOADING_COMMANDS.keys())
+@pytest.mark.parametrize(("text", "reason"), INVALID_SCHEMAS.values(), ids=INVALID_SCHEMAS.keys())
+def test_invalid_schema_files_exit_4_naming_the_schema_file(
+    make_theatre: MakeTheatre, text: str | bytes, reason: str, command: tuple[str, ...]
+) -> None:  # 2
+    theatre = make_theatre({"troupe.yml": "name: demo\n", "troupe.schema.json": text})
+
+    assert _cli(theatre, *command) == (
+        4,
+        "",
+        f"troupe: cannot load schema {_schema_file(theatre)}: {reason}\n",
+    )
+
+
+def test_invalid_schema_is_reported_before_fetching_anything(
+    make_theatre: MakeTheatre, remote: RemoteServer
+) -> None:  # 2: the schema is read first, because it decides what is fetched
+    url = remote.serve("/team.yaml", "model: opus\n")
+    theatre = make_theatre({"troupe.yml": f"team: {url}\n", "troupe.schema.json": "[]"})
+
+    assert _cli(theatre, "get", "team.model") == (
+        4,
+        "",
+        f"troupe: cannot load schema {_schema_file(theatre)}: "
+        "the schema must be a JSON object or boolean\n",
+    )
+    assert remote.requests() == []
+
+
+def test_format_uri_is_not_asserted(make_theatre: MakeTheatre) -> None:  # 4
+    schema = {"properties": {"webhook": {"type": "string", "format": "uri"}}}
+    theatre = make_theatre(
+        {"troupe.yml": "webhook: not a uri\n", "troupe.schema.json": _schema(schema)}
+    )
+
+    assert _cli(theatre, "get", "webhook") == (0, "not a uri\n", "")
+    assert _cli(theatre, "show") == (0, "webhook: not a uri\n", "")
+
+
+@pytest.mark.parametrize("schema", [None, True, {}], ids=["no-schema-file", "true", "empty"])
+def test_without_schema_file_behaviour_is_unchanged(
+    make_theatre: MakeTheatre, schema: object
+) -> None:  # 5 (step-1 contract example; an accept-all schema changes nothing either)
+    files = dict(CONTRACT_FILES)
+    if schema is not None:
+        files["troupe.schema.json"] = _schema(schema)
+    theatre = make_theatre(files)
+
+    assert _cli(theatre, "show", "--sources") == (0, CONTRACT_OUTPUT, "")
+    assert _cli(theatre, "get", "prompt") == (0, "Be brief.\n", "")
+    assert _cli(theatre, "get", "server.port") == (0, "8080\n", "")
+    assert _cli(theatre, "show", "tools") == (0, "- a\n- b\n", "")
+    assert core(history_events(theatre)) == [
+        {"seq": 1, "op": "import", "path": "name", "old": None, "new": "demo"},
+        {"seq": 2, "op": "import", "path": "server.port", "old": None, "new": 8080},
+        {"seq": 3, "op": "import", "path": "tools.0", "old": None, "new": "a"},
+        {"seq": 4, "op": "import", "path": "tools.1", "old": None, "new": "b"},
+        {"seq": 5, "op": "import", "path": "prompt", "old": None, "new": "Be brief.\n"},
+    ]
+
+
+@pytest.mark.parametrize("command", LOADING_COMMANDS.values(), ids=LOADING_COMMANDS.keys())
+def test_validation_failure_records_nothing_and_creates_no_history(
+    make_theatre: MakeTheatre, command: tuple[str, ...]
+) -> None:  # session order: load (and validate) before the history is opened
+    theatre = make_theatre(
+        {"troupe.yml": "name: demo\nmodel: 5\n", "troupe.schema.json": _schema(MODEL_IS_A_STRING)}
+    )
+    before = snapshot(theatre)
+
+    assert _cli(theatre, *command) == (
+        4,
+        "",
+        f"troupe: configuration does not match schema {_schema_file(theatre)} at model: "
+        "5 is not of type 'string'\n",
+    )
+
+    assert snapshot(theatre) == before
+    assert not _has_history(theatre)
+
+
+def test_hand_edit_breaking_the_schema_is_not_recorded_until_fixed(
+    make_theatre: MakeTheatre,
+) -> None:  # session order, imported theatre
+    theatre = make_theatre(
+        {"troupe.yml": "model: gpt\n", "troupe.schema.json": _schema(MODEL_IS_A_STRING)}
+    )
+    imported = history_events(theatre)
+    (theatre / ".troupe" / "troupe.yml").write_text("model: 5\n")
+
+    assert _cli(theatre, "get", "model")[0] == 4
+    (theatre / ".troupe" / "troupe.yml").write_text("model: opus\n")
+    assert _cli(theatre, "get", "model") == (0, "opus\n", "")
+
+    assert core(history_events(theatre)) == [
+        *core(imported),
+        {"seq": 2, "op": "set", "path": "model", "old": "gpt", "new": "opus"},
+    ]
