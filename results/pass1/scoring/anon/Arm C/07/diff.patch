+        }
+    )
+
+    assert _cli(theatre, "get", "elsewhere") == (0, f"{hook}\n", "")
+    assert _cli(theatre, "get", "list.0") == (0, f"{hook}\n", "")
+    assert _cli(theatre, "get", "copy") == (0, f"{tagged}\n", "")
+    assert remote.requests() == []
