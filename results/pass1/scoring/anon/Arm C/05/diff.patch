+        (
+            "list:\n  - file:agents/a.yaml  # c\n  - plain\n",
+            "list:\n  - $ref: file:agents/a.yaml  # c\n    k: 1\n  - plain\n",
+        ),
+        ("list:\n- file:agents/a.yaml\n", "list:\n- $ref: file:agents/a.yaml\n  k: 1\n"),
+        (
