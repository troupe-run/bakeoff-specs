+
+    err = _assert_load_refused(theatre, str(theatre / ".troupe" / "troupe.yml"), "p.md")
+    assert "prompt" in err and "not a .yml/.yaml file" in err
+
+
+@pytest.mark.parametrize(
+    ("value", "shown"),
+    [
+        ("5", "5"),
+        ("agents/coder.yaml", "agents/coder.yaml"),
+        ("[a]", "[a]"),
+        ("{x: 1}", "{x: 1}"),
+        ("null", "null"),
+        ('"file"', '"file"'),
+    ],
